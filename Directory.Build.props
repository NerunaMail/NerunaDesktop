<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>Neruna</Company>
    <Product>Neruna</Product>
    <Version>0.1.21</Version>
    <Copyright>Copyright © 2026 Neruna contributors. Licensed under the Mozilla Public License 2.0.</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    The API contract shared with the server lives in the private server repository (contract/). It is found when the
    server is checked out next to this repository (../server/contract). Without it the app builds normally and only
    the contract tests are skipped.
  -->
  <PropertyGroup>
    <NerunaApiDir Condition="'$(NerunaApiDir)' == ''">$(MSBuildThisFileDirectory)../server/contract/</NerunaApiDir>
  </PropertyGroup>
</Project>
