<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Company>Neruna</Company>
    <Product>Neruna</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright © 2026 Neruna contributors. Licensed under the Mozilla Public License 2.0.</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    The API contract (repository neruna-api) is shared with the server. It is found as the sibling folder ../api
    (workspace with all repositories side by side) or as ./api (git submodule, e.g. in CI).
  -->
  <PropertyGroup>
    <NerunaApiDir Condition="'$(NerunaApiDir)' == '' and Exists('$(MSBuildThisFileDirectory)api/fixtures')">$(MSBuildThisFileDirectory)api/</NerunaApiDir>
    <NerunaApiDir Condition="'$(NerunaApiDir)' == ''">$(MSBuildThisFileDirectory)../api/</NerunaApiDir>
  </PropertyGroup>
</Project>
