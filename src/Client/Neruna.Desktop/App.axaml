      <StreamGeometry x:Key="IconDelete">M9 3h6l1 1h4v2H4V4h4l1-1zM5 7h14l-1 14H6L5 7zm4 2v10h2V9H9zm4 0v10h2V9h-2z</StreamGeometry>
      <StreamGeometry x:Key="IconArchive">M3 4h18v4H3V4zm1 5h16v11H4V9zm5 2v2h6v-2H9z</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M3 17.3V21h3.7L17.8 9.9l-3.7-3.7L3 17.3zM20.7 7a1 1 0 0 0 0-1.4l-2.3-2.3a1 1 0 0 0-1.4 0l-1.8 1.8 3.7 3.7L20.7 7z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6z</StreamGeometry>
