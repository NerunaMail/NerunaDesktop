      <StreamGeometry x:Key="IconImage">M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v9.6l4-4 4 4 3-3 5 5V6H4zm11 1.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>
      <StreamGeometry x:Key="IconImport">M11 3h2v9.2l3.3-3.3 1.4 1.4L12 16l-5.7-5.7 1.4-1.4 3.3 3.3V3zM4 18h16v2H4v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconBullets">M4 5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm5 .5h11v2H9v-2zM4 10.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm5 .5h11v2H9v-2zM4 16a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm5 .5h11v2H9v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconNumbering">M3 4h2v5H4V5.5H3V4zm6 1.5h11v2H9v-2zM3 11h3v1l-2 2h2v1H3v-1l2-2H3v-1zm6 0h11v2H9v-2zm-6 5h3v4H3v-1h2v-.5H4v-1h1V17H3v-1zm6 .5h11v2H9v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconAlignLeft">M3 5h18v2H3V5zm0 4h12v2H3V9zm0 4h18v2H3v-2zm0 4h12v2H3v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconAlignCenter">M3 5h18v2H3V5zm3 4h12v2H6V9zm-3 4h18v2H3v-2zm3 4h12v2H6v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconAlignRight">M3 5h18v2H3V5zm6 4h12v2H9V9zm-6 4h18v2H3v-2zm6 4h12v2H9v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconIndent">M3 5h18v2H3V5zm8 4h10v2H11V9zm0 4h10v2H11v-2zm-8 4h18v2H3v-2zM3 9l4 3-4 3V9z</StreamGeometry>
      <StreamGeometry x:Key="IconOutdent">M3 5h18v2H3V5zm8 4h10v2H11V9zm0 4h10v2H11v-2zm-8 4h18v2H3v-2zM7 9v6l-4-3 4-3z</StreamGeometry>
      <StreamGeometry x:Key="IconLink">M10.6 13.4a1 1 0 0 0 1.4 0l4-4a3 3 0 0 0-4.2-4.2l-1.5 1.5 1.4 1.4 1.5-1.5a1 1 0 0 1 1.4 1.4l-4 4a1 1 0 0 0 0 1.4zm2.8-2.8a1 1 0 0 0-1.4 0l-4 4a3 3 0 0 0 4.2 4.2l1.5-1.5-1.4-1.4-1.5 1.5a1 1 0 0 1-1.4-1.4l4-4a1 1 0 0 0 0-1.4z</StreamGeometry>
