      <StreamGeometry x:Key="IconRss">M5 3a16 16 0 0 1 16 16h-2.5A13.5 13.5 0 0 0 5 5.5V3zm0 5a11 11 0 0 1 11 11h-2.5A8.5 8.5 0 0 0 5 10.5V8zm1.5 7a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0F6CBD" />
        <ColorPaletteResources x:Key="Dark" Accent="#479EF5" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <!-- Navigation rail buttons (Mail / Kalender / Kontakte) -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.rail.active">
      <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.rail PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>

    <!-- Command bar buttons -->
    <!-- Toggle in the coloured header bar (Tagesansicht): transparent, a light veil while switched on -->
    <Style Selector="ToggleButton.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="ToggleButton.header:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26FFFFFF" />
    </Style>

    <Style Selector="Button.command">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.command PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.pane">
      <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>
</Application>
