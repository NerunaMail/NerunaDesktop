<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF" />
          <!-- Page behind mail content (editor, previews); MailPaper.DarkBrush matches the dark one -->
          <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RailBackgroundBrush" Color="#E8E8E8" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#616161" />
          <SolidColorBrush x:Key="UnreadBarBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="GroupHeaderBrush" Color="#424242" />
          <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#E6E6E6" />
          <SolidColorBrush x:Key="TodayBrush" Color="#EBF3FC" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="GoodBackgroundBrush" Color="#F1FAF1" />
          <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#FFF9F5" />
          <SolidColorBrush x:Key="BadBackgroundBrush" Color="#FDF3F4" />
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#F5F5F5" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#C50F1F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#292929" />
          <SolidColorBrush x:Key="PaperBrush" Color="#292929" />
          <SolidColorBrush x:Key="RailBackgroundBrush" Color="#141414" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0C3B5E" />
          <SolidColorBrush x:Key="DividerBrush" Color="#3D3D3D" />
          <SolidColorBrush x:Key="SubtleTextBrush" Color="#ADADAD" />
          <SolidColorBrush x:Key="UnreadBarBrush" Color="#479EF5" />
          <SolidColorBrush x:Key="GroupHeaderBrush" Color="#D6D6D6" />
          <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="TodayBrush" Color="#0C3B5E" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#479EF5" />
          <SolidColorBrush x:Key="GoodBackgroundBrush" Color="#052505" />
          <SolidColorBrush x:Key="WarnBackgroundBrush" Color="#4A1E04" />
          <SolidColorBrush x:Key="BadBackgroundBrush" Color="#3B0509" />
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#333333" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#F1707B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- 24×24 icon geometries -->
      <StreamGeometry x:Key="IconMail">M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7 12 11.2 18.4 7H5.6z</StreamGeometry>
      <StreamGeometry x:Key="IconCalendar">M7 2h2v2h6V2h2v2h2a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V2zM5 9v10h14V9H5zm2 2h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zm-8 4h2v2H7v-2zm4 0h2v2h-2v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconGroup">M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zm7.5 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM9 13c-3.9 0-7 1.9-7 4.3V19h14v-1.7C16 14.9 12.9 13 9 13zm7.5 0c-.6 0-1.2.1-1.8.2 1.4.9 2.3 2.2 2.3 3.6V19h5v-1.5c0-2.5-2.5-4.5-5.5-4.5z</StreamGeometry>
      <StreamGeometry x:Key="IconPeople">M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z</StreamGeometry>
      <StreamGeometry x:Key="IconSync">M12 4a8 8 0 0 1 7.4 5H17v2h6V5h-2v2.5A10 10 0 0 0 2 12h2a8 8 0 0 1 8-8zm8 8a8 8 0 0 1-15.4 3H7v-2H1v6h2v-2.5A10 10 0 0 0 22 12h-2z</StreamGeometry>
      <StreamGeometry x:Key="IconSidebar">M3 4h18a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 2v12h10V6H4zm12 0v12h4V6h-4zm1 2h2v1.5h-2V8zm0 3h2v1.5h-2V11z</StreamGeometry>
