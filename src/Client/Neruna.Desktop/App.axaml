      <StreamGeometry x:Key="IconAdd">M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z</StreamGeometry>
      <StreamGeometry x:Key="IconFlag">M5 3h2v18H5V3zm3 1h11l-2.5 4L19 12H8V4z</StreamGeometry>
      <StreamGeometry x:Key="IconAttach">M16.5 6v11.5a4.5 4.5 0 0 1-9 0V5a3 3 0 0 1 6 0v10.5a1.5 1.5 0 0 1-3 0V6H9v9.5a3 3 0 0 0 6 0V5a4.5 4.5 0 0 0-9 0v12.5a6 6 0 0 0 12 0V6h-1.5z</StreamGeometry>
