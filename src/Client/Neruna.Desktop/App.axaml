      <StreamGeometry x:Key="IconFolder">M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z</StreamGeometry>
      <StreamGeometry x:Key="IconChevronLeft">M15.4 5.4 14 4l-8 8 8 8 1.4-1.4L8.8 12z</StreamGeometry>
      <StreamGeometry x:Key="IconChevronUp">M5.4 15.4 4 14l8-8 8 8-1.4 1.4L12 8.8z</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M5.4 8.6 4 10l8 8 8-8-1.4-1.4-6.6 6.6z</StreamGeometry>
