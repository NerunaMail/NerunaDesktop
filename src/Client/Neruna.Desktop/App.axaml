      <StreamGeometry x:Key="IconPopOut">M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H5v12h12v-6h2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z</StreamGeometry>
      <StreamGeometry x:Key="IconInbox">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2v8h4a3 3 0 0 0 6 0h4V5H5zm0 10v4h14v-4h-2.4a5 5 0 0 1-9.2 0H5z</StreamGeometry>
