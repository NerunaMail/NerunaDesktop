<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:ed="using:Neruna.Desktop.Editor"
             x:Class="Neruna.Desktop.Views.ComposeOptionsView"
             x:DataType="vm:MailOptionsViewModel">
  <!-- Einstellungen → E-Mail → Schreiben: how new mails are written (more options will join) -->
  <ScrollViewer>
    <StackPanel Spacing="22" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">

      <StackPanel Spacing="8">
        <TextBlock Text="{l:T 'Format'}" FontSize="16" FontWeight="SemiBold" />
        <RadioButton GroupName="ComposeFormat" Content="{l:T 'Formatiert (HTML)'}" IsChecked="{Binding FormatHtml}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,-6,0,0"
                   Text="{l:T 'Schrift, Farben, Listen, Tabellen, Bilder und Signaturen mit Logo.'}" />
        <RadioButton GroupName="ComposeFormat" Content="{l:T 'Nur Text'}" IsChecked="{Binding FormatPlainText}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,-6,0,0"
                   Text="{l:T 'Neue E-Mails, Antworten und Weiterleitungen als reiner Text, in einem einfachen Texteditor – schlank und überall lesbar. Gilt ab der nächsten Nachricht.'}" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="{l:T 'Während des Schreibens'}" FontSize="16" FontWeight="SemiBold" />
        <CheckBox IsChecked="{Binding AutoLists}" Content="{l:T 'Automatische Listen'}" IsEnabled="{Binding FormatHtml}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,-6,0,0"
                   Text="{l:T '«- » oder «* » am Zeilenanfang beginnt eine Aufzählung, «1. » eine nummerierte Liste. Ctrl+Z macht es rückgängig.'}" />
        <TextBlock Classes="subtle" Text="{l:T 'Rechtschreibprüfung'}" Margin="0,8,0,0" IsVisible="{x:Static vm:MailOptionsViewModel.CanChooseSpellLanguage}" />
        <ComboBox ItemsSource="{x:Static vm:MailOptionsViewModel.SpellLanguageChoices}" SelectedItem="{Binding SpellLanguage}" Width="240"
                  IsVisible="{x:Static vm:MailOptionsViewModel.CanChooseSpellLanguage}" IsEnabled="{Binding FormatHtml}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" IsVisible="{x:Static vm:MailOptionsViewModel.CanChooseSpellLanguage}"
                   Text="{l:T 'Falsch geschriebene Wörter werden rot unterstrichen, ein Rechtsklick zeigt Vorschläge. Beim Schreiben lässt sich die Sprache für eine Nachricht umschalten. Unter Windows braucht die Sprache eine installierte Rechtschreibprüfung (Einstellungen → Zeit und Sprache).'}" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="{l:T 'Verfassen'}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Classes="subtle" Text="{l:T 'Neue E-Mails, Antworten und Weiterleitungen öffnen'}" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <RadioButton GroupName="ComposeTarget" Content="{l:T 'Im Lesebereich'}" IsChecked="{Binding ComposeInline}" />
          <RadioButton GroupName="ComposeTarget" Content="{l:T 'In eigenem Fenster'}" IsChecked="{Binding ComposeInWindow}" />
        </StackPanel>
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                   Text="{l:T 'Eine Nachricht im Lesebereich lässt sich jederzeit mit «Loslösen» in ein eigenes Fenster verschieben.'}" />

        <TextBlock Classes="subtle" Text="{l:T 'Standardschrift für neue Nachrichten'}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{x:Static ed:FontCatalog.Fonts}" SelectedItem="{Binding ComposeFont}" Width="240" MaxDropDownHeight="440">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="ed:FontChoice">
                <Panel>
                  <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="15" IsVisible="{Binding IsFont}" />
                  <Border IsVisible="{Binding IsSeparator}" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4" />
                </Panel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{x:Static ed:FontCatalog.Sizes}" SelectedItem="{Binding ComposeFontSize}" Width="80" MaxDropDownHeight="360" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource PaperBrush}" Padding="12,10" Margin="0,4,0,0">
          <TextBlock Text="{l:T 'Guten Tag – so sehen Ihre neuen Nachrichten aus.'}"
                     FontFamily="{Binding ComposeFont.Family}"
                     FontSize="{Binding ComposeFontSize, Converter={x:Static vm:MailOptionsViewModel.PointsToPixels}}" />
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
