<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:cal="using:Neruna.Core.Calendar"
             x:Class="Neruna.Desktop.Views.SpecialCalendarView"
             x:DataType="vm:SpecialCalendarViewModel">

  <StackPanel>
    <TextBlock Text="{l:T 'Spezieller Kalender'}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,8"
               Text="{l:T 'Kalender, die Neruna selbst erstellt – ohne Server, auch offline. Sie sind schreibgeschützt und lassen sich wie andere Kalender ein- und ausblenden.'}" />

    <RadioButton GroupName="kind" IsChecked="{Binding IsBirthdays}" IsEnabled="{Binding CanChooseBirthdays}" Margin="0,4,0,0">
      <StackPanel>
        <TextBlock Text="{l:T 'Geburtstage'}" FontWeight="SemiBold" />
        <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Die Geburtstage aus allen Adressbüchern, mit dem Alter, wenn das Geburtsjahr bekannt ist.'}" />
        <TextBlock Classes="subtle" FontStyle="Italic" Text="{l:T 'Bereits vorhanden'}" IsVisible="{Binding HasBirthdays}" />
      </StackPanel>
    </RadioButton>
    <StackPanel Margin="28,6,0,0" IsVisible="{Binding IsBirthdays}">
      <TextBlock Classes="label" Text="{l:T 'Erinnerung'}" />
      <ComboBox ItemsSource="{Binding Reminders}" SelectedIndex="{Binding ReminderIndex}" MinWidth="260" />
    </StackPanel>

    <RadioButton GroupName="kind" IsChecked="{Binding IsHolidays}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="{l:T 'Feiertage'}" FontWeight="SemiBold" />
        <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Die gesetzlichen Feiertage eines Landes und einer Region, für jedes Jahr berechnet.'}" />
      </StackPanel>
    </RadioButton>
    <Grid Margin="28,6,0,0" ColumnDefinitions="*,12,*" IsVisible="{Binding IsHolidays}">
      <StackPanel>
        <TextBlock Classes="label" Text="{l:T 'Land'}" />
        <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="cal:HolidayCountry">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2" IsVisible="{Binding HasRegions}">
        <TextBlock Classes="label" Text="{l:T 'Kanton / Bundesland'}" />
        <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" HorizontalAlignment="Stretch"
                  PlaceholderText="{l:T 'Bitte wählen'}" MaxDropDownHeight="360">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="cal:HolidayRegion">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>
    <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,8,0,0" IsVisible="{Binding IsHolidays}"
               Text="{l:T 'Ohne Gewähr: Manche Feiertage gelten nur in Teilen einer Region oder nach Brauch.'}" />

    <TextBlock Classes="error" Text="{Binding Error}" Margin="0,12,0,0" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">
      <ProgressBar IsIndeterminate="True" Width="80" MinWidth="0" Height="4" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="{l:T 'Hinzufügen'}" Command="{Binding AddCommand}" IsDefault="True" />
    </Grid>
  </StackPanel>
</UserControl>
