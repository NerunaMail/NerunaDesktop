<Window xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neruna.Desktop.ViewModels"
        xmlns:app="using:Neruna.Desktop"
        x:Class="Neruna.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Neruna"
        Icon="/Assets/app.ico"
        Width="1440" Height="880" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding SyncCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="44,*,26">

    <!-- Header bar -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,8,0">
        <!-- The active section; "Neruna" is already in the window title -->
        <TextBlock Text="{Binding SectionTitle}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <!-- Out-of-office reply on: visible from every page, the list manages it per account -->
          <Button x:Name="AutoReplyButton" Classes="header" IsVisible="{Binding MailPage.HasActiveAutoReply}" Padding="8,4" Margin="0,0,4,0"
                  ToolTip.Tip="{Binding MailPage.AutoReplyNotice}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="10" Height="10" Fill="#F7A700" Stroke="White" StrokeThickness="1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding MailPage.AutoReplyHeader}" Foreground="White" FontSize="13" VerticalAlignment="Center" />
              <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="340" Spacing="4">
                  <TextBlock Text="{l:T 'Abwesenheitsnotiz'}" FontWeight="SemiBold" Margin="4,0,0,4" />
                  <ItemsControl ItemsSource="{Binding MailPage.AutoReplyEntries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AutoReplyEntry">
                        <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="{Binding IsActive, Converter={x:Static app:Converters.BoldIf}}" />
                            <TextBlock Text="{Binding Status}" Classes="subtle" FontSize="12" />
                          </StackPanel>
                          <!-- Click only (no Command binding): the list closes on the click -->
                          <Button Grid.Column="1" Content="{Binding Action}" FontSize="12" Padding="8,3" VerticalAlignment="Center" Click="OnAutoReplyPicked" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- Own online status for the chat, from every page (only with a chat) -->
          <Button x:Name="PresenceButton" Classes="header" IsVisible="{Binding ChatPage.ShowPresence}" Padding="8,4" Margin="0,0,4,0"
                  ToolTip.Tip="{l:T 'Online-Status im Chat'}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="10" Height="10" Fill="{Binding ChatPage.PresenceBrush}" Stroke="White" StrokeThickness="1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ChatPage.PresenceLabel}" Foreground="White" FontSize="13" VerticalAlignment="Center" />
              <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <ItemsControl ItemsSource="{x:Static vm:ChatViewModel.PresenceChoices}" Width="200">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresenceChoice">
                      <!-- Click only (no Command binding): the list closes on the click, a bound command would be gone by then -->
                      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Padding="8,6"
                              Click="OnPresencePicked">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- Tagesansicht: the next appointments beside the mail (remembered across restarts) -->
          <ToggleButton Classes="header" IsVisible="{Binding IsMail}" IsChecked="{Binding MailPage.Agenda.IsOpen}"
                        ToolTip.Tip="{l:T 'Tagesansicht: Termine von heute und den nächsten Tagen ein- oder ausblenden'}">
            <PathIcon Data="{StaticResource IconSidebar}" Width="17" Height="17" Foreground="White" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="60,*">
      <!-- Navigation rail -->
      <Border Grid.Column="0" Background="{DynamicResource RailBackgroundBrush}">
        <DockPanel>
        <!-- Bottom of the rail: add an account, synchronize, settings -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,0,0,10">
          <Button Classes="rail" HorizontalAlignment="Center" Command="{Binding ShowAccountSetupCommand}" ToolTip.Tip="{l:T 'Konto hinzufügen'}"
                  IsVisible="{Binding MailPage.Preferences.ShowAddAccountButton}">
            <PathIcon Data="{StaticResource IconAccountAdd}" />
          </Button>
          <Button Classes="rail" HorizontalAlignment="Center" Command="{Binding SyncCommand}" ToolTip.Tip="{l:T 'Synchronisieren (F5)'}">
            <PathIcon Data="{StaticResource IconSync}" />
          </Button>
          <Border Height="1" Width="28" Background="{DynamicResource DividerBrush}" Margin="0,2" />
          <Button Classes="rail" Classes.active="{Binding IsSettings}" HorizontalAlignment="Center"
                  Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Section.Settings}" ToolTip.Tip="{l:T 'Einstellungen: Konten, Zertifikate, Diagnose'}">
            <PathIcon Data="{StaticResource IconSettings}" />
          </Button>
        </StackPanel>
        <!-- E-Mail, Kalender, Kontakte, Chat: order and visibility from Einstellungen → Design -->
        <ItemsControl ItemsSource="{Binding MailPage.Preferences.NavigationItems}" Margin="0,10,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItem">
              <Button Classes="rail" Classes.active="{Binding IsActive}" HorizontalAlignment="Center" IsVisible="{Binding IsVisible}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}" CommandParameter="{Binding Section}"
                      ToolTip.Tip="{Binding Label}">
                <Panel>
                  <PathIcon Data="{Binding IconKey, Converter={x:Static app:Converters.Icon}}" />
                  <!-- New chat messages -->
                  <Border Background="#C50F1F" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" Margin="0,-7,-11,0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasBadge}">
                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="6,6,6,0" />
    </Grid>

    <!-- Status bar; on the right a downloaded update waiting for a restart -->
    <Border Grid.Row="2" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="60" Height="4" MinWidth="0" IsVisible="{Binding IsSyncing}" />
          <TextBlock Classes="subtle" FontSize="12" Text="{Binding StatusText}" />
        </StackPanel>
        <!-- Personal settings changed since the last backup -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0" IsVisible="{Binding ShowBackupHint}">
          <TextBlock FontSize="12" Text="{l:T 'Einstellungen geändert – neue Sicherung erstellen?'}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
          <Button Classes="command" Command="{Binding BackupNowCommand}" Padding="6,1" FontSize="12" ToolTip.Tip="{l:T 'Einstellungen → Cloud → Sicherung'}">
            <TextBlock Text="{l:T 'Sichern'}" Foreground="{DynamicResource AccentTextBrush}" TextDecorations="Underline" />
          </Button>
          <Button Classes="command" Command="{Binding BackupLaterCommand}" Padding="6,1" FontSize="12" ToolTip.Tip="{l:T 'Erst nach der nächsten Änderung wieder fragen'}">
            <TextBlock Text="{l:T 'Später'}" Classes="subtle" TextDecorations="Underline" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding SettingsPage.Updates.IsReady}">
          <TextBlock FontSize="12" Text="{Binding SettingsPage.Updates.ReadyText}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
          <Button Classes="command" Command="{Binding SettingsPage.Updates.RestartNowCommand}" Padding="6,1" FontSize="12"
                  ToolTip.Tip="{l:T 'Neruna schliessen, das Update installieren und wieder starten'}">
            <TextBlock Text="{l:T 'Jetzt neu starten'}" Foreground="{DynamicResource AccentTextBrush}" TextDecorations="Underline" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Modal overlay (account setup, ICS subscription) -->
    <Border Grid.RowSpan="3" IsVisible="{Binding HasOverlay}" Background="#80000000">
      <Border Classes="pane" Width="{Binding OverlayWidth}" MaxWidth="{Binding $parent[Window].Bounds.Width}" Margin="0,24" HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 8 32 0 #40000000">
        <ScrollViewer>
          <ContentControl Content="{Binding Overlay}" Margin="28" />
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
</Window>
