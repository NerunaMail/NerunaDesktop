<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:views="using:Neruna.Desktop.Views"
             x:Class="Neruna.Desktop.Views.AccountTransferDialogView"
             x:DataType="vm:AccountTransferDialogViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{l:T 'Konto aufs Handy übertragen'}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Title}" Classes="subtle" />
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Classes="accent" Content="{l:T 'Fertig'}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" />
    <StackPanel Spacing="10">
      <views:LoginGateView DataContext="{Binding Login}" />
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasCode}">
        <Border Background="White" Padding="8" CornerRadius="4" VerticalAlignment="Top">
          <Image Source="{Binding QrCode}" Stretch="None" RenderOptions.BitmapInterpolationMode="None" />
        </Border>
        <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="8" MinWidth="240" MaxWidth="320">
          <TextBlock Text="{l:T 'PIN'}" Classes="subtle" />
          <SelectableTextBlock Text="{Binding Pin}" FontSize="32" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Mono, monospace" />
          <TextBlock TextWrapping="Wrap" FontSize="13"
                     Text="{l:T 'In der Neruna-App: Einstellungen → Konten → «Konto vom Computer übernehmen», QR-Code scannen und die PIN eingeben. Die PIN nicht zusammen mit dem QR-Code fotografieren oder weitergeben.'}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </DockPanel>
</UserControl>
