<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.FolderPickerView"
             x:DataType="vm:FolderPickerViewModel">
  <!-- Account, search (focused: type and Enter), folders (a click moves) -->
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{l:T 'In welchen Ordner verschieben?'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
    <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch"
              IsVisible="{Binding HasSeveralAccounts}" Margin="0,0,0,8">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MailAccountNode">
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding Filter}" PlaceholderText="{l:T 'Ordner suchen …'}" Margin="0,0,0,8" KeyDown="OnSearchKeyDown" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" />
    </StackPanel>
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
      <Panel>
        <TextBlock Classes="subtle" Text="{l:T 'Kein Ordner passt zur Suche.'}" IsVisible="{Binding HasNoMatch}" Margin="6" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Folders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderPickItem">
                <Button Classes="folderPick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5"
                        Command="{Binding $parent[UserControl].((vm:FolderPickerViewModel)DataContext).PickCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                    <PathIcon Data="{Binding Role, Converter={x:Static l:Converters.FolderIcon}}" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Border>
  </DockPanel>
</UserControl>
