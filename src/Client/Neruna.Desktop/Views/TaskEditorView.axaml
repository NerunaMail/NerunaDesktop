<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:cal="using:Neruna.Core.Calendar"
             x:Class="Neruna.Desktop.Views.TaskEditorView"
             x:DataType="vm:TaskEditorViewModel">

  <StackPanel>
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" FontSize="12" Margin="0,4,0,0" IsVisible="{Binding !CanEdit}"
               Text="{l:T 'Diese Liste ist schreibgeschützt.'}" />

    <TextBlock Classes="label" Text="{l:T 'Titel'}" />
    <TextBox x:Name="SummaryBox" Text="{Binding Summary}" PlaceholderText="{l:T 'Was ist zu tun?'}" IsReadOnly="{Binding !CanEdit}" />

    <Grid ColumnDefinitions="Auto,*,12,Auto,*" Margin="0,12,0,0">
      <CheckBox Content="{l:T 'Fällig am'}" IsChecked="{Binding HasDue}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding DueDate}" IsEnabled="{Binding HasDue}" HorizontalAlignment="Stretch" />
      <CheckBox Grid.Column="3" Content="{l:T 'um'}" IsChecked="{Binding HasTime}" IsEnabled="{Binding HasDue}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TimePicker Grid.Column="4" SelectedTime="{Binding DueTime}" ClockIdentifier="24HourClock" MinuteIncrement="5" IsEnabled="{Binding HasTime}" HorizontalAlignment="Stretch" />
    </Grid>

    <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
      <StackPanel>
        <TextBlock Classes="label" Text="{l:T 'Priorität'}" />
        <ComboBox ItemsSource="{Binding Priorities}" SelectedIndex="{Binding PriorityIndex}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="label" Text="{l:T 'Liste'}" />
        <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="cal:CalendarInfo">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </Grid>

    <TextBlock Classes="label" Text="{l:T 'Notizen'}" />
    <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" IsReadOnly="{Binding !CanEdit}" />

    <CheckBox Content="{l:T 'Erledigt'}" IsChecked="{Binding IsCompleted}" IsEnabled="{Binding CanEdit}" Margin="0,12,0,0" />

    <TextBlock Classes="error" Text="{Binding Error}" Margin="0,10,0,0" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">
      <Button Classes="command" Command="{Binding DeleteCommand}" IsVisible="{Binding IsExisting}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" />
          <TextBlock Text="{l:T 'Löschen'}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="{l:T 'Speichern'}" Command="{Binding SaveCommand}" IsDefault="True" />
    </Grid>
  </StackPanel>
</UserControl>
