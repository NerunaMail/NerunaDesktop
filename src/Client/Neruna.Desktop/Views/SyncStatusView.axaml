<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.SyncStatusView"
             x:DataType="vm:SyncStatusViewModel">
  <!-- Per account and service: running (since when), last result, error -->
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{l:T 'Synchronisation'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:T 'Jetzt synchronisieren'}" Command="{Binding SyncNowCommand}" />
      <Button Classes="accent" Content="{l:T 'Schliessen'}" Command="{Binding CloseCommand}" />
    </StackPanel>
    <Panel>
      <TextBlock Text="{l:T 'Seit dem Start wurde noch nicht synchronisiert.'}" Classes="subtle" IsVisible="{Binding IsEmpty}" />
      <ScrollViewer MaxHeight="460">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SyncRow">
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Account}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                    <TextBlock Text="{Binding Service}" Classes="subtle" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <ProgressBar IsIndeterminate="True" Width="40" Height="4" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding IsRunning}" />
                    <TextBlock Text="{Binding State}" Classes.error="{Binding IsFailed}" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Classes="subtle" FontSize="12" TextWrapping="Wrap"
                             IsVisible="{Binding HasDetail}" Margin="0,2,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
