<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.AgendaView"
             x:DataType="vm:AgendaViewModel">
  <!-- Tagesansicht: the next appointments as a plain list, day by day -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,10,8,6">
      <TextBlock Text="{l:T 'Tagesansicht'}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="command" Padding="6" ToolTip.Tip="{l:T 'Kalender für die Tagesansicht wählen'}">
        <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="6" MinWidth="220" MaxWidth="320">
              <TextBlock Text="{l:T 'Angezeigte Kalender'}" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Text="{l:T 'Nur für die Tagesansicht – die Kalenderansicht bleibt, wie sie ist.'}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Calendars}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AgendaCalendarChoice">
                    <CheckBox IsChecked="{Binding IsShown}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <Panel>
      <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="14,8" IsVisible="{Binding IsEmpty}"
                 Text="{l:T 'Keine Termine heute und in den nächsten Tagen.'}" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Entries}" Margin="8,0,8,12">
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:AgendaDayHeader">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="6,12,6,4" />
            </DataTemplate>
            <DataTemplate DataType="vm:AgendaItem">
              <Button Classes="command" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,1"
                      Command="{Binding $parent[ItemsControl].((vm:AgendaViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                      Opacity="{Binding Opacity}" ToolTip.Tip="{l:T 'Im Kalender öffnen'}">
                <Grid ColumnDefinitions="4,*">
                  <Border Background="{Binding Brush}" CornerRadius="2" />
                  <StackPanel Grid.Column="1" Margin="8,5,6,5" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Time}" FontSize="12" Classes="subtle" />
                      <Border IsVisible="{Binding IsNow}" Background="{Binding Brush}" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'jetzt'}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Location}" FontSize="12" Classes="subtle" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasLocation}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
