<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:app="using:Neruna.Desktop"
             xmlns:views="using:Neruna.Desktop.Views"
             xmlns:ctl="using:Neruna.Desktop.Controls"
             x:Class="Neruna.Desktop.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
  </UserControl.KeyBindings>

  <Grid RowDefinitions="Auto,*">

    <!-- Command bar -->
    <Border Classes="pane" Padding="8,6" Margin="0,0,0,6">
      <!-- Navigation on the left; the tools on the right wrap into a second row when the window is narrow -->
      <ctl:SplitToolbar SmallMinWidth="240">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
          <Button Classes="accent pageNew" Command="{Binding NewEventCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip.Tip="Ctrl+N">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Neuer Termin'}" />
            </StackPanel>
          </Button>
          <!-- Only with Neruna Cloud; without, it is in «Kalender ▾» -->
          <Button Classes="command" Command="{Binding OpenPollsCommand}" Margin="0,0,8,0" ToolTip.Tip="{Binding PollsTip}" IsVisible="{Binding HasCloud}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconPoll}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Terminumfragen'}" />
              <!-- How many run; a red "!" when one is over and still waits to be fixed -->
              <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="9" Padding="6,0" MinWidth="18" VerticalAlignment="Center"
                      IsVisible="{Binding HasOpenPolls}">
                <TextBlock Text="{Binding OpenPollCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </Border>
              <Border Background="#DC2626" CornerRadius="9" Width="18" Height="18" VerticalAlignment="Center" IsVisible="{Binding HasOverduePolls}">
                <TextBlock Text="!" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Button>
          <Button Classes="command" Command="{Binding TodayCommand}" Content="{l:T 'Heute'}" />
          <Button Classes="command" Command="{Binding PreviousWeekCommand}" ToolTip.Tip="{Binding PreviousTip}">
            <PathIcon Data="{StaticResource IconChevronLeft}" Width="14" Height="14" Margin="0" />
          </Button>
          <Button Classes="command" Command="{Binding NextWeekCommand}" ToolTip.Tip="{Binding NextTip}">
            <PathIcon Data="{StaticResource IconChevronRight}" Width="14" Height="14" Margin="0" />
          </Button>
          <TextBlock Text="{Binding RangeTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <WrapPanel HorizontalAlignment="Right" ItemSpacing="4" LineSpacing="4">
          <!-- The views, from the shortest span to the longest, then Planung (each shown calendar as a time line) -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <ToggleButton Content="{l:T '1 Tag'}" IsChecked="{Binding ViewDay}" Padding="10,5" CornerRadius="4,0,0,4" ToolTip.Tip="{l:T 'Nur einen Tag anzeigen'}" />
            <ToggleButton Content="{l:T 'Mo–Fr'}" IsChecked="{Binding ViewWorkWeek}" Padding="10,5" CornerRadius="0" ToolTip.Tip="{l:T 'Nur Arbeitstage anzeigen'}" />
            <ToggleButton Content="{l:T 'Woche'}" IsChecked="{Binding ViewWeek}" Padding="10,5" CornerRadius="0" ToolTip.Tip="{l:T 'Ganze Woche anzeigen'}" />
            <ToggleButton Content="{l:T 'Monat'}" IsChecked="{Binding ViewMonth}" Padding="10,5" CornerRadius="0" ToolTip.Tip="{l:T 'Den ganzen Monat anzeigen'}" />
            <ToggleButton Content="{l:T 'Planung'}" IsChecked="{Binding ViewPlanning}" Padding="10,5" CornerRadius="0,4,4,0"
                          ToolTip.Tip="{l:T 'Planungsansicht: jeder Kalender als Zeitstrahl – rot beschäftigt, grün frei'}" />
          </StackPanel>
          <Button Classes="command" Command="{Binding PrintCommand}" ToolTip.Tip="{l:T 'Woche, Monat, Tag oder Liste drucken bzw. als PDF speichern (Ctrl+P)'}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Data="{StaticResource IconPrint}" />
              <TextBlock Text="{l:T 'Drucken'}" />
            </StackPanel>
          </Button>
          <!-- Rarely needed: in one menu -->
          <Button Classes="command" ToolTip.Tip="{l:T 'Kalender hinzufügen, verwalten und importieren'}">
            <StackPanel Orientation="Horizontal">
              <PathIcon Data="{StaticResource IconCalendar}" />
              <TextBlock Text="{l:T 'Kalender'}" />
              <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" Margin="6,0,0,0" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{l:T 'Kalender verwalten …'}" Command="{Binding ManageCommand}" ToolTip.Tip="{l:T 'Server erneut nach Kalendern fragen (auch im Webmail abonnierte) und auswählen'}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconSync}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Geburtstage oder Feiertage …'}" Command="{Binding AddSpecialCommand}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconCalendar}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Internet-Kalender abonnieren'}" Command="{Binding SubscribeCommand}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconRss}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Termine importieren …'}" Command="{Binding ImportCommand}" ToolTip.Tip="{l:T 'Termine aus einer .ics-Datei in einen eigenen Kalender kopieren, z. B. einen Fahrplan'}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconImport}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:T 'Terminumfragen'}" Command="{Binding OpenPollsCommand}" IsVisible="{Binding !HasCloud}" ToolTip.Tip="{Binding PollsTip}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconPoll}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding WindowToggleText}" Command="{Binding ToggleWindowCommand}" ToolTip.Tip="{Binding WindowToggleTip}">
                  <MenuItem.Icon><PathIcon Data="{StaticResource IconPopOut}" /></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
      </ctl:SplitToolbar>
    </Border>

    <Grid x:Name="Columns" Grid.Row="1" ColumnDefinitions="264,6,*">

      <!-- Date navigator + calendar list -->
      <Border Classes="pane" Padding="12,10">
        <!-- Months stay; the calendar list scrolls when it is longer than the window -->
        <DockPanel>
          <!-- Termine suchen: the hits replace the week until the search is cleared -->
          <TextBox x:Name="EventSearch" Classes="pageSearch" Text="{Binding SearchText}" PlaceholderText="{l:T 'Termine suchen (Ctrl+F)'}"
                   DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="8,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Classes="command" Padding="6" Margin="0,0,2,0" Command="{Binding CloseSearchCommand}" IsVisible="{Binding IsSearching}" ToolTip.Tip="{l:T 'Suche schliessen (Esc)'}">
                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" Margin="0" />
              </Button>
            </TextBox.InnerRightContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding CloseSearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <!-- A click shows the week; dragging over days or Ctrl+click picks any days (CalendarView.axaml.cs) -->
          <ItemsControl x:Name="Navigator" DockPanel.Dock="Top" Margin="0,0,0,6" ItemsSource="{Binding MiniMonths}">
            <ItemsControl.Styles>
              <Style Selector="Button.day">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
              </Style>
              <Style Selector="Button.day.other">
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                <Setter Property="Opacity" Value="0.7" />
              </Style>
              <Style Selector="Button.day.today">
                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Style>
              <Style Selector="Button.day.today:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Style>
              <Style Selector="Button.day.busy">
                <Setter Property="FontWeight" Value="Bold" />
              </Style>
              <!-- The month shown: lightly; days dragged over or Ctrl+clicked: clearly, in the selection colour of the lists
                   with a frame in the accent -->
              <Style Selector="Button.day.chosen">
                <Setter Property="Background" Value="{DynamicResource TodayBrush}" />
              </Style>
              <Style Selector="Button.day.picked">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Style>
              <Style Selector="Button.day.picked:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
              </Style>
              <Style Selector="Button.day.chosen.today">
                <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
              </Style>
              <Style Selector="Button.week">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
              </Style>
              <Style Selector="Button.nav">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MiniMonth">
                <StackPanel Margin="0,0,0,10">
                  <!-- Header: ‹ Oktober 2026 › – both arrows on the top month -->
                  <Grid ColumnDefinitions="26,*,26" Margin="0,0,0,2">
                    <Button Classes="nav" IsVisible="{Binding IsFirst}" ToolTip.Tip="{l:T 'Vorheriger Monat'}"
                            Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).PreviousMonthCommand}">
                      <PathIcon Data="{StaticResource IconChevronLeft}" Width="10" Height="10" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="nav" IsVisible="{Binding IsFirst}" ToolTip.Tip="{l:T 'Nächster Monat'}"
                            Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).NextMonthCommand}">
                      <PathIcon Data="{StaticResource IconChevronRight}" Width="10" Height="10" />
                    </Button>
                  </Grid>
                  <!-- Weekday initials -->
                  <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                    <ItemsControl ItemsSource="{x:Static vm:MiniMonth.WeekdayHeaders}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Width="26" TextAlignment="Center" FontSize="11" Classes="subtle" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- Six weeks: week number + days; the shown week is highlighted -->
                  <ItemsControl ItemsSource="{Binding Weeks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MiniWeek">
                        <Grid ColumnDefinitions="22,Auto">
                          <Button Classes="week" Content="{Binding NumberText}" ToolTip.Tip="{l:T 'Diese Woche anzeigen'}"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).SelectDayCommand}"
                                  CommandParameter="{Binding Start}" />
                          <Border Grid.Column="1" CornerRadius="3" Background="{DynamicResource TodayBrush}" IsVisible="{Binding IsSelected}" />
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MiniDay">
                                <Button Classes="day" Classes.other="{Binding IsOtherMonth}" Classes.today="{Binding IsToday}" Classes.busy="{Binding HasEvents}"
                                        Classes.chosen="{Binding IsChosen}" Classes.picked="{Binding IsPicked}" Content="{Binding Text}" ToolTip.Tip="{Binding Tooltip}"
                                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).SelectDayCommand}"
                                        CommandParameter="{Binding Date}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,6" />
          <TextBlock DockPanel.Dock="Top" Text="{l:T 'Meine Kalender'}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock DockPanel.Dock="Top" Classes="subtle" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasCalendars}"
                     Text="{l:T 'Noch keine Kalender. Konto mit CalDAV hinzufügen oder einen Internet-Kalender abonnieren.'}" />
          <!-- Grouped by account: a small title per group, arrows (on hover) to move the group -->
          <!-- The scroll bar lies over the content and widens under the mouse: room on the right keeps the filter icons free -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding CalendarGroups}" Margin="0,0,16,0">
            <ItemsControl.Styles>
              <Style Selector="Grid.calendar-row"><Setter Property="Background" Value="Transparent" /></Style>
              <Style Selector="Grid.calendar-row:pointerover"><Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" /></Style>
              <Style Selector="Grid.calendar-row.selected"><Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" /></Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarGroup">
                <StackPanel Margin="0,4,0,6">
                  <Grid ColumnDefinitions="*,Auto,Auto" Classes="group-head" Background="Transparent">
                    <Grid.Styles>
                      <Style Selector="Grid.group-head Button.move"><Setter Property="Opacity" Value="0" /></Style>
                      <Style Selector="Grid.group-head:pointerover Button.move"><Setter Property="Opacity" Value="1" /></Style>
                    </Grid.Styles>
                    <TextBlock Text="{Binding Title}" Classes="subtle" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Title}" VerticalAlignment="Center" Margin="0,0,0,2" />
                    <Button Grid.Column="1" Classes="move" Content="↑" Command="{Binding MoveUpCommand}" Padding="4,0" MinWidth="0" FontSize="11"
                            Background="Transparent" BorderThickness="0" ToolTip.Tip="{l:T 'Nach oben'}" />
                    <Button Grid.Column="2" Classes="move" Content="↓" Command="{Binding MoveDownCommand}" Padding="4,0" MinWidth="0" FontSize="11"
                            Background="Transparent" BorderThickness="0" ToolTip.Tip="{l:T 'Nach unten'}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarListItem">
                      <!-- A click on the row (not on its tick or buttons) chooses the calendar for new events -->
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Classes="calendar-row" Classes.selected="{Binding IsSelected}" Tapped="OnCalendarTapped"
                            Cursor="Hand"
                            Opacity="{Binding IsDimmed, Converter={x:Static app:Converters.DimmedOpacity}}">
                        <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" Padding="0" Margin="0,0,6,0" ToolTip.Tip="{l:T 'Anzeigen'}" />
                        <!-- Color: click to choose (stored in Neruna, the server is not changed) -->
                        <Button Grid.Column="1" Width="16" Height="16" MinWidth="0" Padding="0" CornerRadius="3" Background="{Binding Brush}"
                                BorderThickness="0" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Farbe und Name ändern'}">
                          <Button.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop">
                              <views:CollectionAppearanceEditor />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                        <!-- Long names end in "…" before the filter icon -->
                        <DockPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                          <PathIcon DockPanel.Dock="Right" Data="{StaticResource IconLock}" Width="11" Height="11" Foreground="{DynamicResource SubtleTextBrush}"
                                    IsVisible="{Binding Info.IsReadOnly}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="{l:T 'Nur lesen'}" />
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        </DockPanel>
                        <Button Grid.Column="3" Classes="solo" Classes.on="{Binding IsSolo}" ToolTip.Tip="{Binding SoloTip}" VerticalAlignment="Center" Margin="4,0,0,0"
                                Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ToggleSoloCommand}" CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource IconSolo}" Width="12" Height="12" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Week -->
      <Border Classes="pane" Grid.Column="2" ClipToBounds="True">
        <Panel>
        <!-- Time grid (setting "Kalender → Darstellung"): hours on the left, events at their time -->
        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowTimeGrid}">
          <Grid ColumnDefinitions="52,*">
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).DayCount}" Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDay">
                  <Border Padding="10,8,4,8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1" Classes.today="{Binding IsToday}">
                    <Border.Styles>
                      <Style Selector="Border.today">
                        <Setter Property="Background" Value="{DynamicResource TodayBrush}" />
                      </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Classes="subtle" FontSize="12" Text="{Binding DayName}" />
                        <TextBlock Text="{Binding DayNumber}" FontSize="18" FontWeight="SemiBold" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="command" Padding="6" VerticalAlignment="Top" ToolTip.Tip="{l:T 'Termin an diesem Tag'}"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).NewEventCommand}" CommandParameter="{Binding Date}">
                        <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" Margin="0" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- All-day events -->
          <Grid Grid.Row="1" ColumnDefinitions="52,*">
            <TextBlock Classes="subtle" FontSize="10" Text="{l:T 'ganztägig'}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}" MaxHeight="96">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).DayCount}" Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarDay">
                  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1" MinHeight="26" Padding="2">
                    <ItemsControl ItemsSource="{Binding AllDayEvents}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarEventItem">
                          <Button Padding="0" Margin="0,0,0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).EditEventCommand}" CommandParameter="{Binding}" ContextRequested="OnEventContextRequested"
                                  ToolTip.Tip="{Binding Tooltip}">
                            <Border Background="{Binding Background}" BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="6,2" ClipToBounds="True">
                              <DockPanel>
                              <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding CategoryBrushes}" IsVisible="{Binding HasCategories}" Margin="4,-2,-6,-2" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="IBrush"><Border Width="4" Background="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- Hours -->
          <ScrollViewer x:Name="TimeScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="52,*">
              <ItemsControl ItemsSource="{x:Static vm:CalendarViewModel.Hours}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <!-- Label centred on the hour line above it -->
                    <Border Height="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).HourHeight}">
                      <TextBlock Text="{Binding}" FontSize="11" Classes="subtle" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,8,0" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- Drag on free time: new event; drag an event: move it (also to another day), its top or bottom edge: start or end (CalendarView.axaml.cs) -->
              <Panel x:Name="TimeGrid" Grid.Column="1">
                <!-- Grid lines: solid per hour, lighter for 30/15-minute subdivisions -->
                <ItemsControl ItemsSource="{Binding GridLines}" IsHitTestVisible="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GridLine">
                      <Panel Height="{Binding Height}">
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" IsVisible="{Binding IsHour}" />
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Opacity="0.45" IsVisible="{Binding IsSubdivision}" />
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Day columns -->
                <ItemsControl ItemsSource="{Binding Days}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).DayCount}" Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarDay">
                      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Background="Transparent"
                              Classes.today="{Binding IsToday}" DoubleTapped="OnTimeGridDoubleTapped" ToolTip.Tip="{l:T 'Doppelklick oder ziehen: neuer Termin'}">
                        <Border.Styles>
                          <Style Selector="Border.today">
                            <Setter Property="Background" Value="{DynamicResource TodayBrush}" />
                          </Style>
                        </Border.Styles>
                        <Panel>
                          <ItemsControl ItemsSource="{Binding TimedEvents}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <views:TimeGridPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:TimedEventItem">
                                <Button Padding="0" Margin="1,1,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        ToolTip.Tip="{Binding Item.Tooltip}"
                                        Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).EditEventCommand}" CommandParameter="{Binding Item}"
                                        ContextRequested="OnEventContextRequested" Classes.movable="{Binding CanChange}">
                                  <Button.Styles>
                                    <Style Selector="Button.movable">
                                      <Setter Property="Cursor" Value="SizeAll" />
                                    </Style>
                                  </Button.Styles>
                                  <Panel>
                                  <!-- Edges: drag to change start or end -->
                                  <Border Classes="resize-start" Height="5" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" ZIndex="1" IsVisible="{Binding CanResizeStart}" />
                                  <Border Classes="resize-end" Height="5" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" ZIndex="1" IsVisible="{Binding CanResizeEnd}" />
                                  <Border Background="{Binding Item.Background}" BorderBrush="{Binding Item.Brush}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="6,2" ClipToBounds="True">
                                    <DockPanel>
                              <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Item.CategoryBrushes}" IsVisible="{Binding Item.HasCategories}" Margin="4,-2,-6,-2" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="IBrush"><Border Width="4" Background="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                              </ItemsControl>
                                    <Panel>
                                      <TextBlock IsVisible="{Binding IsShort}" FontSize="12" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Item.Title}" FontWeight="SemiBold" />
                                        <!-- Time in the text colour: grey on the event's colour was too faint -->
                                        <Run Text="{Binding Item.TimeText}" FontSize="11" />
                                      </TextBlock>
                                      <StackPanel IsVisible="{Binding !IsShort}" Spacing="1">
                                        <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Item.TimeText}" FontSize="11" />
                                        <TextBlock Text="{Binding Item.Location}" FontSize="11" IsVisible="{Binding Item.HasLocation}" TextTrimming="CharacterEllipsis" />
                                      </StackPanel>
                                    </Panel>
                                    </DockPanel>
                                  </Border>
                                  </Panel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <!-- "Now" line on today -->
                          <Border Height="2" Background="#C50F1F" VerticalAlignment="Top" IsVisible="{Binding IsToday}" IsHitTestVisible="False"
                                  Margin="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).NowTop, Converter={x:Static app:Converters.TopMargin}}" />
                        </Panel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- While dragging: where the event goes, with its time -->
                <Canvas IsHitTestVisible="False">
                  <Border x:Name="DragPreview" IsVisible="False" BorderThickness="3,0,0,0" CornerRadius="3" Padding="6,2" Opacity="0.9" ClipToBounds="True">
                    <TextBlock x:Name="DragPreviewText" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </Border>
                </Canvas>
              </Panel>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- Planung: a row per calendar, the events as blocks along the days and hours -->
        <DockPanel IsVisible="{Binding ShowPlanning}" Margin="0,4,0,0">
          <!-- Legend -->
          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{x:Static vm:CalendarViewModel.PlanningLegend}" Margin="12,8,12,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShowAsOption">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Brush}" Opacity="0.9" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" FontSize="12" Classes="subtle" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- People to show by their free/busy (Microsoft 365, Exchange) – no subscription needed -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="200,*" Margin="0,0,12,8">
            <TextBlock Text="{l:T 'Personen'}" VerticalAlignment="Center" Margin="10,0,8,0" Classes="subtle" />
            <ctl:RecipientBox Grid.Column="1" Text="{Binding PlanningPeopleText}" Directory="{Binding Recipients}"
                              PlaceholderText="{l:T 'Name oder Adresse – zeigt, wann jemand beschäftigt ist (Microsoft 365, Exchange)'}" />
          </Grid>
          <!-- Axis: days and hours -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="200,*" Margin="0,0,12,0">
            <ItemsControl Grid.Column="1" ItemsSource="{Binding PlanningDays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanningDay">
                  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,1" Padding="4,2" Classes.today="{Binding IsToday}">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" />
                      <ItemsControl ItemsSource="{Binding Hours}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10" Classes="subtle" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <ScrollViewer>
            <StackPanel>
            <ItemsControl ItemsSource="{Binding PlanningRows}" Margin="0,0,12,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanningRow">
                  <Grid ColumnDefinitions="200,*" Height="34">
                    <DockPanel Margin="10,0,8,0" VerticalAlignment="Center">
                      <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Owner}" Classes="subtle" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                    <!-- Day lines behind the blocks -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).PlanningDays}" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanningDay">
                          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,1" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Blocks}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <views:PlanningPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanningBlock">
                          <Border Background="{Binding Brush}" Opacity="{Binding Opacity}" CornerRadius="3" ToolTip.Tip="{Binding Tip}"
                                  DoubleTapped="OnPlanningBlockDoubleTapped" Cursor="Hand" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- People by their free/busy from the server -->
            <ItemsControl ItemsSource="{Binding PlanningPeople}" Margin="0,0,12,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanningRow">
                  <Grid ColumnDefinitions="200,*" Height="34">
                    <DockPanel Margin="10,0,8,0" VerticalAlignment="Center">
                      <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Text="{Binding Owner}" Classes="subtle" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                    <!-- Day lines behind the blocks -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).PlanningDays}" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanningDay">
                          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,1" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Blocks}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <views:PlanningPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanningBlock">
                          <Border Background="{Binding Brush}" Opacity="{Binding Opacity}" CornerRadius="3" ToolTip.Tip="{Binding Tip}"
                                  DoubleTapped="OnPlanningBlockDoubleTapped" Cursor="Hand" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding PlanningPeopleNote}" IsVisible="{Binding PlanningPeopleNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="10,8,12,0" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- List per day (default) -->
        <ItemsControl ItemsSource="{Binding Days}" IsVisible="{Binding ShowList}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).DayCount}" Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarDay">
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                  <Border Padding="10,8,4,8" Classes.today="{Binding IsToday}">
                    <Border.Styles>
                      <Style Selector="Border.today">
                        <Setter Property="Background" Value="{DynamicResource TodayBrush}" />
                      </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock Classes="subtle" FontSize="12" Text="{Binding DayName}" />
                        <TextBlock Text="{Binding DayNumber}" FontSize="18" FontWeight="SemiBold" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="command" Padding="6" VerticalAlignment="Top" ToolTip.Tip="{l:T 'Termin an diesem Tag'}"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).NewEventCommand}" CommandParameter="{Binding Date}">
                        <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" Margin="0" />
                      </Button>
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Events}" Margin="4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarEventItem">
                          <Button Padding="0" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="Transparent" BorderThickness="0"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).EditEventCommand}" CommandParameter="{Binding}" ContextRequested="OnEventContextRequested"
                                  ToolTip.Tip="{Binding Tooltip}">
                            <Border Background="{Binding Background}" BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0"
                                    CornerRadius="3" Padding="8,5" ClipToBounds="True">
                              <DockPanel>
                              <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding CategoryBrushes}" IsVisible="{Binding HasCategories}" Margin="4,-5,-8,-5" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="IBrush"><Border Width="4" Background="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding TimeText}" FontSize="11" Classes="subtle" />
                                  <PathIcon Data="{StaticResource IconSync}" Width="9" Height="9" IsVisible="{Binding IsRecurring}" ToolTip.Tip="{l:T 'Serie'}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Location}" FontSize="11" Classes="subtle" IsVisible="{Binding HasLocation}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              </DockPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Month: whole weeks, per day its first events and "+N weitere"; the day's number opens the day, a double-click on free space a new event -->
        <Grid x:Name="MonthGrid" RowDefinitions="Auto,*" IsVisible="{Binding ShowMonth}" SizeChanged="OnMonthGridSizeChanged">
          <ItemsControl ItemsSource="{x:Static vm:CalendarViewModel.MonthWeekdays}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="subtle" FontSize="12" Margin="8,6" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" Rows="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).MonthRows}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CalendarDay">
                <Border Classes="monthday" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,1,0" ClipToBounds="True"
                        Classes.today="{Binding IsToday}" Classes.other="{Binding IsOtherMonth}" DoubleTapped="OnMonthDayDoubleTapped">
                  <Border.Styles>
                    <!-- Transparent, not empty: a double-click on free space must reach the day -->
                    <Style Selector="Border.monthday">
                      <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Border.monthday.today">
                      <Setter Property="Background" Value="{DynamicResource TodayBrush}" />
                    </Style>
                    <Style Selector="Border.other">
                      <Setter Property="Opacity" Value="0.55" />
                    </Style>
                  </Border.Styles>
                  <DockPanel Margin="4,2,4,4">
                    <Button DockPanel.Dock="Top" Classes="command" Padding="4,1" HorizontalAlignment="Left" FontSize="13" FontWeight="SemiBold"
                            Content="{Binding MonthDayText}" ToolTip.Tip="{l:T 'Diesen Tag anzeigen'}"
                            Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ShowDayCommand}" CommandParameter="{Binding Date}" />
                    <StackPanel Spacing="2">
                      <ItemsControl ItemsSource="{Binding MonthEvents}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CalendarEventItem">
                            <Button Padding="0" Margin="0,0,0,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" Height="18"
                                    Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).EditEventCommand}" CommandParameter="{Binding}" ContextRequested="OnEventContextRequested"
                                    ToolTip.Tip="{Binding Tooltip}">
                              <Panel>
                                <!-- All-day: a coloured bar; with a time: a dot, the start and the title -->
                                <!-- As in the week: the calendar's colour as a light tint with a bar on the left, the text in the text
                                     colour – readable with light colours (grey, orange) and in dark mode -->
                                <Border IsVisible="{Binding IsAllDay}" Background="{Binding Background}" BorderBrush="{Binding Brush}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="5,0">
                                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <DockPanel IsVisible="{Binding !IsAllDay}" Margin="2,0">
                                  <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                  <TextBlock DockPanel.Dock="Left" Text="{Binding StartText}" FontSize="11" Classes="subtle" VerticalAlignment="Center" Margin="0,0,5,0" />
                                  <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                              </Panel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="command" Padding="4,0" HorizontalAlignment="Left" FontSize="11" IsVisible="{Binding HasMoreEvents}"
                              Content="{Binding MoreEventsText}" ToolTip.Tip="{l:T 'Alle Termine dieses Tages anzeigen'}"
                              Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).ShowDayCommand}" CommandParameter="{Binding Date}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <!-- Search hits over the week: coming events, then past ones -->
        <DockPanel IsVisible="{Binding IsSearching}" Background="{DynamicResource PaneBackgroundBrush}">
          <TextBlock DockPanel.Dock="Top" Text="{Binding SearchStatus}" Classes="subtle" Margin="14,10,14,4" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding SearchResults}" Margin="8,0,8,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarSearchGroup">
                  <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="6,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Hits}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarSearchHit">
                          <Button Padding="0" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  Background="Transparent" BorderThickness="0"
                                  Command="{Binding $parent[UserControl].((vm:CalendarViewModel)DataContext).OpenSearchHitCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="{Binding Item.Tooltip}">
                            <Border Background="{Binding Item.Background}" BorderBrush="{Binding Item.Brush}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="10,6" ClipToBounds="True">
                              <DockPanel>
                              <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Item.CategoryBrushes}" IsVisible="{Binding Item.HasCategories}" Margin="8,-6,-10,-6" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="IBrush"><Border Width="4" Background="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Grid ColumnDefinitions="260,*,Auto">
                                <StackPanel Spacing="1">
                                  <TextBlock Text="{Binding DateText}" FontSize="13" />
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Item.TimeText}" FontSize="11" Classes="subtle" />
                                    <PathIcon Data="{StaticResource IconSync}" Width="9" Height="9" IsVisible="{Binding Item.IsRecurring}" ToolTip.Tip="{l:T 'Serie'}" />
                                  </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1" Margin="12,0">
                                  <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Item.Location}" FontSize="11" Classes="subtle" IsVisible="{Binding Item.HasLocation}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding CalendarName}" FontSize="11" Classes="subtle" VerticalAlignment="Center" />
                              </Grid>
                              </DockPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
