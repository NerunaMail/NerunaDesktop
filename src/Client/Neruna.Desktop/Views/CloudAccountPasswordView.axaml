<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.CloudAccountPasswordView"
             x:DataType="vm:CloudAccountPasswordViewModel">

  <StackPanel>
    <TextBlock Text="Konto Ihrer Organisation einrichten" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Intro}" />

    <TextBlock Classes="label" Text="Passwort" />
    <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="●" PlaceholderText="{Binding Email, StringFormat='Passwort für {0}'}" />

    <TextBlock Classes="error" Text="{Binding Error}" Margin="0,12,0,0" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">
      <ProgressBar IsIndeterminate="True" Width="80" MinWidth="0" Height="4" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="Später" Command="{Binding LaterCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="Einrichten" Command="{Binding CompleteCommand}" IsDefault="True" />
    </Grid>
  </StackPanel>
</UserControl>
