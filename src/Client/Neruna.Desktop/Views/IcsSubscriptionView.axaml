<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.IcsSubscriptionView"
             x:DataType="vm:IcsSubscriptionViewModel">

  <StackPanel>
    <TextBlock Text="{l:T 'Internet-Kalender abonnieren'}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,8"
               Text="{l:T 'Feiertage, Schulferien, Spielpläne oder veröffentlichte Kalender als ICS- oder webcal-Link. Abonnierte Kalender sind schreibgeschützt.'}" />

    <TextBlock Classes="label" Text="{l:T 'Adresse'}" />
    <TextBox Text="{Binding Url}" PlaceholderText="{l:T 'webcal://… oder https://….ics'}" />

    <TextBlock Classes="label" Text="{l:T 'Name (optional)'}" />
    <TextBox Text="{Binding Name}" PlaceholderText="{l:T 'z. B. Feiertage Zürich'}" />

    <TextBlock Classes="error" Text="{Binding Error}" Margin="0,12,0,0"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">
      <ProgressBar IsIndeterminate="True" Width="80" MinWidth="0" Height="4" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="{l:T 'Abonnieren'}" Command="{Binding SubscribeCommand}" />
    </Grid>
  </StackPanel>
</UserControl>
