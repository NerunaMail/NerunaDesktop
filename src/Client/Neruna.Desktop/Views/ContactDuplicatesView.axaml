<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.ContactDuplicatesView"
             x:DataType="vm:ContactDuplicatesViewModel">
  <!-- Kontakte → Duplikate: the same person in several contacts, merged into the one chosen -->
  <StackPanel>
    <TextBlock Text="{l:T 'Doppelte Kontakte'}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,12"
               Text="{l:T 'Kontakte mit gleichem Namen, gleicher E-Mail-Adresse oder gleicher Telefonnummer. Beim Zusammenführen bekommt der gewählte Kontakt alles, was die anderen zusätzlich haben – Adressen, Nummern, Notizen, Bild –, die anderen werden gelöscht. Gruppen zeigen danach auf den gewählten Kontakt.'}" />

    <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
    <TextBlock Classes="subtle" Text="{l:T 'Keine doppelten Kontakte gefunden.'}" IsVisible="{Binding HasNone}" />

    <ItemsControl ItemsSource="{Binding Sets}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DuplicateSet">
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Classes="subtle" FontSize="12" Text="{l:T 'Behalten und ergänzen:'}" />
              <ItemsControl ItemsSource="{Binding Contacts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DuplicateContact">
                    <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsKeep}" Width="250" VerticalContentAlignment="Top" Margin="0,0,12,6">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="subtle" FontSize="12" Text="{Binding AddressBook}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Text="{Binding Details}" TextWrapping="Wrap" />
                      </StackPanel>
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{l:T 'Nicht dieselbe Person'}" Command="{Binding SkipCommand}" />
                <Button Classes="accent" Content="{l:T 'Zusammenführen'}" Command="{Binding MergeCommand}"
                        IsEnabled="{Binding !$parent[UserControl].((vm:ContactDuplicatesViewModel)DataContext).IsBusy}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Button Classes="accent" Content="{l:T 'Fertig'}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" />
  </StackPanel>
</UserControl>
