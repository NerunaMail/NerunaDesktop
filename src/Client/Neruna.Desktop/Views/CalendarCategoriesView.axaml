<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:views="using:Neruna.Desktop.Views"
             x:Class="Neruna.Desktop.Views.CalendarCategoriesView"
             x:DataType="vm:CalendarCategoriesViewModel">
  <StackPanel Spacing="8">
    <TextBlock Classes="subtle" TextWrapping="Wrap"
               Text="{l:T 'Kategorien ordnen Termine – im Kalender als farbige Linie rechts am Termin, die Namen zeigt der Tooltip. Gespeichert wird der Name beim Termin auf dem Server, so sehen ihn auch andere Kalenderprogramme.'}" />
    <views:ColorListEditor />
    <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
               Text="{l:T 'Beim Umbenennen behalten bestehende Termine den alten Namen und erscheinen ohne Farbe, bis Sie die Kategorie beim Termin neu wählen.'}" />
  </StackPanel>
</UserControl>
