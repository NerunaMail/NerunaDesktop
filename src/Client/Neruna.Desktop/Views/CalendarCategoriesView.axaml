<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:views="using:Neruna.Desktop.Views"
             xmlns:core="using:Neruna.Core.Calendar"
             xmlns:app="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.Views.CalendarCategoriesView"
             x:DataType="vm:CalendarCategoriesViewModel">
  <StackPanel Spacing="8">
    <TextBlock Classes="subtle" TextWrapping="Wrap"
               Text="{l:T 'Kategorien ordnen Termine – im Kalender als farbige Linie rechts am Termin, die Namen zeigt der Tooltip. Gespeichert wird der Name beim Termin auf dem Server, so sehen ihn auch andere Kalenderprogramme.'}" />

    <!-- The organisation's (Neruna Cloud): shown, not editable -->
    <StackPanel Spacing="4" IsVisible="{Binding HasCloud}">
      <TextBlock Text="{l:T 'Von Ihrer Organisation'}" FontWeight="SemiBold" Margin="0,6,0,0" />
      <ItemsControl ItemsSource="{Binding FromCloud}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:CalendarCategory">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
              <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Color, Converter={x:Static app:Converters.ColorBrush}}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                      ToolTip.Tip="{l:T 'Von Ihrer Organisation in der Neruna Cloud'}">
                <TextBlock Text="{l:T 'Cloud'}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{l:T 'Eigene Kategorien'}" FontWeight="SemiBold" Margin="0,6,0,0" />
    </StackPanel>
    <views:ColorListEditor />
    <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
               Text="{l:T 'Beim Umbenennen behalten bestehende Termine den alten Namen und erscheinen ohne Farbe, bis Sie die Kategorie beim Termin neu wählen.'}" />
  </StackPanel>
</UserControl>
