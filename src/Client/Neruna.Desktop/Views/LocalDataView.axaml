<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.LocalDataView"
             x:DataType="vm:LocalDataViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">
    <!-- The local database: SQLite reuses freed space but does not give it back by itself -->
    <StackPanel Spacing="8">
      <TextBlock Text="{l:T 'Lokale Daten'}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding DatabaseSizeText}" />
      <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                 Text="{l:T 'Gelöschte Nachrichten, entfernte Konten und ausgeschaltete Suchindizes hinterlassen freien Platz in der Datenbank. Neruna nutzt ihn wieder, die Datei wird aber erst durch «Datenbank verkleinern» kleiner. Das kann bei einer grossen Datenbank eine Weile dauern.'}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{l:T 'Datenbank verkleinern'}" Command="{Binding CompactCommand}" />
        <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsCompacting}" />
        <TextBlock Text="{Binding CompactResult}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
