<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neruna.Desktop.ViewModels"
        xmlns:views="using:Neruna.Desktop.Views"
        x:Class="Neruna.Desktop.Views.ComposeWindow"
        x:DataType="vm:ComposeViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="980" Height="780" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PaneBackgroundBrush}">
  <views:ComposeView />
</Window>
