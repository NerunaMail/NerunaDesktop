<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:app="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.Views.CalendarSelectionView"
             x:DataType="vm:CalendarSelectionViewModel">
  <StackPanel>
    <TextBlock Text="Kalender verwalten" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,12"
               Text="Neruna fragt den Server erneut nach allen Kalendern – auch nach solchen, die Sie inzwischen im Webmail (z. B. SOGo) abonniert haben oder die mit Ihnen geteilt wurden. Wählen Sie, welche angezeigt werden sollen." />

    <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0" IsVisible="{Binding IsBusy}" Margin="0,0,0,8" />
    <TextBlock Classes="subtle" Text="Kein CalDAV-Konto eingerichtet." IsVisible="{Binding HasNoSources}" />

    <ItemsControl ItemsSource="{Binding Sources}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CalendarSourceGroup">
          <StackPanel Margin="0,4,0,14">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" Text="{Binding Server}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="subtle" Text="{Binding Details}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                       IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,6,0,0"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ItemsControl ItemsSource="{Binding Calendars}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalendarChoiceItem">
                  <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                              Background="{Binding Color, Converter={x:Static app:Converters.ColorBrush}}" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <Border IsVisible="{Binding IsNew}" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                        <TextBlock Text="neu" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock IsVisible="{Binding IsReadOnly}" Classes="subtle" Text="schreibgeschützt" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock IsVisible="{Binding IsAddedByUrl}" Classes="subtle" Text="per Adresse" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fallback when the server does not list a subscription: paste its CalDAV address -->
            <StackPanel IsVisible="{Binding CanAddByUrl}" Margin="0,8,0,0" Spacing="4">
              <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                         Text="Kalender fehlt? Adresse aus dem Webmail einfügen – SOGo: beim Kalender ⋮ → «Links zu diesem Kalender» → CalDAV-URL." />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding NewUrl}" PlaceholderText="https://…/SOGo/dav/…/Calendar/…/" />
                <Button Grid.Column="1" Content="Hinzufügen" Margin="6,0,0,0"
                        Command="{Binding $parent[UserControl].((vm:CalendarSelectionViewModel)DataContext).AddByUrlCommand}" CommandParameter="{Binding}" />
              </Grid>
              <ProgressBar IsIndeterminate="True" Height="3" MinWidth="0" IsVisible="{Binding IsAdding}" />
              <TextBlock Classes="error" Text="{Binding AddError}" TextWrapping="Wrap"
                         IsVisible="{Binding AddError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,8,0,0"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
      <Button Classes="command" Command="{Binding RefreshCommand}" ToolTip.Tip="Server erneut abfragen">
        <StackPanel Orientation="Horizontal">
          <PathIcon Data="{StaticResource IconSync}" />
          <TextBlock Text="Erneut suchen" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="Übernehmen" Command="{Binding ApplyCommand}" />
    </Grid>
  </StackPanel>
</UserControl>
