<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:controls="using:Neruna.Desktop.Controls"
             xmlns:local="using:Neruna.Desktop.Views"
             xmlns:app="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.Views.ChatView"
             x:DataType="vm:ChatViewModel">

  <UserControl.Styles>
    <!-- Rooms and private conversations on the left: a full-width button; the open one highlighted -->
    <Style Selector="Button.conversation">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.conversation.selected">
      <Setter Property="Background" Value="{DynamicResource TodayBrush}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#C50F1F" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.avatar">
      <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <Style Selector="Border.avatar TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.presence">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Stroke" Value="{DynamicResource PaneBackgroundBrush}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,-2,-2" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="Margin" Value="8,10,8,4" />
    </Style>
    <!-- Own messages: the name in the accent colour -->
    <Style Selector="TextBlock.sender.mine">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <!-- A tab per chat (organisation, Nextcloud Talk account); the open one on the pane colour -->
    <Style Selector="Button.chattab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.chattab.selected">
      <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
    </Style>
    <Style Selector="Button.chattab.selected TextBlock.tabtitle">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Not focusable: a click must leave the caret and the selection in the text field -->
    <Style Selector="Button.format">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="30" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- The chats: one tab per organisation (Neruna Cloud/Control) and per Nextcloud account with Talk switched on.
         The own status (window header) is the same in all of them. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6" IsVisible="{Binding ShowTabs}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatTabItem">
              <Button Classes="chattab" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding KindText}"
                      Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                            IsVisible="{Binding !IsTalk}" />
                  <PathIcon Data="{StaticResource IconVideo}" Width="14" Height="14" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                            IsVisible="{Binding IsTalk}" />
                  <TextBlock Classes="tabtitle" Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                  <!-- The own status in this chat -->
                  <Ellipse Width="8" Height="8" Fill="{Binding PresenceBrush}" VerticalAlignment="Center" />
                  <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12" Foreground="#CA5010" VerticalAlignment="Center" IsVisible="{Binding HasError}" />
                  <Border Classes="badge" IsVisible="{Binding HasUnread}">
                    <TextBlock Text="{Binding UnreadText}" />
                  </Border>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <!-- Nextcloud Talk per Nextcloud account: switched on here, then a tab of its own -->
      <Button Grid.Column="1" Classes="chattab" IsVisible="{Binding HasAccountChats}" VerticalAlignment="Center"
              ToolTip.Tip="{l:T 'Nextcloud Talk eines Nextcloud-Kontos als eigenen Tab anzeigen'}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource IconAdd}" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Text="{l:T 'Nextcloud Talk'}" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="6" MaxWidth="360">
              <TextBlock Text="{l:T 'Nextcloud Talk im Chat anzeigen'}" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding AccountChats}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccountChatChoice">
                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsEnabled}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                         Text="{l:T 'Mit derselben Anmeldung wie Kalender und Kontakte. Anrufe öffnen sich in Nextcloud Talk im Browser.'}" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>
  <Panel>
    <!-- Without Neruna Cloud/Control there is no chat: say so, offer to connect -->
    <Border Classes="pane" IsVisible="{Binding ShowNotConnected}">
      <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
        <PathIcon Data="{StaticResource IconChat}" Width="44" Height="44" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="{l:T 'Der Chat braucht Neruna Cloud, Control oder Nextcloud Talk'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Classes="subtle" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{l:T 'Räume, private Nachrichten und der Online-Status laufen über einen Server: den Ihrer Organisation (Neruna Cloud oder Control) oder Ihre Nextcloud mit Talk. Neruna allein (ohne Server) hat keinen Chat.'}" />
        <Button Classes="accent" Content="{l:T 'Mit der Cloud verbinden …'}" HorizontalAlignment="Center" Command="{Binding OpenCloudSetupCommand}" Margin="0,6,0,0" />
        <!-- A Nextcloud account is there: its Talk can be switched on right here -->
        <StackPanel Spacing="6" IsVisible="{Binding HasAccountChats}" HorizontalAlignment="Center" Margin="0,12,0,0">
          <TextBlock Text="{l:T 'Nextcloud Talk im Chat anzeigen'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding AccountChats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AccountChatChoice">
                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsEnabled}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Connected, but the licence leaves the chat out -->
    <Border Classes="pane" IsVisible="{Binding ShowNotIncluded}">
      <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="24">
        <PathIcon Data="{StaticResource IconChat}" Width="44" Height="44" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="{l:T 'Der Chat ist ausgeschaltet'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Classes="subtle" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{l:T 'Deine Organisation nutzt den Chat nicht – er ist im Portal ausgeschaltet oder nicht in der Lizenz enthalten. Es werden keine Chatnachrichten gespeichert.'}" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="260,6,*" IsVisible="{Binding ShowChat}">

      <!-- Left: rooms and private conversations, below the people of the open room -->
      <Border Classes="pane" Padding="6,4">
        <Grid RowDefinitions="Auto,*,Auto,*">
          <!-- The own status: with several chats for this one only or for all (e.g. offline at work, available in private) -->
          <Button x:Name="TabPresenceButton" Classes="conversation" Margin="0,2,0,4" ToolTip.Tip="{l:T 'Mein Online-Status in diesem Chat'}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Ellipse Width="10" Height="10" Fill="{Binding TabPresenceBrush}" VerticalAlignment="Center" Margin="2,0,10,0" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{l:T 'Mein Status: '}" Foreground="{DynamicResource SubtleTextBrush}" /><Run Text="{Binding TabPresenceLabel, Mode=OneWay}" />
              </TextBlock>
              <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="10" Height="10" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ItemsControl ItemsSource="{x:Static vm:ChatViewModel.PresenceChoices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresenceChoice">
                      <!-- Click only (no Command binding): the list closes on the click -->
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,1">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Padding="8,6" MinWidth="170"
                                Click="OnPresenceForAll" ToolTip.Tip="{l:T 'Für alle Chats setzen'}">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Padding="8,4" FontSize="12" Click="OnPresenceHere" Content="{l:T 'Nur dieser Chat'}"
                                IsVisible="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).HasSeveralChats}" />
                        <Button Grid.Column="2" Padding="8,4" FontSize="12" Click="OnPresenceForAll" Content="{l:T 'Alle Chats'}"
                                IsVisible="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).HasSeveralChats}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ScrollViewer Grid.Row="1">
            <StackPanel>
              <TextBlock Classes="section" Text="{l:T 'Räume'}" />
              <TextBlock Classes="subtle" FontSize="12" Margin="8,0,8,6" TextWrapping="Wrap" Text="{Binding RoomsEmptyText}"
                         IsVisible="{Binding !Rooms.Count}" />
              <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatConversationItem">
                    <Button Classes="conversation" Classes.selected="{Binding IsSelected}"
                            Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Subtitle}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="#" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" Margin="2,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   FontWeight="{Binding HasUnread, Converter={x:Static app:Converters.BoldIf}}" />
                        <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasUnread}">
                          <TextBlock Text="{Binding UnreadText}" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="section" Text="{l:T 'Private Nachrichten'}" />
              <TextBlock Classes="subtle" FontSize="12" Margin="8,0,8,6" TextWrapping="Wrap" Text="{l:T 'Ein Klick auf eine Person unten beginnt eine private Unterhaltung.'}"
                         IsVisible="{Binding !Directs.Count}" />
              <ItemsControl ItemsSource="{Binding Directs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatConversationItem">
                    <Button Classes="conversation" Classes.selected="{Binding IsSelected}"
                            Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Margin="0,0,10,0">
                          <Border Classes="avatar" Width="26" Height="26" CornerRadius="13"><TextBlock Text="{Binding Initials}" FontSize="10" /></Border>
                          <Ellipse Classes="presence" Fill="{Binding PresenceBrush}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   FontWeight="{Binding HasUnread, Converter={x:Static app:Converters.BoldIf}}" />
                        <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasUnread}">
                          <TextBlock Text="{Binding UnreadText}" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="4,6,4,0">
            <TextBlock Classes="section" Text="{Binding PeopleTitle}" Margin="4,8,4,4" />
          </Border>

          <!-- The people of the room (online first); a click opens a private conversation -->
          <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding People}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatPersonItem">
                  <Button Classes="conversation" IsHitTestVisible="{Binding !IsMe}"
                          Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).OpenPrivateCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{l:T 'Private Nachricht schreiben'}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Panel Margin="0,0,10,0">
                        <Border Classes="avatar"><TextBlock Text="{Binding Initials}" /></Border>
                        <Ellipse Classes="presence" Fill="{Binding PresenceBrush}" />
                      </Panel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="subtle" FontSize="11" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding PresenceLabel, Mode=OneWay}" /><Run Text="{Binding PositionSuffix, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Right: the conversation -->
      <Border Grid.Column="2" Classes="pane">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="subtle" FontSize="12" Text="{Binding Subtitle}" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,0,0,0">
              <!-- Audio and video calls: in Nextcloud Talk (the browser) – its conference functions without a call client here -->
              <Button Command="{Binding CallCommand}" IsVisible="{Binding CanCall}" Padding="10,5"
                      ToolTip.Tip="{l:T 'Audio- oder Videoanruf in Nextcloud Talk starten (öffnet sich im Browser)'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconVideo}" Width="14" Height="14" VerticalAlignment="Center" />
                  <TextBlock Text="{l:T 'Anruf'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <!-- How long messages are kept (the organisation's retention; Talk: the Nextcloud's) -->
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent"
                          ToolTip.Tip="{Binding RetentionDetails}">
                <PathIcon Data="{StaticResource IconClock}" Width="13" Height="13" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
                <TextBlock Classes="subtle" FontSize="12" Text="{Binding RetentionText}" VerticalAlignment="Center" />
              </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer x:Name="MessageScroller" Grid.Row="1" Padding="16,8,16,8">
            <StackPanel>
              <TextBlock Classes="subtle" Text="{l:T 'Noch keine Nachrichten – schreiben Sie die erste.'}" HorizontalAlignment="Center" Margin="0,24"
                         IsVisible="{Binding !Messages.Count}" />
              <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatMessageItem">
                    <StackPanel>
                      <TextBlock Classes="subtle" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"
                                 Text="{Binding DayHeader}" IsVisible="{Binding HasDayHeader}" />
                      <Grid ColumnDefinitions="40,*" Margin="{Binding ShowHeader, Converter={x:Static local:ChatView.MessageMargin}}">
                        <Border Classes="avatar" VerticalAlignment="Top" HorizontalAlignment="Left" IsVisible="{Binding ShowHeader}">
                          <TextBlock Text="{Binding Initials}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowHeader}">
                            <TextBlock Classes="sender" Classes.mine="{Binding IsMine}" Text="{Binding SenderName}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Classes="subtle" FontSize="11" Text="{Binding Time}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                          </StackPanel>
                          <controls:ChatText Markup="{Binding Text}" TextWrapping="Wrap" ToolTip.Tip="{Binding Time}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <TextBlock Grid.Row="2" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Margin="16,0,16,4" TextWrapping="Wrap" />

          <!-- The chat is stored on the organisation's server without end-to-end encryption: say so where one writes -->
          <Border Grid.Row="3" Background="{DynamicResource WarnBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="12,0,12,6">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource IconWarning}" Width="13" Height="13" Foreground="#CA5010" VerticalAlignment="Top" Margin="0,2,8,0" />
              <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                         Text="{l:T 'Der Chat ist nicht Ende-zu-Ende-verschlüsselt – bitte keine vertraulichen Daten senden. Dafür E-Mail mit S/MIME-Verschlüsselung oder einen Ende-zu-Ende-verschlüsselten Messenger verwenden.'}" />
            </Grid>
          </Border>

          <!-- Writing: bold, underlined, smileys; Enter sends, Shift+Enter makes a new line -->
          <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Margin="12,0,12,12" Padding="4">
            <Grid RowDefinitions="Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="format" Click="OnBold" ToolTip.Tip="{l:T 'Fett (Ctrl+B) – erscheint als **Text**'}">
                  <TextBlock Text="{l:T 'F'}" FontWeight="Bold" />
                </Button>
                <Button Classes="format" Click="OnUnderline" ToolTip.Tip="{l:T 'Unterstrichen (Ctrl+U) – erscheint als __Text__'}">
                  <TextBlock Text="{l:T 'U'}" TextDecorations="Underline" />
                </Button>
                <Button x:Name="EmojiButton" Classes="format" ToolTip.Tip="{l:T 'Smiley einfügen'}">
                  <TextBlock Text="🙂" />
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <ItemsControl ItemsSource="{x:Static vm:ChatViewModel.Emojis}" Width="324">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Classes="format" Width="36" Height="34" Padding="0" Click="OnEmoji" Tag="{Binding}" HorizontalContentAlignment="Center">
                              <TextBlock Text="{Binding}" FontSize="18" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox x:Name="DraftBox" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" MaxLength="4000"
                         BorderThickness="0" Background="Transparent" PlaceholderText="{l:T 'Nachricht schreiben – Enter sendet, Shift+Enter neue Zeile'}" />
                <Button Grid.Column="1" Classes="accent" Command="{Binding SendCommand}" VerticalAlignment="Bottom" Margin="6,0,2,2" Padding="10,6"
                        ToolTip.Tip="{l:T 'Senden (Enter)'}">
                  <PathIcon Data="{StaticResource IconSend}" Width="14" Height="14" />
                </Button>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Panel>
  </DockPanel>
</UserControl>
