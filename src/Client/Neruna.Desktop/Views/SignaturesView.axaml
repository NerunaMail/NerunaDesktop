<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:core="using:Neruna.Core.Mail"
             x:Class="Neruna.Desktop.Views.SignaturesView"
             x:DataType="vm:SignaturesViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,0,16">
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Left"
               Text="{l:T 'Signaturen werden beim Verfassen über dem zitierten Text eingefügt. Beim Schreiben lässt sich die Signatur über «Signatur» wechseln oder entfernen.'}" />

    <Grid Grid.Row="1" ColumnDefinitions="260,16,*" MinHeight="260">
      <!-- List -->
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding IsCloudSelected}"
                   Text="{l:T 'Diese Signatur pflegt Ihre Organisation im Neruna-Portal. Sie wird hier automatisch aktuell gehalten und kann wie jede andere Signatur gewählt werden.'}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Classes="accent" Content="{l:T 'Neu'}" Command="{Binding NewCommand}" />
          <Button Content="{l:T 'Bearbeiten'}" Command="{Binding EditCommand}" />
          <Button Content="{l:T 'Löschen'}" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4">
          <Panel>
            <TextBlock Classes="subtle" Text="{l:T 'Noch keine Signatur – «Neu» erstellt eine.'}" TextWrapping="Wrap" Margin="12" IsVisible="{Binding !HasSignatures}" />
            <ListBox ItemsSource="{Binding Signatures}" SelectedItem="{Binding Selected}" Background="Transparent" DoubleTapped="OnDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:Signature">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="1" IsVisible="{Binding IsFromCloud}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="3"
                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Von Ihrer Organisation in der Neruna Cloud'}">
                      <TextBlock Text="{l:T 'Cloud'}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </Border>
      </DockPanel>

      <!-- Preview -->
      <Border Grid.Column="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource PaperBrush}" ClipToBounds="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{l:T 'Vorschau'}" FontSize="11" Foreground="#707070" Margin="24,10,12,4" />
          <!-- The HtmlPanel is created in code-behind (fresh one per theme: the renderer keeps its first stylesheet) -->
          <Border x:Name="PreviewHost" Margin="24,0,12,12" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- Defaults per account -->
    <StackPanel Grid.Row="2" Spacing="8" Margin="0,22,0,0">
      <TextBlock Text="{l:T 'Standardsignatur pro Konto'}" FontSize="16" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="260,16,240,16,240" IsVisible="{Binding Accounts.Count}">
        <TextBlock Classes="subtle" Text="{l:T 'Konto'}" />
        <TextBlock Grid.Column="2" Classes="subtle" Text="{l:T 'Neue Nachrichten'}" />
        <TextBlock Grid.Column="4" Classes="subtle" Text="{l:T 'Antworten/Weiterleitungen'}" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Accounts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AccountSignatureRow">
            <Grid ColumnDefinitions="260,16,240,16,240" Margin="0,3">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedItem="{Binding NewMessages}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SignatureChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="4" ItemsSource="{Binding Choices}" SelectedItem="{Binding RepliesAndForwards}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SignatureChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="subtle" Text="{l:T 'Kein E-Mail-Konto eingerichtet.'}" IsVisible="{Binding !Accounts.Count}" />
    </StackPanel>
  </Grid>
</UserControl>
