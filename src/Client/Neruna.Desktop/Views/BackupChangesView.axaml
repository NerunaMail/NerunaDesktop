<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.BackupChangesView"
             x:DataType="vm:BackupChangesViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{l:T 'Seit der letzten Sicherung geändert'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{l:T 'Später'}" Command="{Binding LaterCommand}" ToolTip.Tip="{l:T 'Erst nach der nächsten Änderung wieder fragen'}" />
      <Button Content="{l:T 'Schliessen'}" Command="{Binding CloseCommand}" />
      <Button Classes="accent" Content="{l:T 'Jetzt sichern'}" Command="{Binding BackupNowCommand}" />
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock Classes="subtle" TextWrapping="Wrap" IsVisible="{Binding IsUnknown}"
                 Text="{l:T 'Die letzte Sicherung wurde mit einer älteren Version erstellt. Welche Einträge sich geändert haben, zeigt Neruna ab der nächsten Sicherung.'}" />
      <TextBlock Classes="subtle" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" Text="{l:T 'Nichts geändert.'}" />
      <ScrollViewer MaxHeight="440" IsVisible="{Binding HasRows}" HorizontalScrollBarVisibility="Disabled">
        <!-- Right margin: the scroll bar lies over the content and would cover "neu"/"geändert" -->
        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,18,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BackupChangeRow">
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                <Grid ColumnDefinitions="140,*,Auto">
                  <TextBlock Text="{Binding Area}" Classes="subtle" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Area}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="2" Text="{Binding What}" Classes="subtle" Margin="12,0,0,0" MinWidth="70" TextAlignment="Right" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </DockPanel>
</UserControl>
