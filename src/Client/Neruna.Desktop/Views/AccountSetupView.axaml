<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:app="using:Neruna.Desktop"
             xmlns:dc="using:Neruna.Contracts.Discovery"
             xmlns:acc="using:Neruna.Core.Accounts"
             x:Class="Neruna.Desktop.Views.AccountSetupView"
             x:DataType="vm:AccountSetupViewModel">

  <UserControl.Styles>
    <!-- The kinds of account: cards to click -->
    <Style Selector="Button.choice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.choice:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="dc:SocketSecurity">
      <TextBlock Text="{Binding Converter={x:Static app:Converters.SecurityLabel}}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <StackPanel>
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Subtitle}" />

    <!-- Step 1: which kind of account (only providers with their own sign-in are listed; all others are "E-Mail-Konto") -->
    <StackPanel IsVisible="{Binding IsChoosing}" Spacing="10" Margin="0,4,0,0">
      <Button Classes="choice" Command="{Binding ChooseImapCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12">
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T 'E-Mail-Konto'}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'IMAP/SMTP, CalDAV und CardDAV – für die meisten Anbieter und eigene Server. Die Einstellungen werden automatisch gesucht.'}" />
        </StackPanel>
      </Button>
      <Button Classes="choice" Command="{Binding ChooseExchangeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12">
        <StackPanel Spacing="2">
          <TextBlock Text="Microsoft Exchange (EWS)" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Exchange-Server der Firma (2013 oder neuer): Mail, Kalender und Kontakte – auch hinter einem Reverse Proxy mit Client-Zertifikat.'}" />
        </StackPanel>
      </Button>
      <Button Classes="choice" Command="{Binding ChooseProtonCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12">
        <StackPanel Spacing="2">
          <TextBlock Text="Proton Mail (Bridge)" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Über die Proton Mail Bridge auf diesem Computer – Neruna findet sie selbst.'}" />
        </StackPanel>
      </Button>
      <Button Classes="choice" Command="{Binding ChooseNextcloudCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12">
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T 'Nextcloud (Kalender und Kontakte)'}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Anmeldung im Browser – auch mit Zwei-Faktor-Anmeldung, ohne App-Passwort abzutippen.'}" />
        </StackPanel>
      </Button>
      <Button Classes="choice" Command="{Binding ChooseMicrosoftCommand}" IsEnabled="{Binding MicrosoftAvailable}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12">
        <StackPanel Spacing="2">
          <TextBlock Text="Microsoft 365 / Outlook.com" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Mail, Kalender und Kontakte mit Anmeldung bei Microsoft.'}" />
          <TextBlock Classes="subtle" FontStyle="Italic" Text="{l:T 'Bald verfügbar'}" IsVisible="{Binding !MicrosoftAvailable}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Nextcloud: Login Flow v2 in the browser gives an app password; calendars and contacts only -->
    <StackPanel IsVisible="{Binding IsNextcloud}" Spacing="2">
      <TextBlock Classes="label" Text="{l:T 'Adresse der Nextcloud'}" />
      <TextBox Text="{Binding NextcloudServer}" PlaceholderText="{l:T 'cloud.example.com'}" />
      <TextBlock Classes="label" Text="{l:T 'Kontobezeichnung (optional)'}" />
      <TextBox Text="{Binding Label}" PlaceholderText="Nextcloud" />
      <TextBlock Classes="label" Text="{l:T 'Ihre E-Mail-Adresse (optional, für Einladungen)'}" />
      <TextBox Text="{Binding Email}" PlaceholderText="name@example.com" />
      <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,10,0,0"
                 Text="{l:T 'Die Anmeldung öffnet sich im Browser. Nextcloud erstellt dabei ein App-Passwort nur für Neruna – Sie sehen und widerrufen es in Nextcloud unter Einstellungen → Sicherheit.'}" />
      <Button Classes="accent" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding SignInNextcloudCommand}"
              Content="{l:T 'Bei Nextcloud anmelden'}" />
    </StackPanel>

    <!-- Microsoft: sign in in the browser; servers and sender come from Microsoft -->
    <StackPanel IsVisible="{Binding IsMicrosoft}" Spacing="2">
      <TextBlock Classes="label" Text="{l:T 'Ihr Name (Absender)'}" IsVisible="{Binding IsEditing}" />
      <TextBox Text="{Binding DisplayName}" IsVisible="{Binding IsEditing}" />
      <TextBlock Classes="label" Text="{l:T 'Kontobezeichnung (optional)'}" />
      <TextBox Text="{Binding Label}" PlaceholderText="{l:T 'z. B. Privat oder Firma – sonst steht die E-Mail-Adresse in der Ordnerliste'}" />
      <TextBlock Classes="label" Text="{l:T 'E-Mail-Adresse'}" IsVisible="{Binding !IsEditing}" />
      <TextBox Text="{Binding Email}" PlaceholderText="name@example.com" IsVisible="{Binding !IsEditing}" />
      <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,10,0,0"
                 Text="{l:T 'Die Anmeldung öffnet sich im Browser. Neruna erhält dabei kein Passwort, nur eine Berechtigung für Mail, Kalender und Kontakte – sie liegt im Schlüsselbund dieses Computers.'}" />
      <Button Classes="accent" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding SignInMicrosoftCommand}"
              Content="{l:T 'Bei Microsoft anmelden'}" />
    </StackPanel>

    <StackPanel IsVisible="{Binding IsMailForm}">

    <!-- Accounts of the organisation: only the label (and a password typed in here) are the user's -->
    <Border IsVisible="{Binding IsCloud}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
      <TextBlock TextWrapping="Wrap" Text="{l:T 'Von Ihrer Organisation verwaltet: Server, Absender und Aliase kommen aus Neruna Cloud. Hier lassen sich die Kontobezeichnung und – falls Sie es selbst eingegeben haben – das Passwort ändern.'}" />
    </Border>
    <TextBlock Classes="label" Text="{l:T 'Ihr Name (Absender)'}" />
    <TextBox Text="{Binding DisplayName}" PlaceholderText="{l:T 'Anna Muster'}" IsEnabled="{Binding !IsCloud}" />

    <TextBlock Classes="label" Text="{l:T 'Kontobezeichnung (optional)'}" />
    <TextBox Text="{Binding Label}" PlaceholderText="{l:T 'z. B. Privat oder Firma – sonst steht die E-Mail-Adresse in der Ordnerliste'}" />

    <TextBlock Classes="label" Text="{l:T 'E-Mail-Adresse'}" />
    <TextBox Text="{Binding Email}" PlaceholderText="{l:T 'anna.muster@example.com'}" IsEnabled="{Binding !IsCloud}" />

    <!-- Aliases: more sender addresses of the same mailbox -->
    <TextBlock Classes="label" Text="{l:T 'Weitere Absenderadressen (Aliase)'}" />
    <ItemsControl ItemsSource="{Binding Aliases}" IsEnabled="{Binding !IsCloud}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AliasRow">
          <Grid ColumnDefinitions="*,8,*,Auto" Margin="0,0,0,4">
            <TextBox Text="{Binding Email}" PlaceholderText="{l:T 'info@example.com'}" />
            <TextBox Grid.Column="2" Text="{Binding DisplayName}" PlaceholderText="{l:T 'Anzeigename, z. B. Example AG'}" />
            <Button Grid.Column="3" Content="✕" Margin="6,0,0,0" ToolTip.Tip="{l:T 'Alias entfernen'}"
                    Command="{Binding $parent[UserControl].((vm:AccountSetupViewModel)DataContext).RemoveAliasCommand}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Classes="command" Content="{l:T '+ Alias hinzufügen'}" Command="{Binding AddAliasCommand}" HorizontalAlignment="Left" Padding="0,2" IsVisible="{Binding !IsCloud}" />

    <TextBlock Classes="label" Text="{Binding PasswordLabel}" IsVisible="{Binding NeedsPassword}" />
    <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="{Binding PasswordHint}" IsVisible="{Binding NeedsPassword}" />

    <!-- Proton Mail Bridge: found on this computer; where user name and password are in the Bridge -->
    <StackPanel IsVisible="{Binding IsProton}" Margin="0,12,0,0" Spacing="6">
      <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="12,8">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{l:T 'So finden Sie Benutzername und Passwort'}" />
          <TextBlock TextWrapping="Wrap" Text="{l:T '1. Proton Mail Bridge installieren (proton.me/mail/bridge), starten und mit Ihrem Proton-Konto anmelden.'}" />
          <TextBlock TextWrapping="Wrap" Text="{l:T '2. In der Bridge Ihr Konto anklicken. Unter «Mailbox details» (je nach Version «Configure email client») stehen Benutzername und Passwort, jeweils mit Knopf zum Kopieren.'}" />
          <TextBlock TextWrapping="Wrap" Text="{l:T '3. Beides hier eintragen. Das Passwort der Bridge ist nicht Ihr Proton-Passwort; die Bridge muss laufen, solange Neruna Mails abruft.'}" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBlock Text="{Binding BridgeStatus}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding BridgeStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Grid.Column="2" Content="{l:T 'Bridge suchen'}" Command="{Binding DetectBridgeCommand}" />
      </Grid>
      <TextBlock Classes="label" Text="{l:T 'Benutzername aus der Bridge (leer = E-Mail-Adresse)'}" />
      <TextBox Text="{Binding Username}" />
      <Grid ColumnDefinitions="80,80,8,170" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Column="1" Classes="label" Text="Port" />
        <TextBlock Grid.Column="3" Classes="label" Text="{l:T 'Verschlüsselung'}" />
        <TextBlock Grid.Row="1" Text="IMAP" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ImapPort}" />
        <ComboBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding ImapSecurity}" />
        <TextBlock Grid.Row="2" Text="SMTP" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SmtpPort}" Margin="0,6,0,0" />
        <ComboBox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding SmtpSecurity}" />
      </Grid>
      <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                 Text="{l:T 'Die Ports stehen in der Bridge ebenfalls unter «Mailbox details». Das Zertifikat der Bridge merkt sich Neruna beim Einrichten.'}" />
    </StackPanel>

    <!-- Exchange: one address for mail, calendar and contacts; sign-in and client certificate for a reverse proxy -->
    <StackPanel IsVisible="{Binding IsExchange}" IsEnabled="{Binding !IsCloud}" Margin="0,12,0,0" Spacing="2">
      <TextBlock Classes="label" Text="{l:T 'Exchange-Server'}" />
      <TextBox Text="{Binding ExchangeServer}" PlaceholderText="{l:T 'mail.example.com oder https://mail.example.com/EWS/Exchange.asmx'}" />
      <TextBlock Classes="label" Text="{l:T 'Benutzer'}" />
      <TextBox Text="{Binding Username}" PlaceholderText="{x:Static vm:AccountSetupViewModel.ExchangeUserHint}" />
      <TextBlock Classes="label" Text="{l:T 'Anmeldung'}" />
      <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:AccountSetupViewModel.AuthenticationChoices}" SelectedItem="{Binding ExchangeAuthentication}" />
      <TextBlock Classes="label" Text="{l:T 'Client-Zertifikat'}" />
      <Grid ColumnDefinitions="*,8,Auto">
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CertificateChoices}" SelectedItem="{Binding SelectedCertificate}" />
        <Button Grid.Column="2" Content="{l:T 'Aus Datei …'}" Command="{Binding ImportCertificateCommand}" ToolTip.Tip="{l:T 'Zertifikat mit privatem Schlüssel (.p12, .pfx) – es wird im Schlüsselbund dieses Computers gespeichert.'}" />
      </Grid>
      <StackPanel IsVisible="{Binding IsCertificatePasswordVisible}" Margin="0,6,0,0" Spacing="4">
        <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Das Zertifikat ist mit einem Passwort geschützt:'}" />
        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
          <TextBox Text="{Binding CertificatePassword}" PasswordChar="●" />
          <Button Grid.Column="2" Classes="accent" Content="{l:T 'Übernehmen'}" Command="{Binding ConfirmCertificateCommand}" />
          <Button Grid.Column="4" Content="{l:T 'Abbrechen'}" Command="{Binding CancelCertificateCommand}" />
        </Grid>
      </StackPanel>
      <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="{l:T 'Nur nötig, wenn ein Reverse Proxy vor Exchange ein Zertifikat verlangt.'}" />
      <StackPanel Spacing="2" Margin="0,10,0,0">
        <CheckBox IsChecked="{Binding AcceptAnyCertificate}" Content="{l:T 'Jedes Server-Zertifikat akzeptieren'}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                   Text="{l:T 'Nur für Testserver mit selbst signiertem Zertifikat: Die Verbindung ist dann verschlüsselt, aber nicht mehr gegen gefälschte Server geschützt.'}" />
      </StackPanel>
    </StackPanel>

    <!-- Server settings, prefilled by discovery -->
    <StackPanel IsEnabled="{Binding !IsCloud}" Margin="0,12,0,0">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="ShowServerSettings" />
          <Binding Path="IsImap" />
        </MultiBinding>
      </StackPanel.IsVisible>
      <TextBlock Text="{Binding DiscoverySource}" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding DiscoverySource, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Grid ColumnDefinitions="80,*,8,80,8,170" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
        <TextBlock Grid.Column="1" Classes="label" Text="{l:T 'Server'}" />
        <TextBlock Grid.Column="3" Classes="label" Text="Port" />
        <TextBlock Grid.Column="5" Classes="label" Text="{l:T 'Verschlüsselung'}" />

        <TextBlock Grid.Row="1" Text="IMAP" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ImapHost}" PlaceholderText="{l:T 'leer = kein E-Mail'}" />
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ImapPort}" />
        <ComboBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding ImapSecurity}" />

        <TextBlock Grid.Row="2" Text="SMTP" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SmtpHost}" Margin="0,6,0,0" />
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SmtpPort}" Margin="0,6,0,0" />
        <ComboBox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding SmtpSecurity}" />

        <TextBlock Grid.Row="3" Text="{l:T 'Benutzer'}" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Username}" Margin="0,6,0,0" />
      </Grid>

      <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" Margin="0,12,0,0">
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="{l:T 'Adresse (Server, /.well-known oder direkte Sammlung)'}" />
        <TextBlock Grid.Row="1" Text="CalDAV" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalDavUrl}" PlaceholderText="{l:T 'z. B. https://mail.example.com/SOGo/dav/ – leer = keine Kalender'}" />
        <TextBlock Grid.Row="2" Text="CardDAV" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CardDavUrl}" Margin="0,6,0,0" PlaceholderText="{l:T 'leer = keine Kontakte'}" />
      </Grid>
      <!-- Test servers with a self-signed certificate; not for accounts from Neruna Cloud -->
      <StackPanel Spacing="2" Margin="0,12,0,0" IsVisible="{Binding !IsCloud}">
        <CheckBox IsChecked="{Binding AcceptAnyCertificate}" Content="{l:T 'Jedes Server-Zertifikat akzeptieren'}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                   Text="{l:T 'Nur für Testserver mit selbst signiertem Zertifikat: Die Verbindung ist dann verschlüsselt, aber nicht mehr gegen gefälschte Server geschützt.'}" />
      </StackPanel>
    </StackPanel>

    </StackPanel>

    <!-- From the provider's configuration: what to switch on first, and its webmail, instructions and support -->
    <StackPanel IsVisible="{Binding IsMailForm}" Margin="0,12,0,0" Spacing="6">
      <Border IsVisible="{Binding EnableHint, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="12,8">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{l:T 'Wichtig: beim Anbieter zuerst einschalten'}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding EnableHint.Text, FallbackValue=''}" />
          <Button Classes="command" Padding="0,2" HorizontalAlignment="Left" Content="{l:T 'Einstellungen beim Anbieter öffnen'}"
                  Command="{Binding OpenLinkCommand}" CommandParameter="{Binding EnableHint}" />
        </StackPanel>
      </Border>
      <StackPanel IsVisible="{Binding HasProviderLinks}" Spacing="2">
        <TextBlock Classes="label" Text="{l:T 'Hilfe vom Anbieter (falls etwas nicht klappt)'}" />
        <ItemsControl ItemsSource="{Binding ProviderLinkItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="acc:LinkItem">
              <Button Classes="command" Padding="0,2" Margin="0,0,16,0" Content="{Binding Text}" ToolTip.Tip="{Binding Url}" Foreground="{DynamicResource AccentTextBrush}"
                      Command="{Binding $parent[UserControl].((vm:AccountSetupViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <TextBlock Classes="error" Text="{Binding Error}" Margin="0,12,0,0" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" Height="4" />
        <TextBlock Text="{Binding BusyText}" Classes="subtle" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
        <Button Content="{l:T 'Zurück'}" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
        <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" />
      </StackPanel>
      <Panel Grid.Column="3" IsVisible="{Binding IsMailForm}">
        <Button Classes="accent" Content="{l:T 'Weiter'}" Command="{Binding DiscoverCommand}" IsVisible="{Binding !ShowServerSettings}" />
        <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding CreateCommand}" IsVisible="{Binding ShowServerSettings}" />
      </Panel>
      <Button Grid.Column="3" Classes="accent" Content="{l:T 'Speichern'}" Command="{Binding SaveMicrosoftCommand}">
        <Button.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsMicrosoft" />
            <Binding Path="IsEditing" />
          </MultiBinding>
        </Button.IsVisible>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
