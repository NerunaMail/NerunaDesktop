<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:app="using:Neruna.Desktop"
             xmlns:dc="using:Neruna.Contracts.Discovery"
             x:Class="Neruna.Desktop.Views.AccountSetupView"
             x:DataType="vm:AccountSetupViewModel">

  <UserControl.Styles>
    <!-- The kinds of account: cards to click -->
    <Style Selector="Button.choice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.choice:pointerover /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="dc:SocketSecurity">
      <TextBlock Text="{Binding Converter={x:Static app:Converters.SecurityLabel}}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <StackPanel>
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Subtitle}" />

    <!-- Step 1: which kind of account (only providers with their own sign-in are listed; all others are "E-Mail-Konto") -->
    <StackPanel IsVisible="{Binding IsChoosing}" Spacing="10" Margin="0,4,0,0">
      <Button Classes="choice" Command="{Binding ChooseImapCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12">
        <StackPanel Spacing="2">
          <TextBlock Text="{l:T 'E-Mail-Konto'}" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'IMAP/SMTP, CalDAV und CardDAV – für die meisten Anbieter und eigene Server. Die Einstellungen werden automatisch gesucht.'}" />
        </StackPanel>
      </Button>
      <Button Classes="choice" Command="{Binding ChooseMicrosoftCommand}" IsEnabled="{Binding MicrosoftAvailable}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12">
        <StackPanel Spacing="2">
          <TextBlock Text="Microsoft 365 / Outlook.com" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{l:T 'Mail, Kalender und Kontakte mit Anmeldung bei Microsoft.'}" />
          <TextBlock Classes="subtle" FontStyle="Italic" Text="{l:T 'Bald verfügbar'}" IsVisible="{Binding !MicrosoftAvailable}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Microsoft: sign in in the browser; servers and sender come from Microsoft -->
    <StackPanel IsVisible="{Binding IsMicrosoft}" Spacing="2">
      <TextBlock Classes="label" Text="{l:T 'Ihr Name (Absender)'}" IsVisible="{Binding IsEditing}" />
      <TextBox Text="{Binding DisplayName}" IsVisible="{Binding IsEditing}" />
      <TextBlock Classes="label" Text="{l:T 'Kontobezeichnung (optional)'}" />
      <TextBox Text="{Binding Label}" PlaceholderText="{l:T 'z. B. Privat oder Firma – sonst steht die E-Mail-Adresse in der Ordnerliste'}" />
      <TextBlock Classes="label" Text="{l:T 'E-Mail-Adresse'}" IsVisible="{Binding !IsEditing}" />
      <TextBox Text="{Binding Email}" PlaceholderText="name@example.com" IsVisible="{Binding !IsEditing}" />
      <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,10,0,0"
                 Text="{l:T 'Die Anmeldung öffnet sich im Browser. Neruna erhält dabei kein Passwort, nur eine Berechtigung für Mail, Kalender und Kontakte – sie liegt im Schlüsselbund dieses Computers.'}" />
      <Button Classes="accent" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding SignInMicrosoftCommand}"
              Content="{l:T 'Bei Microsoft anmelden'}" />
    </StackPanel>

    <StackPanel IsVisible="{Binding IsImap}">

    <!-- Accounts of the organisation: only the label (and a password typed in here) are the user's -->
    <Border IsVisible="{Binding IsCloud}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
      <TextBlock TextWrapping="Wrap" Text="{l:T 'Von Ihrer Organisation verwaltet: Server, Absender und Aliase kommen aus Neruna Cloud. Hier lassen sich die Kontobezeichnung und – falls Sie es selbst eingegeben haben – das Passwort ändern.'}" />
    </Border>
    <TextBlock Classes="label" Text="{l:T 'Ihr Name (Absender)'}" />
    <TextBox Text="{Binding DisplayName}" PlaceholderText="{l:T 'Anna Muster'}" IsEnabled="{Binding !IsCloud}" />

    <TextBlock Classes="label" Text="{l:T 'Kontobezeichnung (optional)'}" />
    <TextBox Text="{Binding Label}" PlaceholderText="{l:T 'z. B. Privat oder Firma – sonst steht die E-Mail-Adresse in der Ordnerliste'}" />

    <TextBlock Classes="label" Text="{l:T 'E-Mail-Adresse'}" />
    <TextBox Text="{Binding Email}" PlaceholderText="{l:T 'anna.muster@example.com'}" IsEnabled="{Binding !IsCloud}" />

    <!-- Aliases: more sender addresses of the same mailbox -->
    <TextBlock Classes="label" Text="{l:T 'Weitere Absenderadressen (Aliase)'}" />
    <ItemsControl ItemsSource="{Binding Aliases}" IsEnabled="{Binding !IsCloud}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AliasRow">
          <Grid ColumnDefinitions="*,8,*,Auto" Margin="0,0,0,4">
            <TextBox Text="{Binding Email}" PlaceholderText="{l:T 'info@example.com'}" />
            <TextBox Grid.Column="2" Text="{Binding DisplayName}" PlaceholderText="{l:T 'Anzeigename, z. B. Example AG'}" />
            <Button Grid.Column="3" Content="✕" Margin="6,0,0,0" ToolTip.Tip="{l:T 'Alias entfernen'}"
                    Command="{Binding $parent[UserControl].((vm:AccountSetupViewModel)DataContext).RemoveAliasCommand}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Classes="command" Content="{l:T '+ Alias hinzufügen'}" Command="{Binding AddAliasCommand}" HorizontalAlignment="Left" Padding="0,2" IsVisible="{Binding !IsCloud}" />

    <TextBlock Classes="label" Text="{l:T 'Passwort'}" />
    <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="{Binding PasswordHint}" />

    <!-- Server settings, prefilled by discovery -->
    <StackPanel IsVisible="{Binding ShowServerSettings}" IsEnabled="{Binding !IsCloud}" Margin="0,12,0,0">
      <TextBlock Text="{Binding DiscoverySource}" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding DiscoverySource, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Grid ColumnDefinitions="80,*,8,80,8,170" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
        <TextBlock Grid.Column="1" Classes="label" Text="{l:T 'Server'}" />
        <TextBlock Grid.Column="3" Classes="label" Text="Port" />
        <TextBlock Grid.Column="5" Classes="label" Text="{l:T 'Verschlüsselung'}" />

        <TextBlock Grid.Row="1" Text="IMAP" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ImapHost}" PlaceholderText="{l:T 'leer = kein E-Mail'}" />
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ImapPort}" />
        <ComboBox Grid.Row="1" Grid.Column="5" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding ImapSecurity}" />

        <TextBlock Grid.Row="2" Text="SMTP" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SmtpHost}" Margin="0,6,0,0" />
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SmtpPort}" Margin="0,6,0,0" />
        <ComboBox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                  ItemsSource="{x:Static vm:AccountSetupViewModel.SecurityOptions}" SelectedItem="{Binding SmtpSecurity}" />

        <TextBlock Grid.Row="3" Text="{l:T 'Benutzer'}" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Username}" Margin="0,6,0,0" />
      </Grid>

      <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" Margin="0,12,0,0">
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="{l:T 'Adresse (Server, /.well-known oder direkte Sammlung)'}" />
        <TextBlock Grid.Row="1" Text="CalDAV" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalDavUrl}" PlaceholderText="{l:T 'z. B. https://mail.example.com/SOGo/dav/ – leer = keine Kalender'}" />
        <TextBlock Grid.Row="2" Text="CardDAV" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CardDavUrl}" Margin="0,6,0,0" PlaceholderText="{l:T 'leer = keine Kontakte'}" />
      </Grid>
    </StackPanel>

    </StackPanel>

    <TextBlock Classes="error" Text="{Binding Error}" Margin="0,12,0,0" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" Height="4" />
        <TextBlock Text="{Binding BusyText}" Classes="subtle" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
        <Button Content="{l:T 'Zurück'}" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
        <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" />
      </StackPanel>
      <Panel Grid.Column="3" IsVisible="{Binding IsImap}">
        <Button Classes="accent" Content="{l:T 'Weiter'}" Command="{Binding DiscoverCommand}" IsVisible="{Binding !ShowServerSettings}" />
        <Button Classes="accent" Content="{Binding SaveText}" Command="{Binding CreateCommand}" IsVisible="{Binding ShowServerSettings}" />
      </Panel>
      <Button Grid.Column="3" Classes="accent" Content="{l:T 'Speichern'}" Command="{Binding SaveMicrosoftCommand}">
        <Button.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsMicrosoft" />
            <Binding Path="IsEditing" />
          </MultiBinding>
        </Button.IsVisible>
      </Button>
    </Grid>
  </StackPanel>
</UserControl>
