<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:app="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.Views.CollectionAppearanceEditor"
             x:DataType="vm:CollectionListItem">

  <!-- Colour, own name and "Aufgaben im Kalender anzeigen" of a calendar or task list: the same menu in the calendar
       and under "Aufgaben" – stored in Neruna, the server keeps its colour and name. -->
  <StackPanel Spacing="8" Width="220">
    <TextBlock Text="{l:T 'Kalenderfarbe'}" FontWeight="SemiBold" FontSize="12" />
    <ItemsControl ItemsSource="{x:Static vm:CalendarViewModel.ColorChoices}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Button Width="20" Height="20" MinWidth="0" Padding="0" Margin="1" CornerRadius="3" BorderThickness="0"
                  Background="{Binding Converter={x:Static app:Converters.ColorBrush}}" Click="OnColorPicked" Tag="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Content="{l:T 'Farbe vom Server'}" FontSize="12" Click="OnColorPicked" Tag="{x:Null}" />

    <TextBlock Text="{l:T 'Anzeigename'}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
    <TextBox Text="{Binding EditName}" KeyDown="OnRenameKey" />
    <TextBlock Text="{Binding ServerNameText}" Classes="subtle" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsRenamed}" />
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Content="{l:T 'Übernehmen'}" FontSize="12" Classes="accent" Click="OnRename" />
      <Button Content="{l:T 'Originalname'}" FontSize="12" Click="OnRename" Tag="reset" IsVisible="{Binding IsRenamed}" />
    </StackPanel>

    <Button Content="{l:T 'Kalender entfernen'}" FontSize="12" IsVisible="{Binding CanRemove}" Click="OnRemove" Margin="0,6,0,0" />

    <StackPanel Spacing="8" IsVisible="{Binding HasTasks}">
      <CheckBox Content="{l:T 'Aufgaben im Kalender anzeigen'}" IsChecked="{Binding ShowTasks}" FontSize="12" Margin="0,6,0,0" />
      <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap" Text="{l:T 'Offene Aufgaben mit Fälligkeitsdatum erscheinen dann auch im Kalender.'}" />
    </StackPanel>
  </StackPanel>
</UserControl>
