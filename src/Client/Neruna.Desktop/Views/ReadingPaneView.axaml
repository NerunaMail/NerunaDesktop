<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:cal="using:Neruna.Core.Calendar"
             xmlns:app="using:Neruna.Desktop"
             xmlns:views="using:Neruna.Desktop.Views"
             xmlns:core="using:Neruna.Core.Mail"
             xmlns:sys="using:System"
             x:Class="Neruna.Desktop.Views.ReadingPaneView"
             x:DataType="vm:ReadingPaneViewModel">
  <!-- A message: header, security, attachments, body. Used in the mail page and in the message window. -->
  <Panel>
    <TextBlock IsVisible="{Binding IsInfo}" Text="{Binding InfoText}" Classes="subtle"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" />
    <Grid IsVisible="{Binding IsMessage}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="24,20,24,0">
        <SelectableTextBlock Text="{Binding Subject}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <!-- "⋮": more about this mail (all its headers) -->
        <Button Grid.Column="1" Classes="command" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top" IsVisible="{Binding HasHeaders}"
                ToolTip.Tip="{l:T 'Weitere Aktionen'}">
          <TextBlock Text="⋮" FontSize="16" FontWeight="Bold" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{l:T 'Drucken …'}" Command="{Binding PrintCommand}" InputGesture="Ctrl+P" IsEnabled="{Binding CanExport}" />
              <MenuItem Header="{l:T 'Speichern unter …'}" Command="{Binding SaveAsCommand}" IsEnabled="{Binding CanExport}" />
              <Separator />
              <MenuItem Header="{l:T 'Kopfzeilen anzeigen'}" Command="{Binding ToggleHeadersCommand}" ToggleType="CheckBox" IsChecked="{Binding IsHeadersOpen, Mode=OneWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="subtle" FontSize="12" Text="{Binding ExportStatus}" TextWrapping="Wrap"
                   IsVisible="{Binding ExportStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="24,16,24,8">
        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" ClipToBounds="True">
          <Panel>
            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSenderPhoto}" />
            <Image Source="{Binding SenderPhoto}" Stretch="UniformToFill" IsVisible="{Binding HasSenderPhoto}" />
          </Panel>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <SelectableTextBlock Text="{Binding From}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            <!-- The sender is in no address book: save as a contact in one click -->
            <Button Classes="command" Padding="5,2" VerticalAlignment="Center" Command="{Binding AddSenderContactCommand}" IsVisible="{Binding CanAddSender}"
                    ToolTip.Tip="{l:T 'Absender als Kontakt speichern'}">
              <PathIcon Data="{StaticResource IconAccountAdd}" Width="15" Height="15" Margin="0" />
            </Button>
          </StackPanel>
          <TextBlock Classes="subtle" FontSize="12" Text="{Binding To, Converter={x:Static l:Fmt.Instance}, ConverterParameter='An: {0}'}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="subtle" FontSize="12" Text="{Binding Cc, Converter={x:Static l:Fmt.Instance}, ConverterParameter='Cc: {0}'}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasCc}" />
          <TextBlock Classes="subtle" FontSize="12" Text="{Binding Date}" />
        </StackPanel>
        <!-- Security check: sender, envelope, display name, links, attachments -->
        <Button Grid.Column="2" Classes="command" VerticalAlignment="Top" Command="{Binding ToggleAnalysisCommand}"
                ToolTip.Tip="{l:T 'Prüft Absender, Links und Anhänge auf typische Merkmale von Phishing'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconShield}" Width="15" Height="15" />
            <TextBlock Text="{l:T 'Sicherheit prüfen'}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Grid.Row="2">
      <!-- Warning above a suspicious mail (Einstellungen → Datenschutz) -->
      <Border IsVisible="{Binding ShowsWarning}" CornerRadius="4" Padding="10,6" Margin="24,0,24,8" BorderThickness="3,0,0,0"
              Classes.bad="{Binding IsDangerous}" Classes.warn="{Binding IsCaution}">
        <Border.Styles>
          <Style Selector="Border.warn"><Setter Property="Background" Value="{DynamicResource WarnBackgroundBrush}" /><Setter Property="BorderBrush" Value="#BC4B09" /></Style>
          <Style Selector="Border.bad"><Setter Property="Background" Value="{DynamicResource BadBackgroundBrush}" /><Setter Property="BorderBrush" Value="#C50F1F" /></Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding AssessmentSummary}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="command" Content="{l:T 'Details'}" FontSize="12" Command="{Binding ToggleAnalysisCommand}" />
        </Grid>
      </Border>

      <!-- Every header as it arrived (⋮ next to the subject) -->
      <Border IsVisible="{Binding IsHeadersOpen}" Margin="24,0,24,10" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{l:T 'Kopfzeilen'}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="command" FontSize="12" Padding="0,2" Margin="0,0,12,0" Content="{l:T 'Kopieren'}" Click="OnCopyHeaders" />
            <Button Grid.Column="2" Content="✕" Command="{Binding ToggleHeadersCommand}" Padding="6,0" Background="Transparent" BorderThickness="0"
                    ToolTip.Tip="{l:T 'Schliessen'}" VerticalAlignment="Center" />
          </Grid>
          <Border Background="{DynamicResource PaneBackgroundBrush}" CornerRadius="4" Padding="8" MaxHeight="360">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding HeadersText}" FontFamily="Consolas,DejaVu Sans Mono,Menlo,monospace" FontSize="11" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>

      <!-- The security check in full -->
      <Border IsVisible="{Binding IsAnalysisOpen}" Margin="24,0,24,10" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <PathIcon Data="{StaticResource IconShield}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{l:T 'Sicherheitsprüfung'}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <!-- The spam note, folded away -->
              <Button Classes="command" Padding="2" Command="{Binding ShowSpamNoteCommand}" IsVisible="{Binding !IsSpamNoteShown}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:T 'Kein Spamfilter: Spam erkennt Ihr Mailserver. Diese Prüfung hilft, Betrug und gefälschte Absender zu erkennen.'}">
                <PathIcon Data="{StaticResource IconInfo}" Width="13" Height="13" />
              </Button>
            </StackPanel>
            <Button Grid.Column="2" Classes="command" Command="{Binding AskAiCheckCommand}" VerticalAlignment="Center" Margin="0,0,4,0"
                    IsVisible="{Binding HasAiCheck}" ToolTip.Tip="{l:T 'Die E-Mail zusätzlich von der verbundenen KI beurteilen lassen'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconAi}" Width="14" Height="14" Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="{l:T 'Mit KI prüfen'}" FontSize="12" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Content="✕" Command="{Binding ToggleAnalysisCommand}" Padding="6,0" Background="Transparent" BorderThickness="0"
                    ToolTip.Tip="{l:T 'Schliessen'}" VerticalAlignment="Center" />
          </Grid>
          <!-- What the check is not: spam is the mail server's job -->
          <Border IsVisible="{Binding IsSpamNoteShown}" CornerRadius="4" Padding="10,6" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                         Text="{l:T 'Das ist kein Spamfilter: Spam erkennt und sortiert Ihr Mailserver aus. Die Prüfung hilft bei Mails, die durchkommen – damit Sie Betrug und gefälschte Absender erkennen.'}" />
              <Button Grid.Column="2" Classes="command" Content="{l:T 'Ausblenden'}" FontSize="12" Command="{Binding HideSpamNoteCommand}" Margin="8,0,0,0"
                      VerticalAlignment="Top" ToolTip.Tip="{l:T 'Der Hinweis bleibt hinter dem «i» neben dem Titel erreichbar.'}" />
            </Grid>
          </Border>
          <Border CornerRadius="4" Padding="10,6" Classes.good="{Binding IsUnremarkable}" Classes.warn="{Binding IsCaution}" Classes.bad="{Binding IsDangerous}">
            <Border.Styles>
              <Style Selector="Border.good"><Setter Property="Background" Value="{DynamicResource GoodBackgroundBrush}" /></Style>
              <Style Selector="Border.warn"><Setter Property="Background" Value="{DynamicResource WarnBackgroundBrush}" /></Style>
              <Style Selector="Border.bad"><Setter Property="Background" Value="{DynamicResource BadBackgroundBrush}" /></Style>
            </Border.Styles>
            <TextBlock Text="{Binding AssessmentSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Border>
          <!-- "Mit KI prüfen": a second opinion, only after the warning what is sent -->

          <Border IsVisible="{Binding IsAiCheckConfirming}" CornerRadius="4" Padding="10,8" Background="{DynamicResource WarnBackgroundBrush}">
            <StackPanel Spacing="8">
              <TextBlock Text="{l:T 'E-Mail an die KI übermitteln?'}" FontWeight="SemiBold" FontSize="12" />
              <TextBlock Text="{Binding AiCheckWarning}" FontSize="12" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{l:T 'Übermitteln und prüfen'}" FontSize="12" Command="{Binding RunAiCheckCommand}" />
                <Button Content="{l:T 'Abbrechen'}" FontSize="12" Command="{Binding CancelAiCheckCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border IsVisible="{Binding AiCheck, Converter={x:Static ObjectConverters.IsNotNull}}" CornerRadius="4" Padding="10,8"
                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <StackPanel Spacing="6" DataContext="{Binding AiCheck}" x:DataType="vm:AiSummaryViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource IconAi}" Width="14" Height="14" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{l:T 'Einschätzung der KI'}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="✕" Command="{Binding CloseCommand}" Padding="6,0" Background="Transparent" BorderThickness="0"
                        ToolTip.Tip="{l:T 'Schliessen'}" VerticalAlignment="Center" />
              </Grid>
              <SelectableTextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Error}" Foreground="#C42B1C" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap" Text="{l:T 'Von KI erstellt – kann Fehler enthalten. Im Zweifel den Absender auf einem anderen Weg fragen.'}" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <Grid.Styles>
              <Style Selector="TextBlock.key"><Setter Property="Margin" Value="0,1,12,1" /><Setter Property="FontSize" Value="12" /></Style>
              <Style Selector="SelectableTextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,1" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
            </Grid.Styles>
            <TextBlock Classes="key subtle" Text="{l:T 'Absender'}" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding SenderFrom}" />
            <TextBlock Grid.Row="1" Classes="key subtle" Text="{l:T 'Umschlag (Return-Path)'}" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SenderEnvelope}" />
            <TextBlock Grid.Row="2" Classes="key subtle" Text="{l:T 'Antwort an'}" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SenderReplyTo}" />
            <TextBlock Grid.Row="3" Classes="key subtle" Text="{l:T 'Prüfung Ihres Servers'}" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SenderAuthentication}" />
            <TextBlock Grid.Row="4" Classes="key subtle" Text="{l:T 'Spam-Bewertung Ihres Servers'}" />
            <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SenderSpam}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FindingItem">
                <Grid ColumnDefinitions="22,*" Margin="0,3">
                  <TextBlock Text="{Binding Mark}" FontWeight="Bold" Classes.good="{Binding IsGood}" Classes.medium="{Binding IsMedium}" Classes.high="{Binding IsHigh}" Classes.subtle="{Binding IsInfo}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock.good"><Setter Property="Foreground" Value="#107C10" /></Style>
                      <Style Selector="TextBlock.medium"><Setter Property="Foreground" Value="#BC4B09" /></Style>
                      <Style Selector="TextBlock.high"><Setter Property="Foreground" Value="#C50F1F" /></Style>
                    </TextBlock.Styles>
                  </TextBlock>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" Classes="subtle" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding HasCheckedLinks}" Spacing="2">
            <TextBlock Text="{l:T 'Auffällige Links'}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding CheckedLinks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckedLinkItem">
                  <Grid ColumnDefinitions="*,Auto,*" Margin="0,2" ToolTip.Tip="{Binding Href}">
                    <TextBlock Text="{Binding Shown}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text=" → " FontSize="12" Classes="subtle" />
                    <TextBlock Grid.Column="2" Text="{Binding Goes}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap"
                     Text="{l:T 'Geprüft auf diesem Gerät, ohne etwas ins Internet zu senden. Eine Hilfe zur Einschätzung, keine Garantie.'}" />

        </StackPanel>
      </Border>

      <!-- S/MIME status -->
      <Border IsVisible="{Binding HasSecurity}" CornerRadius="4" Padding="10,6" Margin="24,0,24,8"
              Classes.good="{Binding IsSecurityGood}" Classes.warn="{Binding IsSecurityWarning}" Classes.bad="{Binding IsSecurityBad}">
        <Border.Styles>
          <Style Selector="Border.good"><Setter Property="Background" Value="{DynamicResource GoodBackgroundBrush}" /></Style>
          <Style Selector="Border.warn"><Setter Property="Background" Value="{DynamicResource WarnBackgroundBrush}" /></Style>
          <Style Selector="Border.bad"><Setter Property="Background" Value="{DynamicResource BadBackgroundBrush}" /></Style>
          <Style Selector="Border.good PathIcon"><Setter Property="Foreground" Value="#107C10" /></Style>
          <Style Selector="Border.warn PathIcon"><Setter Property="Foreground" Value="#BC4B09" /></Style>
          <Style Selector="Border.bad PathIcon"><Setter Property="Foreground" Value="#C50F1F" /></Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Data="{StaticResource IconCertificate}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,8,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding SecurityText}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SecurityDetail}" TextWrapping="Wrap" FontSize="11" Classes="subtle" IsVisible="{Binding HasSecurityDetail}" />
          </StackPanel>
        </Grid>
      </Border>
      </StackPanel>

      <!-- Blocked remote content -->
      <!-- Invitation / answer / cancellation in this mail -->
      <Border Grid.Row="3" IsVisible="{Binding Invitation, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="24,0,24,8"
              BorderBrush="{DynamicResource HeaderBackgroundBrush}" BorderThickness="3,0,0,0" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="4" Padding="12,8">
        <StackPanel Spacing="3" DataContext="{Binding Invitation}" x:DataType="vm:InvitationBannerViewModel">
          <TextBlock Text="{Binding Heading}" Classes="subtle" FontSize="12" />
          <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding When}" />
          <TextBlock Text="{Binding Location}" IsVisible="{Binding HasLocation}" Classes="subtle" />
          <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding Conflicts}" FontSize="12" TextWrapping="Wrap" Foreground="#C42B1C" IsVisible="{Binding Conflicts, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding ShowCalendarChoice}">
            <TextBlock Text="{l:T 'Eintragen in'}" VerticalAlignment="Center" FontSize="12" />
            <ComboBox ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}" MinWidth="200">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="cal:CalendarInfo">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding CanRespond}">
            <Button Classes="accent" Content="{l:T 'Annehmen'}" Command="{Binding AcceptCommand}" />
            <Button Content="{l:T 'Vorläufig'}" Command="{Binding TentativeCommand}" />
            <Button Content="{l:T 'Ablehnen'}" Command="{Binding DeclineCommand}" />
            <ProgressBar IsIndeterminate="True" Width="50" MinWidth="0" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
          </StackPanel>
          <Button Content="{l:T 'Aus dem Kalender entfernen'}" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Margin="0,6,0,0" />
          <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="4">
      <!-- Plain text only (Einstellungen → Datenschutz) -->
      <Border IsVisible="{Binding ShowsPlainTextOnly}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="4" Padding="10,4" Margin="24,0,24,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconShield}" Width="16" Height="16" Margin="0,0,8,0" />
          <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="{l:T 'Diese Mail wird als reiner Text angezeigt – ohne Gestaltung, Bilder und Tracking.'}" />
          <Button Grid.Column="2" Classes="command" Content="{l:T 'Originaldarstellung anzeigen'}" FontSize="12" Command="{Binding ShowOriginalCommand}" />
        </Grid>
      </Border>
      <!-- Blocked remote content -->
      <Border IsVisible="{Binding HasBlockedRemoteContent}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="4" Padding="10,4" Margin="24,0,24,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconImage}" Width="16" Height="16" Margin="0,0,8,0" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding RemoteContentText}" />
            <TextBlock FontSize="11" Classes="subtle" Text="{Binding TrackersText}" IsVisible="{Binding HasTrackers}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" IsVisible="{Binding CanLoadRemoteContent}">
            <Button Classes="command" Content="{l:T 'Bilder laden'}" FontSize="12" Command="{Binding LoadRemoteContentCommand}" />
            <DropDownButton Classes="command" FontSize="12" Content="{l:T 'Immer laden'}" IsVisible="{Binding CanTrustSender}">
              <DropDownButton.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{Binding TrustSenderText}" Command="{Binding TrustSenderCommand}" />
                  <MenuItem Header="{Binding TrustDomainText}" Command="{Binding TrustDomainCommand}" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Pictures loaded, trackers still kept out -->
      <TextBlock IsVisible="{Binding ShowsTrackersOnly}" Margin="24,0,24,8" FontSize="11" Classes="subtle" Text="{Binding TrackersText}" />
      </StackPanel>

      <!-- Attachments -->
      <ItemsControl Grid.Row="5" ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" Margin="24,0,24,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AttachmentViewModel">
            <!-- Images and PDFs: a click shows them in the reading pane (again: back to the message) -->
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6"
                    Classes.previewed="{Binding IsPreviewed}">
              <Border.Styles>
                <Style Selector="Border.previewed">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                  <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
                </Style>
              </Border.Styles>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconAttach}" Width="14" Height="14" />
                <Button Classes="command" Padding="0" Command="{Binding ActivateCommand}"
                        ToolTip.Tip="{Binding ActivateTip}">
                  <TextBlock Text="{Binding FileName}" TextDecorations="Underline" />
                </Button>
                <TextBlock Classes="subtle" FontSize="11" Text="{Binding SizeText}" VerticalAlignment="Center" />
                <Button Classes="command" Padding="4,0" Command="{Binding SaveCommand}" Content="{l:T 'Speichern'}" FontSize="12" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- "Zusammenfassen": first the question, as the whole mail goes to the AI -->
      <Border Grid.Row="6" IsVisible="{Binding IsSummaryConfirming}" Margin="24,0,24,10" CornerRadius="6" Padding="14,10" Background="{DynamicResource WarnBackgroundBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding SummaryConfirmText}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{l:T 'OK'}" FontSize="12" Command="{Binding ConfirmSummaryCommand}" />
            <Button Content="{l:T 'Nicht senden'}" FontSize="12" Command="{Binding DeclineSummaryCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- AI summary ("Zusammenfassen"): written while it arrives -->
      <Border Grid.Row="6" IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="24,0,24,10"
              Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="6" DataContext="{Binding Summary}" x:DataType="vm:AiSummaryViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconAi}" Width="15" Height="15" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{l:T 'Zusammenfassung'}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="✕" Command="{Binding CloseCommand}" Padding="6,0" Background="Transparent" BorderThickness="0"
                    ToolTip.Tip="{l:T 'Schliessen'}" VerticalAlignment="Center" />
          </Grid>
          <ScrollViewer MaxHeight="260">
            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </ScrollViewer>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Error}" Foreground="#C42B1C" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="subtle" FontSize="11" Text="{l:T 'Von KI erstellt – kann Fehler enthalten.'}" />
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="7" Text="{l:T 'Wird geladen …'}" Classes="subtle" Margin="24,8" IsVisible="{Binding IsLoading}" />
      <views:MessageBodyView Grid.Row="7" IsVisible="{Binding ShowsBody}" />

      <!-- Attachment preview in place of the message text -->
      <Grid Grid.Row="7" RowDefinitions="Auto,Auto,*" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="16,6">
          <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding Preview}" x:DataType="vm:AttachmentPreviewViewModel">
            <Button Classes="command" Content="{l:T '← Zur Nachricht'}" Command="{Binding CloseCommand}" />
            <DockPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
              <TextBlock DockPanel.Dock="Right" Text="{Binding PageInfo}" Classes="subtle" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
              <TextBlock Text="{Binding Attachment.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Attachment.FileName}" />
            </DockPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <!-- PDF: a stamp ("Genehmigt", name, date) into the file -->
              <Button Classes="command" IsVisible="{Binding CanStamp}" IsEnabled="{Binding !IsStamping}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{l:T 'Stempeln'}" />
                  <PathIcon Data="{StaticResource IconChevronDown}" Width="9" Height="9" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout ItemsSource="{Binding Stamps}" Placement="BottomEdgeAlignedRight">
                    <MenuFlyout.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="core:PdfStamp">
                        <Setter Property="Header" Value="{Binding Text}" />
                        <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:ReadingPaneViewModel)DataContext).Preview.StartStampCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                      </ControlTheme>
                    </MenuFlyout.ItemContainerTheme>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="command" Content="{l:T 'Text'}" Command="{Binding StartTextCommand}" IsVisible="{Binding CanStamp}" IsEnabled="{Binding !IsStamping}"
                      ToolTip.Tip="{l:T 'Eigenen Text ins PDF schreiben'}" />
              <Button Classes="command" Content="{l:T 'Antworten mit PDF'}" Command="{Binding ReplyWithCommand}" IsVisible="{Binding IsStamped}" />
              <Button Classes="command" Content="{l:T 'Weiterleiten mit PDF'}" Command="{Binding ForwardWithCommand}" IsVisible="{Binding IsStamped}" />
              <Button Classes="command" Content="{l:T 'Öffnen'}" Command="{Binding Attachment.OpenCommand}" IsVisible="{Binding !IsStamped}" />
              <Button Classes="command" Content="{l:T 'Speichern'}" Command="{Binding SaveCommand}" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- Placing a stamp: what to do, then keep it or not -->
        <Border Grid.Row="1" Background="{DynamicResource InfoBackgroundBrush}" Padding="16,8" DataContext="{Binding Preview}" x:DataType="vm:AttachmentPreviewViewModel"
                IsVisible="{Binding IsStamping, FallbackValue=False}">
          <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding StampHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding CancelLabel}" Command="{Binding CancelStampCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
            <Button Grid.Column="2" Classes="accent" Content="{Binding ApplyLabel}" Command="{Binding ApplyStampCommand}" Margin="6,0,0,0" VerticalAlignment="Top" />
            <!-- Own text: what, how large, which colour -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsAddingText}">
              <TextBox Text="{Binding TextContent}" AcceptsReturn="True" TextWrapping="Wrap" Width="360" MinHeight="32" MaxHeight="96"
                       PlaceholderText="{l:T 'Text (mehrere Zeilen mit Enter)'}" />
              <ComboBox ItemsSource="{x:Static vm:AttachmentPreviewViewModel.TextSizes}" SelectedItem="{Binding TextSize}" VerticalAlignment="Top"
                        ToolTip.Tip="{l:T 'Schriftgrösse'}" />
              <ComboBox ItemsSource="{x:Static vm:AttachmentPreviewViewModel.TextColors}" SelectedItem="{Binding TextColor}" VerticalAlignment="Top"
                        ToolTip.Tip="{l:T 'Farbe'}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <Border Width="28" Height="16" CornerRadius="3" Background="{Binding Converter={x:Static l:Converters.ColorBrush}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>
        <!-- An attached mail: as a message of its own (its view is made only when needed – it is this view again) -->
        <ContentControl Grid.Row="2" Content="{Binding Preview.Message}" IsVisible="{Binding Preview.Message, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
        <ScrollViewer Grid.Row="2" Background="{DynamicResource DividerBrush}" DataContext="{Binding Preview}" x:DataType="vm:AttachmentPreviewViewModel"
                      IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}">
          <StackPanel Margin="16" Spacing="12">
            <ItemsControl ItemsSource="{Binding Pages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PreviewPage">
                  <Border Background="White" BoxShadow="0 1 4 0 #33000000" HorizontalAlignment="Center">
                    <!-- While placing: the stamp (or text) itself follows the mouse, at its size on the page -->
                    <Panel PointerMoved="OnPreviewPageMoved" PointerExited="OnPreviewPageExited">
                      <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" PointerPressed="OnPreviewPagePressed" />
                      <Canvas IsHitTestVisible="False" ClipToBounds="True" />
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" HorizontalAlignment="Center"
                       IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Content="{l:T 'Weitere Seiten anzeigen'}" Command="{Binding MorePagesCommand}" IsVisible="{Binding HasMorePages}" HorizontalAlignment="Center" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Panel>
</UserControl>
