<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.CertificatesView"
             x:DataType="vm:CertificatesViewModel">

  <UserControl.Resources>
    <!-- One row of the overview: status · name/e-mail · validity · usage · actions -->
    <DataTemplate x:Key="CertificateRow" x:DataType="vm:CertificateItem">
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,10">
        <Grid ColumnDefinitions="150,*,170,200,Auto">
          <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
          </Border>

          <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,12,0">
            <SelectableTextBlock Text="{Binding Emails}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" IsVisible="{Binding HasSecondaryName}" />
            <TextBlock Text="{Binding Issuer}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding Fingerprint}" Classes="subtle" FontSize="10" FontFamily="Consolas, Cascadia Mono, monospace" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="1">
            <TextBlock Text="{l:T 'Gültig bis'}" Classes="subtle" FontSize="11" />
            <TextBlock Text="{Binding ValidUntil}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RemainingText}" Classes="subtle" FontSize="11" />
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="1">
            <TextBlock Text="{l:T 'Verwendung'}" Classes="subtle" FontSize="11" />
            <TextBlock Text="{Binding UsageText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SourceText}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
            <Button Classes="command" Content="{l:T 'Exportieren'}" FontSize="12" ToolTip.Tip="{l:T 'Öffentliches Zertifikat (.cer) speichern, z. B. um es weiterzugeben'}" IsVisible="{Binding CanExport}"
                    Command="{Binding $parent[UserControl].((vm:CertificatesViewModel)DataContext).ExportCommand}" CommandParameter="{Binding}" />
            <Button Content="{Binding RemoveText}" FontSize="12"
                    Command="{Binding $parent[UserControl].((vm:CertificatesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- Contacts: just whether it is valid, for which address, until when – and delete -->
    <DataTemplate x:Key="ContactRow" x:DataType="vm:CertificateItem">
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,7">
        <Grid ColumnDefinitions="170,*,140,Auto">
          <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <SelectableTextBlock Text="{Binding Emails}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Name}" Classes="subtle" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasSecondaryName}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding ValidUntil}" VerticalAlignment="Center" />
          <Button Grid.Column="3" Content="{Binding RemoveText}" FontSize="12" VerticalAlignment="Center"
                  Command="{Binding $parent[UserControl].((vm:CertificatesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A PGP key: status · name/e-mail/fingerprint · validity · trust and origin · actions -->
    <DataTemplate x:Key="PgpKeyRow" x:DataType="vm:PgpKeyItem">
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,10">
        <Grid ColumnDefinitions="150,*,150,230,320">
          <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
          </Border>

          <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,12,0">
            <SelectableTextBlock Text="{Binding Emails}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" IsVisible="{Binding HasSecondaryName}" />
            <TextBlock Text="{Binding Algorithm}" Classes="subtle" FontSize="11" />
            <SelectableTextBlock Text="{Binding Fingerprint}" Classes="subtle" FontSize="10" FontFamily="Consolas, Cascadia Mono, monospace" TextWrapping="Wrap"
                                 ToolTip.Tip="{l:T 'Fingerabdruck – zum Vergleichen mit dem Inhaber des Schlüssels'}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="1">
            <TextBlock Text="{l:T 'Gültig bis'}" Classes="subtle" FontSize="11" />
            <TextBlock Text="{Binding ValidUntil}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UsageText}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="1" Margin="0,0,12,0">
            <TextBlock Text="{Binding TrustText}" Foreground="{Binding TrustBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SourceText}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right">
            <Button Classes="accent" Content="{Binding ConfirmText}" FontSize="12" IsVisible="{Binding CanConfirm}"
                    ToolTip.Tip="{l:T 'Den Fingerabdruck mit dem Inhaber vergleichen (z. B. am Telefon), dann bestätigen. Bestätigte Schlüssel werden beim Kontakt gespeichert.'}"
                    Command="{Binding $parent[UserControl].((vm:CertificatesViewModel)DataContext).Pgp.ConfirmCommand}" CommandParameter="{Binding}" />
            <Button Classes="command" Content="{l:T 'Exportieren'}" FontSize="12" ToolTip.Tip="{l:T 'Öffentlichen Schlüssel (.asc) speichern, z. B. um ihn weiterzugeben'}"
                    Command="{Binding $parent[UserControl].((vm:CertificatesViewModel)DataContext).Pgp.ExportCommand}" CommandParameter="{Binding}" />
            <Button Classes="command" Content="{l:T 'Sicherung …'}" FontSize="12" IsVisible="{Binding CanBackup}"
                    ToolTip.Tip="{l:T 'Den Schlüssel mit privatem Teil speichern, geschützt durch eine Passphrase'}"
                    Command="{Binding $parent[UserControl].((vm:CertificatesViewModel)DataContext).Pgp.StartBackupCommand}" CommandParameter="{Binding}" />
            <Button Content="{Binding RemoveText}" FontSize="12" IsVisible="{Binding CanRemove}"
                    Command="{Binding $parent[UserControl].((vm:CertificatesViewModel)DataContext).Pgp.RemoveCommand}" CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Spacing="6" Margin="0,4,0,24">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{l:T 'S/MIME-Zertifikate'}" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                     Text="{l:T 'Eigene Zertifikate (.p12/.pfx mit privatem Schlüssel) zum Signieren und Entschlüsseln, öffentliche Zertifikate von Kontakten (.cer/.crt/.pem) zum Verschlüsseln. Zertifikate aus gültig signierten Nachrichten werden automatisch übernommen.'}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="accent" Command="{Binding ImportCommand}" Padding="12,6" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconImport}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Zertifikat importieren …'}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Password prompt for .p12/.pfx -->
      <Border IsVisible="{Binding IsPasswordPromptVisible}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="16,12" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{Binding PendingFileName, Converter={x:Static l:Fmt.Instance}, ConverterParameter='Passwort für «{0}»'}" />
          <Grid ColumnDefinitions="300,Auto,Auto">
            <TextBox Text="{Binding ImportPassword}" PasswordChar="●" PlaceholderText="{l:T 'Passwort des Zertifikats'}" />
            <Button Grid.Column="1" Classes="accent" Content="{l:T 'Importieren'}" Command="{Binding ConfirmImportCommand}" Margin="8,0" IsDefault="True" />
            <Button Grid.Column="2" Content="{l:T 'Abbrechen'}" Command="{Binding CancelImportCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Classes.error="{Binding MessageIsError}" Foreground="{DynamicResource AccentTextBrush}" />

      <StackPanel Spacing="4" Margin="0,8,0,0">
        <CheckBox Content="{l:T 'Automatisch signieren, wenn ein eigenes Zertifikat für den Absender vorhanden ist'}" IsChecked="{Binding AutoSign}" />
        <CheckBox Content="{l:T 'Automatisch verschlüsseln, wenn für alle Empfänger ein Zertifikat bekannt ist'}" IsChecked="{Binding AutoEncrypt}" />
        <!-- Algorithms: current ones only; the defaults are what most mail programs expect -->
        <Grid ColumnDefinitions="Auto,240,24,Auto,240" Margin="0,8,0,0">
          <TextBlock Text="{l:T 'Signatur'}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:CertificatesViewModel.DigestChoices}" SelectedItem="{Binding Digest}"
                    ToolTip.Tip="{l:T 'Hash-Verfahren der Signatur'}" />
          <TextBlock Grid.Column="3" Text="{l:T 'Verschlüsselung'}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Grid.Column="4" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:CertificatesViewModel.CipherChoices}" SelectedItem="{Binding Cipher}"
                    ToolTip.Tip="{l:T 'Verfahren für den Inhalt verschlüsselter Nachrichten'}" />
        </Grid>
      </StackPanel>

      <TabControl Margin="0,12,0,0">
        <TabItem Header="{Binding OwnHeader}">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Classes="subtle" IsVisible="{Binding !HasOwn}" TextWrapping="Wrap"
                       Text="{l:T 'Noch kein eigenes Zertifikat. Importieren Sie Ihre .p12- oder .pfx-Datei, um Nachrichten zu signieren und verschlüsselte Nachrichten zu lesen.'}" />
            <ItemsControl ItemsSource="{Binding Own}" ItemTemplate="{StaticResource CertificateRow}" />
          </StackPanel>
        </TabItem>
        <TabItem Header="{Binding ContactsHeader}">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Classes="subtle" IsVisible="{Binding !HasContacts}" TextWrapping="Wrap"
                       Text="{l:T 'Noch keine. Sie werden aus signierten Nachrichten übernommen oder können importiert werden.'}" />
            <ItemsControl ItemsSource="{Binding Contacts}" ItemTemplate="{StaticResource ContactRow}" />
          </StackPanel>
        </TabItem>
        <TabItem Header="{Binding AuthoritiesHeader}">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="{l:T 'Zusätzlich zu den Stammzertifizierungsstellen des Betriebssystems, z. B. die interne CA Ihrer Firma.'}" />
            <ItemsControl ItemsSource="{Binding Authorities}" ItemTemplate="{StaticResource CertificateRow}" />
          </StackPanel>
        </TabItem>
      </TabControl>

      <!-- PGP: own keys and other people's, next to the certificates -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,28,0,0">
        <StackPanel>
          <TextBlock Text="{l:T 'PGP-Schlüssel'}" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                     Text="{l:T 'Eigene Schlüssel zum Signieren und Entschlüsseln, öffentliche Schlüssel anderer zum Verschlüsseln. Schlüssel, die mit Nachrichten mitkommen, gelten als bekannt, aber erst nach dem Vergleich des Fingerabdrucks als bestätigt.'}" />
        </StackPanel>
        <Button Grid.Column="1" Command="{Binding Pgp.StartGenerateCommand}" Padding="12,6" VerticalAlignment="Top" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Schlüssel erstellen …'}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="accent" Command="{Binding Pgp.ImportCommand}" Padding="12,6" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconImport}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Schlüssel importieren …'}" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Passphrase of an own key being imported -->
      <Border IsVisible="{Binding Pgp.IsPassphrasePromptVisible}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="16,12" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{Binding Pgp.PendingFileName, Converter={x:Static l:Fmt.Instance}, ConverterParameter='Passphrase für «{0}»'}" />
          <Grid ColumnDefinitions="300,Auto,Auto">
            <TextBox Text="{Binding Pgp.ImportPassphrase}" PasswordChar="●" PlaceholderText="{l:T 'Passphrase des privaten Schlüssels'}" />
            <Button Grid.Column="1" Classes="accent" Content="{l:T 'Importieren'}" Command="{Binding Pgp.ConfirmImportCommand}" Margin="8,0" IsDefault="True" />
            <Button Grid.Column="2" Content="{l:T 'Abbrechen'}" Command="{Binding Pgp.CancelImportCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- A new key for one of the own addresses -->
      <Border IsVisible="{Binding Pgp.IsGenerating}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="16,12" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{l:T 'Neuen PGP-Schlüssel erstellen'}" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                     Text="{l:T 'Ed25519 zum Signieren und Curve25519 zum Verschlüsseln, drei Jahre gültig – wie in anderen Mailprogrammen üblich. Der Schlüssel bleibt auf diesem Gerät; seine Passphrase wird im Schlüsselspeicher des Systems abgelegt.'}" />
          <Grid ColumnDefinitions="Auto,360,Auto,Auto">
            <TextBlock Text="{l:T 'Für'}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Pgp.Identities}" SelectedItem="{Binding Pgp.GenerateFor}" />
            <Button Grid.Column="2" Classes="accent" Content="{l:T 'Erstellen'}" Command="{Binding Pgp.GenerateCommand}" Margin="8,0" IsEnabled="{Binding !Pgp.IsWorking}" />
            <Button Grid.Column="3" Content="{l:T 'Abbrechen'}" Command="{Binding Pgp.CancelGenerateCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Backup of an own key: a passphrase chosen by the user protects the file -->
      <Border IsVisible="{Binding Pgp.BackingUp, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="16,12" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{Binding Pgp.BackingUp.Emails, FallbackValue=''}" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left"
                     Text="{l:T 'Die Sicherung enthält den privaten Schlüssel. Sie wird mit dieser Passphrase geschützt – ohne sie lässt sie sich nicht mehr öffnen.'}" />
          <Grid ColumnDefinitions="260,8,260,Auto,Auto">
            <TextBox Text="{Binding Pgp.BackupPassphrase}" PasswordChar="●" PlaceholderText="{l:T 'Passphrase (mindestens 8 Zeichen)'}" />
            <TextBox Grid.Column="2" Text="{Binding Pgp.BackupPassphraseAgain}" PasswordChar="●" PlaceholderText="{l:T 'Passphrase wiederholen'}" />
            <Button Grid.Column="3" Classes="accent" Content="{l:T 'Speichern …'}" Command="{Binding Pgp.BackupCommand}" Margin="8,0" />
            <Button Grid.Column="4" Content="{l:T 'Abbrechen'}" Command="{Binding Pgp.CancelBackupCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Pgp.Message}" TextWrapping="Wrap" Margin="0,4,0,0"
                 IsVisible="{Binding Pgp.Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Classes.error="{Binding Pgp.MessageIsError}" Foreground="{DynamicResource AccentTextBrush}" />

      <StackPanel Spacing="4" Margin="0,8,0,0">
        <CheckBox Content="{l:T 'Eigenen öffentlichen Schlüssel mitsenden (Autocrypt), damit Antworten verschlüsselt werden können'}" IsChecked="{Binding Pgp.SendAutocrypt}" />
        <CheckBox Content="{l:T 'Fehlende Schlüssel von Empfängern online suchen (beim Mailserver des Empfängers und auf keys.openpgp.org)'}" IsChecked="{Binding Pgp.LookUpKeys}"
                  ToolTip.Tip="{l:T 'Nur wenn Sie selbst verschlüsseln wollen – nie beim Lesen einer Nachricht.'}" />
        <!-- Only for someone with both an own certificate and an own PGP key for one address -->
        <Grid ColumnDefinitions="Auto,200" Margin="0,8,0,0" IsVisible="{Binding Pgp.HasBothMethods}">
          <TextBlock Text="{l:T 'Wenn beides möglich ist'}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:PgpKeysViewModel.MethodChoices}" SelectedItem="{Binding Pgp.PreferredMethod}"
                    ToolTip.Tip="{l:T 'Signiert und verschlüsselt wird mit dem Verfahren, für das alle Empfänger Zertifikate oder Schlüssel haben. Haben sie beides, gilt diese Wahl.'}" />
        </Grid>
      </StackPanel>

      <TabControl Margin="0,12,0,0">
        <TabItem Header="{Binding Pgp.OwnHeader}">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Classes="subtle" IsVisible="{Binding !Pgp.HasOwn}" TextWrapping="Wrap"
                       Text="{l:T 'Noch kein eigener PGP-Schlüssel. Importieren Sie Ihren Schlüssel (.asc) oder erstellen Sie einen neuen.'}" />
            <ItemsControl ItemsSource="{Binding Pgp.Own}" ItemTemplate="{StaticResource PgpKeyRow}" />
          </StackPanel>
        </TabItem>
        <TabItem Header="{Binding Pgp.OthersHeader}">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Classes="subtle" IsVisible="{Binding !Pgp.HasOthers}" TextWrapping="Wrap"
                       Text="{l:T 'Noch keine. Sie kommen mit Nachrichten (Autocrypt), werden beim Verschlüsseln online gefunden oder können importiert werden.'}" />
            <ItemsControl ItemsSource="{Binding Pgp.Others}" ItemTemplate="{StaticResource PgpKeyRow}" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
