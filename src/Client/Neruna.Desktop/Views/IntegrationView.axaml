<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:ed="using:Neruna.Desktop.Editor"
             x:Class="Neruna.Desktop.Views.IntegrationView"
             x:DataType="vm:MailOptionsViewModel">
  <!-- Einstellungen → Programm → Integration: Neruna together with the system and other programs -->
  <ScrollViewer>
    <StackPanel Spacing="22" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">
      <TextBlock Text="{l:T 'Integration'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,-12" />
      <StackPanel Spacing="8" IsVisible="{x:Static vm:MailOptionsViewModel.CanBeDefaultApp}">
        <TextBlock Text="{l:T 'Standard-Mailprogramm'}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DefaultAppStatus}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Content="{l:T 'Neruna als Standard-Mailprogramm festlegen'}" Command="{Binding MakeDefaultAppCommand}" IsVisible="{Binding !IsDefaultApp}" />
          <Button Content="{l:T 'Erneut prüfen'}" Command="{Binding CheckDefaultAppCommand}" />
        </StackPanel>
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding DefaultAppHint}"
                   IsVisible="{Binding DefaultAppHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <!-- Simple MAPI (Windows): "Per E-Mail senden" in other programs opens a new mail in Neruna -->
      <StackPanel Spacing="8" IsVisible="{x:Static vm:MailOptionsViewModel.CanOfferMapi}">
        <TextBlock Text="{l:T 'Senden aus anderen Programmen'}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding MapiStatus}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Content="{l:T 'Für andere Programme einrichten …'}" Command="{Binding SetUpMapiCommand}" IsVisible="{Binding CanSetUpMapi}" />
          <Button Content="{l:T 'Entfernen …'}" Command="{Binding RemoveMapiCommand}" IsVisible="{Binding IsMapiOn}" />
        </StackPanel>
        <!-- Some programs (and Windows on a server with Office) ignore a user's own choice: the computer's then -->
        <CheckBox IsChecked="{Binding IsMapiForAll, Mode=OneWay}" Command="{Binding ToggleMapiForAllCommand}" IsVisible="{Binding IsMapiRegistered}"
                  Content="{l:T 'Neruna ist das Mailprogramm für alle Benutzer dieses Computers'}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,-6,0,0" IsVisible="{Binding IsMapiRegistered}"
                   Text="{l:T 'Nötig, wenn ein Programm trotz Einrichten ein anderes Mailprogramm verwendet (z. B. auf einem Terminalserver mit installiertem Office). Benutzer ohne Neruna erhalten weiterhin ihr bisheriges Mailprogramm.'}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                   Text="{l:T 'Über die Windows-Schnittstelle MAPI. Windows fragt einmal nach Administratorrechten: die Schnittstelle gilt für den ganzen Computer, welches Mailprogramm verwendet wird, wählt jeder Benutzer selbst. Neruna versendet nie von sich aus – Sie prüfen das Mail und klicken auf «Senden».'}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding MapiHint}"
                   IsVisible="{Binding MapiHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
