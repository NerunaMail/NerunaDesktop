<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Neruna.Desktop.Views.SplashWindow"
        Title="Neruna"
        Icon="/Assets/app.ico"
        Width="460" Height="280"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Border CornerRadius="10" Background="#0F6CBD" BoxShadow="0 10 40 0 #50000000" ClipToBounds="True">
    <Grid RowDefinitions="*,Auto" Margin="32,28,32,22">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="Neruna" FontSize="40" FontWeight="SemiBold" Foreground="White" />
        <TextBlock Text="Groupware" FontSize="20" Foreground="#E6FFFFFF" Margin="2,-4,0,0" />
        <TextBlock Text="by Patrik" FontSize="13" Foreground="#B3FFFFFF" Margin="2,10,0,0" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
        <!-- Spinner: turned by a composition animation (render thread), so it keeps going while the UI thread works -->
        <Path x:Name="Spinner" Width="22" Height="22" Stretch="None" Stroke="White" StrokeThickness="3" StrokeLineCap="Round"
              Data="M 11,2 A 9,9 0 0 1 20,11" />
        <Ellipse Width="22" Height="22" Stroke="#40FFFFFF" StrokeThickness="3" Margin="0" IsHitTestVisible="False" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Wird gestartet …" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBlock Grid.Column="2" Text="Beta V0.1" Foreground="#B3FFFFFF" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
