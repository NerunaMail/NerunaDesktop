<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Neruna.Desktop.Views.SplashWindow"
        Title="Neruna"
        Icon="/Assets/app.ico"
        Width="480" Height="290"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <!-- Neruna's own look (as on neruna.org): night blue with a soft cyan–blue–violet glow, the logo, a gradient spinner -->
  <Border CornerRadius="14" Background="#070B1A" BoxShadow="0 12 44 0 #66000000" ClipToBounds="True"
          BorderBrush="#26FFFFFF" BorderThickness="1">
    <Panel>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="85%,0%" GradientOrigin="85%,0%" RadiusX="75%" RadiusY="95%">
            <GradientStop Color="#668B5CF6" Offset="0" />
            <GradientStop Color="#002F6BFF" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="0%,100%" GradientOrigin="0%,100%" RadiusX="70%" RadiusY="90%">
            <GradientStop Color="#4D38D5FF" Offset="0" />
            <GradientStop Color="#0038D5FF" Offset="1" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <Grid RowDefinitions="*,Auto" Margin="36,30,32,24">
        <StackPanel VerticalAlignment="Center" Spacing="10">
          <Image Source="/Assets/logo.png" Width="270" HorizontalAlignment="Left" />
          <TextBlock Text="Mail · Kalender · Kontakte" FontSize="15" Foreground="#D9E6F0FF" Margin="4,2,0,0" />
          <TextBlock Text="Groupware by Patrik" FontSize="12" Foreground="#8CA9B8E0" Margin="4,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
          <!-- Spinner: turned by a composition animation (render thread), so it keeps going while the UI thread works -->
          <Ellipse Width="22" Height="22" Stroke="#26FFFFFF" StrokeThickness="3" IsHitTestVisible="False" />
          <Path x:Name="Spinner" Width="22" Height="22" Stretch="None" StrokeThickness="3" StrokeLineCap="Round"
                Data="M 11,2 A 9,9 0 0 1 20,11">
            <Path.Stroke>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#38D5FF" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
              </LinearGradientBrush>
            </Path.Stroke>
          </Path>
          <TextBlock x:Name="StatusText" Grid.Column="1" Text="Wird gestartet …" Foreground="#B3E6F0FF" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
          <Border Grid.Column="2" CornerRadius="999" Padding="10,3" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#4038D5FF" Offset="0" />
                <GradientStop Color="#408B5CF6" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Beta 0.1" Foreground="White" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Grid>
    </Panel>
  </Border>
</Window>
