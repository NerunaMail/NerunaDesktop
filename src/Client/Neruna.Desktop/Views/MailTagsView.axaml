<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:core="using:Neruna.Core.Mail"
             xmlns:app="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.Views.MailTagsView"
             x:DataType="vm:MailTagsViewModel">
  <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,16">
    <TextBlock Classes="subtle" TextWrapping="Wrap"
               Text="{l:T 'Mit Schlagwörtern markieren Sie E-Mails farbig – per Rechtsklick auf eine E-Mail. Sie werden auf dem Mailserver gespeichert und erscheinen so auch auf Ihren anderen Geräten und in anderen Mailprogrammen.'}" />

    <!-- The organisation's (Neruna Cloud): shown, not editable -->
    <StackPanel Spacing="4" IsVisible="{Binding HasCloud}">
      <TextBlock Text="{l:T 'Von Ihrer Organisation'}" FontWeight="SemiBold" Margin="0,6,0,0" />
      <ItemsControl ItemsSource="{Binding FromCloud}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:MailTag">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
              <Border Width="16" Height="16" CornerRadius="3" Background="{Binding Color, Converter={x:Static app:Converters.ColorBrush}}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                      ToolTip.Tip="{l:T 'Von Ihrer Organisation in der Neruna Cloud'}">
                <TextBlock Text="{l:T 'Cloud'}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Text="{l:T 'Eigene Schlagwörter'}" FontWeight="SemiBold" Margin="0,6,0,0" />
    <ItemsControl ItemsSource="{Binding Own}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MailTagRow">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
            <!-- Colour: click to choose -->
            <Button Width="22" Height="22" MinWidth="0" Padding="0" CornerRadius="3" BorderThickness="0" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={x:Static app:Converters.ColorBrush}}" ToolTip.Tip="{l:T 'Farbe ändern'}">
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedTop">
                  <ItemsControl ItemsSource="{x:Static vm:MailTagsViewModel.ColorChoices}" Width="200">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Width="20" Height="20" MinWidth="0" Padding="0" Margin="1" CornerRadius="3" BorderThickness="0"
                                Background="{Binding Converter={x:Static app:Converters.ColorBrush}}" Click="OnColorPicked" Tag="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>
            <TextBox Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" LostFocus="OnNameLeft" KeyDown="OnNameKey" />
            <Button Grid.Column="2" Content="↑" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Nach oben'}"
                    Command="{Binding $parent[UserControl].((vm:MailTagsViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
            <Button Grid.Column="3" Content="{l:T 'Entfernen'}" Margin="6,0,0,0" VerticalAlignment="Center"
                    Command="{Binding $parent[UserControl].((vm:MailTagsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
      <TextBox Text="{Binding NewName}" PlaceholderText="{l:T 'Neues Schlagwort'}" KeyDown="OnNewKey" />
      <Button Grid.Column="1" Classes="accent" Content="{l:T 'Hinzufügen'}" Command="{Binding AddCommand}" Margin="6,0,0,0" />
    </Grid>
    <TextBlock Text="{Binding Error}" Foreground="#C42B1C" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
               Text="{l:T 'Beim Umbenennen bleiben bereits markierte E-Mails markiert – ausser bei Microsoft 365 und Exchange: Dort werden Schlagwörter als Kategorien mit ihrem Namen gespeichert.'}" />
  </StackPanel>
</UserControl>
