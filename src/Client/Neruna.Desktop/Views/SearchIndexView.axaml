<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.SearchIndexView"
             x:DataType="vm:SearchIndexViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">
      <TextBlock Text="{l:T 'Suchindex'}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Classes="subtle" TextWrapping="Wrap"
                 Text="{l:T 'Neruna legt auf diesem Computer einen Index der Nachrichten an, damit die Suche sofort antwortet – auch für Nachrichten, die nicht in der Liste geladen sind. Absender, Empfänger und Betreff kommen von allen Nachrichten in den Index, der Text von denen, die auf diesem Computer liegen (geöffnet, offline verfügbar, Outlook-Datendateien). Der Index braucht Platz; für Konten, die Sie nicht durchsuchen, können Sie ihn ausschalten.'}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" Height="4" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchIndexRow">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" OnContent="{l:T 'Indexieren'}" OffContent="{l:T 'Nicht indexieren'}" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Percent}" Maximum="100" Height="4" Margin="0,6,0,4" IsVisible="{Binding IsEnabled}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Details}" Classes="subtle" FontSize="12" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
