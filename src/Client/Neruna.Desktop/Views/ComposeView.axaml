<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:ed="using:Neruna.Desktop.Editor"
             xmlns:views="using:Neruna.Desktop.Views"
             xmlns:app="using:Neruna.Desktop"
             xmlns:ctl="using:Neruna.Desktop.Controls"
             x:Class="Neruna.Desktop.Views.ComposeView"
             x:DataType="vm:ComposeViewModel">


  <UserControl.Styles>
    <!-- "Wirklich?" after the first click on Verwerfen -->
    <!-- Signieren / Verschlüsseln: like the other buttons; switched on with the accent tint -->
    <Style Selector="ToggleButton.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TodayBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.tool.confirm">
      <Setter Property="Foreground" Value="#C42B1C" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="70,*" Margin="20,14,20,12">

    <!-- Actions -->
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="6">
        <!-- Icons with the text below, as in the reading pane (or icons only: Einstellungen → Design) -->
        <Button Classes="accent" Command="{Binding SendCommand}" HotKey="Ctrl+Enter" ToolTip.Tip="{l:T 'Senden (Ctrl+Enter)'}" VerticalAlignment="Stretch"
                Padding="{Binding Preferences.ToolbarLabels, FallbackValue=True, Converter={x:Static views:ComposeView.SendPadding}}" MinWidth="64">
          <StackPanel>
            <PathIcon Data="{StaticResource IconSend}" Width="18" Height="18" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T 'Senden'}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" IsVisible="{Binding Preferences.ToolbarLabels, FallbackValue=True}" />
          </StackPanel>
        </Button>
        <ctl:ToolButton Icon="{StaticResource IconAttach}" Label="{l:T 'Anhängen'}" Hint="{l:T 'Datei anhängen'}" Command="{Binding AddAttachmentCommand}"
                        ShowLabel="{Binding Preferences.ToolbarLabels, FallbackValue=True}" />
        <ctl:ToolToggleButton Icon="{StaticResource IconCertificate}" Label="{l:T 'Signieren'}" Hint="{Binding SignHint}" IsChecked="{Binding Sign}" IsVisible="{Binding CanSign}" ShowLabel="{Binding Preferences.ToolbarLabels, FallbackValue=True}" />
        <ctl:ToolToggleButton Icon="{StaticResource IconLock}" Label="{l:T 'Verschlüsseln'}" Hint="{Binding EncryptHint}" IsChecked="{Binding Encrypt}" IsVisible="{Binding ShowEncrypt}"
                              ShowLabel="{Binding Preferences.ToolbarLabels, FallbackValue=True}" />
        <!-- Textvorlage: inserted at the caret (also in plain-text mode) -->
        <ctl:ToolButton Icon="{StaticResource IconTextTemplate}" Label="{l:T 'Textvorlage'}" Hint="{l:T 'Textvorlage an der Cursorposition einfügen – oder «kürzel::» tippen'}"
                        IsEnabled="{Binding HasTemplates}" ShowLabel="{Binding Preferences.ToolbarLabels, FallbackValue=True}">
          <ctl:ToolButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding TemplateMenu}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:TextTemplateMenuItem">
                  <Setter Property="Header" Value="{Binding Title}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                  <Setter Property="CommandParameter" Value="{Binding Template}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </ctl:ToolButton.Flyout>
        </ctl:ToolButton>
        <!-- Signatur: swap or remove the signature in the text -->
        <ctl:ToolButton Icon="{StaticResource IconSignature}" Label="{l:T 'Signatur'}" Hint="{l:T 'Signatur einfügen oder wechseln'}" IsVisible="{Binding Formatting.IsRichText}"
                        ShowLabel="{Binding Preferences.ToolbarLabels, FallbackValue=True}">
          <ctl:ToolButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft" ItemsSource="{Binding SignatureMenu}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:SignatureMenuItem">
                  <Setter Property="Header" Value="{Binding Title}" />
                  <Setter Property="Command" Value="{Binding Command}" />
                  <Setter Property="CommandParameter" Value="{Binding Signature}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </ctl:ToolButton.Flyout>
        </ctl:ToolButton>
        <ctl:ToolButton Icon="{StaticResource IconEdit}" Label="{l:T 'Speichern'}" Hint="{l:T 'Als Entwurf speichern (Ctrl+S) – geschieht auch automatisch'}"
                        Command="{Binding SaveDraftCommand}" HotKey="Ctrl+S" ShowLabel="{Binding Preferences.ToolbarLabels, FallbackValue=True}" />
        <ctl:ToolButton Icon="{StaticResource IconDelete}" Label="{Binding DiscardLabel}" Hint="{l:T 'Nachricht verwerfen (auch den gespeicherten Entwurf)'}"
                        Command="{Binding DiscardCommand}" ShowLabel="{Binding Preferences.ToolbarLabels, FallbackValue=True}"
                        Classes.confirm="{Binding ConfirmDiscard}" />
        <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" Height="4" IsVisible="{Binding IsSending}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding DraftStatus}" Classes="subtle" FontSize="12" VerticalAlignment="Center"
                   IsVisible="{Binding DraftStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </WrapPanel>
      <!-- Pop-out, icon-only ("In neuem Fenster öffnen") -->
      <ctl:ToolButton Grid.Column="1" Icon="{StaticResource IconPopOut}" Label="{l:T 'Loslösen'}" Hint="{l:T 'Loslösen – in eigenem Fenster weiterschreiben'}"
                      Command="{Binding PopOutCommand}" IsVisible="{Binding CanPopOut}" Margin="8,0,0,0" VerticalAlignment="Top" ShowLabel="False" />
    </Grid>

    <TextBlock Grid.Row="1" Classes="subtle" Text="{l:T 'Von'}" VerticalAlignment="Center" />
    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FromText}" Margin="0,6" IsVisible="{Binding !HasSenderChoice}" />
    <!-- Aliases: the sender to choose (a reply starts with the address the message was sent to) -->
    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Senders}" SelectedItem="{Binding From}" IsVisible="{Binding HasSenderChoice}"
              Margin="0,3" MinWidth="320" HorizontalAlignment="Left" />

    <!-- An / Cc: the button opens the contact picker; typing suggests contacts and groups from the address books -->
    <Button x:Name="ToButton" Grid.Row="2" Content="{l:T 'An …'}" Click="OnPickRecipients" Padding="10,4" MinWidth="0" Margin="0,3,8,3"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Kontakte auswählen'}" />
    <ctl:RecipientBox x:Name="ToBox" Grid.Row="2" Grid.Column="1" Text="{Binding To}" Directory="{Binding Recipients}" Margin="0,3" PlaceholderText="{l:T 'Name oder Adresse eingeben, mehrere mit Komma trennen'}" />

    <Button x:Name="CcButton" Grid.Row="3" Content="{l:T 'Cc …'}" Click="OnPickRecipients" Padding="10,4" MinWidth="0" Margin="0,3,8,3"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Kontakte auswählen'}" />
    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto">
      <ctl:RecipientBox Text="{Binding Cc}" Directory="{Binding Recipients}" Margin="0,3" />
      <!-- Bcc only when wanted: shown by this button, or when the draft already has some -->
      <ToggleButton Grid.Column="1" Content="{l:T 'Bcc'}" IsChecked="{Binding ShowBcc}" Padding="10,4" Margin="8,3,0,3" VerticalAlignment="Center"
                    ToolTip.Tip="{l:T 'Blindkopie-Feld ein- oder ausblenden'}" />
    </Grid>

    <Button x:Name="BccButton" Grid.Row="4" Content="{l:T 'Bcc …'}" Click="OnPickRecipients" Padding="10,4" MinWidth="0" Margin="0,3,8,3" IsVisible="{Binding ShowBcc}"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Kontakte auswählen'}" />
    <ctl:RecipientBox Grid.Row="4" Grid.Column="1" Text="{Binding Bcc}" Directory="{Binding Recipients}" Margin="0,3" IsVisible="{Binding ShowBcc}"
                      PlaceholderText="{l:T 'Empfänger sehen diese Adressen nicht'}" />

    <TextBox x:Name="SubjectBox" Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Subject}" PlaceholderText="{l:T 'Betreff hinzufügen'}" Margin="0,10,0,6" FontWeight="SemiBold" />

    <ItemsControl Grid.Row="6" Grid.ColumnSpan="2" ItemsSource="{Binding Attachments}" Margin="0,0,0,4">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComposeAttachment">
          <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2,2,2" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconAttach}" Width="12" Height="12" />
              <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
              <Button Classes="command" Padding="4" ToolTip.Tip="{l:T 'Entfernen'}"
                      Command="{Binding $parent[UserControl].((vm:ComposeViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}">
                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" Margin="0" />
              </Button>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Formatting toolbar (hidden without WebView) -->
    <views:FormattingToolbar Grid.Row="7" Grid.ColumnSpan="2" DataContext="{Binding Formatting}" IsVisible="{Binding IsRichText}" />

    <!-- Editor: a page in the app theme (dark: shown inverted; the mail is sent as written) -->
    <Border Grid.Row="8" Grid.ColumnSpan="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="{Binding Formatting.IsRichText, Converter={x:Static app:Converters.EditorCorners}}" Background="{DynamicResource PaperBrush}" ClipToBounds="True">
      <ed:HtmlEditor x:Name="Editor" />
    </Border>

    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Classes="subtle" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" IsVisible="{Binding Formatting.IsPlainTextFallback}"
               Text="{l:T 'Formatierung nicht verfügbar (keine WebView-Laufzeit gefunden) – die Nachricht wird als reiner Text gesendet.'}" />

    <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,8,0,0" />
  </Grid>
</UserControl>
