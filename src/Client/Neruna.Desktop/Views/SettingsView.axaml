<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:views="using:Neruna.Desktop.Views"
             xmlns:app="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!-- Areas on the left, in groups under headings; the chosen one on the right -->
  <Border Classes="pane" Padding="0">
    <Grid ColumnDefinitions="230,*">
      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="10,14">
        <ListBox ItemsSource="{x:Static vm:SettingsViewModel.Navigation}" SelectedItem="{Binding SelectedNav}" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:SettingsNavItem">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="CornerRadius" Value="6" />
              <Setter Property="IsEnabled" Value="{Binding !IsHeading}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsNavItem">
              <Panel Margin="{Binding Indent}">
                <TextBlock Text="{Binding Title}" IsVisible="{Binding IsHeading}" Classes="subtle" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsHeading}">
                  <PathIcon Data="{Binding IconKey, Converter={x:Static app:Converters.Icon}}" Width="16" Height="16" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Panel Grid.Column="1" Margin="24,16,16,0">
        <ContentControl Content="{Binding Accounts}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=0}" />
        <ContentControl Content="{Binding MailOptions}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=1}" />
        <ContentControl Content="{Binding CalendarOptions}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=2}" />
        <ContentControl Content="{Binding Signatures}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=3}" />
        <ContentControl Content="{Binding TextTemplates}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=4}" />
        <ContentControl Content="{Binding Certificates}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=5}" />
        <ContentControl Content="{Binding Appearance}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=6}" />
        <ContentControl Content="{Binding Cloud}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=7}" />
        <ContentControl Content="{Binding Ai}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=8}" />
        <ContentControl Content="{Binding QuickActions}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=11}" />
        <!-- Daten: backup, search index, local database and the folders, one under the other -->
        <ScrollViewer IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=10}">
          <StackPanel Spacing="28" Margin="0,0,0,20">
            <ContentControl Content="{Binding FileBackup}" />
            <ContentControl Content="{Binding SearchIndex}" />
            <ContentControl Content="{Binding LocalData}" />
            <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
              <TextBlock Text="{l:T 'Ordner'}" FontSize="18" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Text="{l:T 'Datenordner'}" Classes="subtle" VerticalAlignment="Center" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Accounts.DataDirectory}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Classes="command" Content="{l:T 'Öffnen'}" Command="{Binding Accounts.OpenDataFolderCommand}" />
                <TextBlock Grid.Row="1" Text="{l:T 'Logs'}" Classes="subtle" VerticalAlignment="Center" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Accounts.LogDirectory}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Row="1" Grid.Column="2" Classes="command" Content="{l:T 'Öffnen'}" Command="{Binding Accounts.OpenLogFolderCommand}" />
              </Grid>
              <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding Accounts.ProtocolLogText}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ContentControl Content="{Binding Privacy}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=14}" />
        <!-- Profile und Workspaces: the profiles (each its own Neruna) on top, the workspaces of this one below -->
        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=15}">
          <ContentControl Content="{Binding Profiles}" MaxHeight="360" />
          <TextBlock Grid.Row="1" Text="{l:T 'Workspaces'}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,10" />
          <ContentControl Grid.Row="2" Content="{Binding Workspaces}" />
        </Grid>
        <views:IntegrationView DataContext="{Binding MailOptions}" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=23}" />
        <ContentControl Content="{Binding News}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=16}" />
        <ContentControl Content="{Binding Meetings}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=18}" />
        <ContentControl Content="{Binding Pdf}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=19}" />
        <ContentControl Content="{Binding ServerRules}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=20}" />
        <ContentControl Content="{Binding MailTags}" IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=21}" />
        <views:ComposeOptionsView DataContext="{Binding MailOptions}" IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=17}" />
        <views:AboutView IsVisible="{Binding SelectedTab, Converter={x:Static app:Converters.IsTab}, ConverterParameter=9}" />
      </Panel>
    </Grid>
  </Border>
</UserControl>
