<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.CloudView"
             x:DataType="vm:CloudViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">
      <TextBlock Text="Neruna Cloud" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Classes="subtle" TextWrapping="Wrap"
                 Text="{l:T 'Verbindet Neruna mit dem Portal deiner Organisation – für zentral verwaltete Signaturen, Textvorlagen, S/MIME-Zertifikate und den Chat. Deine Mails, Termine und Kontakte bleiben auf deinem Mailserver.'}" />

      <!-- Not connected: server, code and PIN from the portal -->
      <StackPanel Spacing="10" IsVisible="{Binding IsNotConnected}" Margin="0,8,0,0">
        <TextBlock Text="{l:T 'Server'}" FontWeight="SemiBold" />
        <TextBox Text="{Binding Server}" PlaceholderText="{l:T 'https://neruna.cloud'}" />
        <TextBlock Text="{l:T 'Verbindungscode'}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBox Text="{Binding Code}" PlaceholderText="{l:T 'XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX'}" FontFamily="Consolas, Cascadia Mono, monospace" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Aus der Mail «Neruna Desktop verbinden» oder direkt von deiner Administratorin bzw. deinem Administrator.'}" />
        <TextBlock Text="PIN" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBox Text="{Binding Pin}" PlaceholderText="{l:T '6 Ziffern'}" Width="160" HorizontalAlignment="Left" PasswordChar="•" MaxLength="12" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{l:T 'Die PIN erhältst du separat – nicht per Mail.'}" />
        <TextBlock Text="{l:T 'Gerätename'}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBox Text="{Binding DeviceName}" MaxLength="120" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding DeviceDescription, Converter={x:Static l:Fmt.Instance}, ConverterParameter='Im Portal sichtbar: {0}'}" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
          <Button Classes="accent" Content="{l:T 'Verbinden'}" Command="{Binding ConnectCommand}" />
          <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- Connected: who, which organisation, what the portal has on file -->
      <Border IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource InfoBackgroundBrush}"
              CornerRadius="6" Padding="16,14" Margin="0,8,0,0">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True" Background="{DynamicResource AccentTextBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
              <Panel>
                <TextBlock Text="{Binding PersonName, Converter={x:Static vm:CloudViewModel.Initials}}" Foreground="White" FontWeight="SemiBold" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding Photo}" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding PersonName}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PersonDetails}" Classes="subtle" />
              <TextBlock Text="{Binding Profile.Member.Email}" />
              <TextBlock Text="{Binding Phones}" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Profile.Organization.Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Address}" />
            <TextBlock Text="{Binding OrganizationContact}" Classes="subtle" />
          </StackPanel>
          <!-- Waiting for approval or a changed organisation key: in the warning colour -->
          <TextBlock Text="{Binding CertificatesText}" TextWrapping="Wrap" IsVisible="{Binding CertificatesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes.attention="{Binding CertificatesNeedAttention}">
            <TextBlock.Styles>
              <Style Selector="TextBlock.attention">
                <Setter Property="Foreground" Value="#CA5010" />
              </Style>
            </TextBlock.Styles>
          </TextBlock>
          <TextBlock Text="{Binding AccountsText}" TextWrapping="Wrap" IsVisible="{Binding AccountsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes.attention="{Binding AccountsNeedAttention}">
            <TextBlock.Styles>
              <Style Selector="TextBlock.attention">
                <Setter Property="Foreground" Value="#CA5010" />
              </Style>
            </TextBlock.Styles>
          </TextBlock>
          <TextBlock Text="{Binding ConnectedText}" Classes="subtle" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{l:T 'Aktualisieren'}" Command="{Binding RefreshCommand}" />
            <Button Content="{l:T 'Trennen'}" Click="OnDisconnect" />
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Sicherung: personal settings into the vault, encrypted on this device; only by hand, with a note -->
      <StackPanel Spacing="10" Margin="0,18,0,0" IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{l:T 'Sicherung'}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Classes="subtle" TextWrapping="Wrap"
                   Text="{l:T 'Sichert deine persönlichen Einstellungen – Konten samt Passwörtern, eigene Signaturen, Textvorlagen und Zertifikate, Einstellungen – verschlüsselt mit deinem Tresor-Passwort. Die Cloud kann sie nicht lesen. Was von deiner Organisation kommt, ist nicht dabei: Es kommt nach dem Verbinden automatisch wieder.'}" />

        <!-- No vault yet -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowVaultSetup}">
          <TextBlock Text="{l:T 'Tresor-Passwort festlegen'}" FontWeight="SemiBold" />
          <TextBox Text="{Binding VaultPassword}" PasswordChar="•" PlaceholderText="{l:T 'Mindestens 10 Zeichen'}" />
          <TextBox Text="{Binding VaultPasswordRepeat}" PasswordChar="•" PlaceholderText="{l:T 'Passwort wiederholen'}" />
          <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                     Text="{l:T 'Ohne dieses Passwort oder den Wiederherstellungscode kann niemand die Sicherungen öffnen – auch deine Organisation und Neruna nicht.'}" />
          <Button Classes="accent" Content="{l:T 'Tresor einrichten'}" Command="{Binding SetUpVaultCommand}" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Recovery code: shown once, alone, until confirmed -->
        <Border IsVisible="{Binding HasRecoveryCode}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="16,14">
          <StackPanel Spacing="10">
            <TextBlock Text="{l:T 'Dein Wiederherstellungscode'}" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Text="{l:T 'Er öffnet den Tresor, wenn du das Passwort vergisst. Er wird nur jetzt angezeigt – schreib ihn auf oder speichere ihn in einem Passwortmanager.'}" />
            <SelectableTextBlock Text="{Binding RecoveryCode}" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="15" TextWrapping="Wrap" />
            <CheckBox Content="{l:T 'Ich habe den Code sicher aufbewahrt'}" IsChecked="{Binding RecoveryStored}" />
            <Button Classes="accent" Content="{l:T 'Weiter'}" Command="{Binding ConfirmRecoveryCodeCommand}" IsEnabled="{Binding RecoveryStored}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- Vault exists, not on this device yet (new computer) -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowVaultUnlock}">
          <TextBlock TextWrapping="Wrap" Text="{Binding BackupCountText, Converter={x:Static l:Fmt.Instance}, ConverterParameter='Es gibt bereits einen Tresor. {0}'}" />
          <TextBlock Text="{l:T 'Tresor entsperren'}" FontWeight="SemiBold" />
          <TextBox Text="{Binding UnlockSecret}" PasswordChar="•" PlaceholderText="{l:T 'Tresor-Passwort oder Wiederherstellungscode'}" />
          <Button Classes="accent" Content="{l:T 'Entsperren'}" Command="{Binding UnlockVaultCommand}" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <TextBlock Classes="subtle" FontSize="12" VerticalAlignment="Center" Text="{l:T 'Passwort und Code verloren?'}" />
            <Button Classes="command" FontSize="12" Command="{Binding ResetVaultCommand}">
              <Panel>
                <TextBlock Text="{l:T 'Tresor löschen und neu beginnen'}" IsVisible="{Binding !ConfirmReset}" TextDecorations="Underline" />
                <TextBlock Text="{l:T 'Wirklich? Alle Sicherungen gehen verloren – nochmals klicken'}" IsVisible="{Binding ConfirmReset}" Foreground="#C50F1F" />
              </Panel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Unlocked: make, restore, delete -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowBackups}">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsWritingNote}">
            <Button Classes="accent" Content="{l:T 'Sicherung erstellen …'}" Command="{Binding NewBackupCommand}" />
          </StackPanel>
          <Border IsVisible="{Binding IsWritingNote}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{l:T 'Neue Sicherung'}" FontWeight="SemiBold" />
              <TextBox Text="{Binding BackupNote}" PlaceholderText="{l:T 'Kommentar, z. B. «Neues Firmenkonto eingerichtet»'}" MaxLength="200" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{l:T 'Sichern'}" Command="{Binding CreateBackupCommand}" IsDefault="True" />
                <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelBackupCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Preview before restoring -->
          <Border IsVisible="{Binding HasRestorePlan}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="16,14">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding RestoreTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding RestoreIsEmpty}" Text="{l:T 'Keine Unterschiede – dieses Gerät entspricht bereits der Sicherung.'}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding RestoreGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RestoreGroup">
                    <StackPanel Spacing="2" Margin="0,0,0,8">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Classes.removal="{Binding IsRemoval}">
                        <TextBlock.Styles>
                          <Style Selector="TextBlock.removal">
                            <Setter Property="Foreground" Value="#C50F1F" />
                          </Style>
                        </TextBlock.Styles>
                      </TextBlock>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                         Text="{l:T 'Mails, Termine und Kontakte bleiben auf den Servern und werden danach neu geladen. Einstellungen und Zertifikate deiner Organisation sind nicht betroffen.'}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{l:T 'Sicherung wiederherstellen'}" Command="{Binding RestoreCommand}" />
                <Button Content="{l:T 'Abbrechen'}" Command="{Binding CancelRestoreCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="subtle" IsVisible="{Binding !Backups.Count}" Text="{l:T 'Noch keine Sicherung.'}" />
          <ItemsControl ItemsSource="{Binding Backups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BackupItem">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="2,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Note}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="subtle" FontSize="12">
                        <Run Text="{Binding When, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Details, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="{l:T 'Wiederherstellen …'}" FontSize="12"
                              Command="{Binding $parent[UserControl].((vm:CloudViewModel)DataContext).PrepareRestoreCommand}" CommandParameter="{Binding}" />
                      <Button Content="{Binding DeleteText}" FontSize="12"
                              Command="{Binding $parent[UserControl].((vm:CloudViewModel)DataContext).DeleteBackupCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="subtle" FontSize="12" Text="{Binding BackupCountText}" IsVisible="{Binding Backups.Count}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding BackupBusy}">
          <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
          <TextBlock Classes="subtle" FontSize="12" Text="{l:T 'Einen Moment …'}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding BackupMessage}" TextWrapping="Wrap" Foreground="#107C10" IsVisible="{Binding BackupMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="error" Text="{Binding BackupError}" TextWrapping="Wrap" IsVisible="{Binding BackupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
