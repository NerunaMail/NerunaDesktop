<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.CloudView"
             x:DataType="vm:CloudViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">
      <TextBlock Text="Neruna Cloud" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Classes="subtle" TextWrapping="Wrap"
                 Text="Verbindet Neruna mit dem Portal deiner Organisation – für zentral verwaltete Signaturen, Textvorlagen, S/MIME-Zertifikate und den Chat. Deine Mails, Termine und Kontakte bleiben auf deinem Mailserver." />

      <!-- Not connected: server, code and PIN from the portal -->
      <StackPanel Spacing="10" IsVisible="{Binding IsNotConnected}" Margin="0,8,0,0">
        <TextBlock Text="Server" FontWeight="SemiBold" />
        <TextBox Text="{Binding Server}" PlaceholderText="https://neruna.cloud" />
        <TextBlock Text="Verbindungscode" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBox Text="{Binding Code}" PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" FontFamily="Consolas, Cascadia Mono, monospace" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="Aus der Mail «Neruna Desktop verbinden» oder direkt von deiner Administratorin bzw. deinem Administrator." />
        <TextBlock Text="PIN" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBox Text="{Binding Pin}" PlaceholderText="6 Ziffern" Width="160" HorizontalAlignment="Left" PasswordChar="•" MaxLength="12" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="Die PIN erhältst du separat – nicht per Mail." />
        <TextBlock Text="Gerätename" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBox Text="{Binding DeviceName}" MaxLength="120" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding DeviceDescription, StringFormat='Im Portal sichtbar: {0}'}" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
          <Button Classes="accent" Content="Verbinden" Command="{Binding ConnectCommand}" />
          <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- Connected: who, which organisation, what the portal has on file -->
      <Border IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{DynamicResource InfoBackgroundBrush}"
              CornerRadius="6" Padding="16,14" Margin="0,8,0,0">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True" Background="{DynamicResource AccentTextBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
              <Panel>
                <TextBlock Text="{Binding PersonName, Converter={x:Static vm:CloudViewModel.Initials}}" Foreground="White" FontWeight="SemiBold" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding Photo}" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding PersonName}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PersonDetails}" Classes="subtle" />
              <TextBlock Text="{Binding Profile.Member.Email}" />
              <TextBlock Text="{Binding Phones}" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Profile.Organization.Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Address}" />
            <TextBlock Text="{Binding OrganizationContact}" Classes="subtle" />
          </StackPanel>
          <!-- Waiting for approval or a changed organisation key: in the warning colour -->
          <TextBlock Text="{Binding CertificatesText}" TextWrapping="Wrap" IsVisible="{Binding CertificatesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Classes.attention="{Binding CertificatesNeedAttention}">
            <TextBlock.Styles>
              <Style Selector="TextBlock.attention">
                <Setter Property="Foreground" Value="#CA5010" />
              </Style>
            </TextBlock.Styles>
          </TextBlock>
          <TextBlock Text="{Binding ConnectedText}" Classes="subtle" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" />
            <Button Content="Trennen" Click="OnDisconnect" />
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
