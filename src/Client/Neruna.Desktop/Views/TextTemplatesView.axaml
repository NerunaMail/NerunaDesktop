<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:core="using:Neruna.Core.Mail"
             x:Class="Neruna.Desktop.Views.TextTemplatesView"
             x:DataType="vm:TextTemplatesViewModel">
  <Grid RowDefinitions="Auto,*" Margin="0,0,0,16">
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Left"
               Text="{l:T 'Textvorlagen fügen Sie beim Schreiben über «Textvorlage» an der Cursorposition ein – z. B. eine Tabelle für eine Anrufnotiz oder eine Standardantwort. Schneller: das Kürzel mit «::» tippen, z. B. «tel::».'}" />

    <Grid Grid.Row="1" ColumnDefinitions="260,16,*" MinHeight="260">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding IsCloudSelected}"
                   Text="{l:T 'Diese Textvorlage pflegt Ihre Organisation im Neruna-Portal. Sie wird hier automatisch aktuell gehalten.'}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Classes="accent" Content="{l:T 'Neu'}" Command="{Binding NewCommand}" />
          <Button Content="{l:T 'Bearbeiten'}" Command="{Binding EditCommand}" />
          <Button Content="{l:T 'Löschen'}" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4">
          <Panel>
            <TextBlock Classes="subtle" Text="{l:T 'Noch keine Textvorlage – «Neu» erstellt eine.'}" TextWrapping="Wrap" Margin="12" IsVisible="{Binding !HasTemplates}" />
            <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}" Background="Transparent" DoubleTapped="OnDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:TextTemplate">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Shortcut, StringFormat='{}{0}::'}" IsVisible="{Binding Shortcut, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Classes="subtle" FontSize="11" FontFamily="Consolas, Cascadia Mono, monospace" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Border Grid.Column="2" IsVisible="{Binding IsFromCloud}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="3"
                            Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip.Tip="{l:T 'Von Ihrer Organisation in der Neruna Cloud'}">
                      <TextBlock Text="{l:T 'Cloud'}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </Border>
      </DockPanel>

      <Border Grid.Column="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource PaperBrush}" ClipToBounds="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{l:T 'Vorschau'}" FontSize="11" Foreground="#707070" Margin="24,10,12,4" />
          <Border x:Name="PreviewHost" Margin="24,0,12,12" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
