<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:app="using:Neruna.Desktop"
             x:Class="Neruna.Desktop.Views.TasksView"
             x:DataType="vm:TasksViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Command bar: new task, quick add, filter, search -->
    <Border Classes="pane" Padding="8,6" Margin="0,0,0,6">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Button Classes="accent" Command="{Binding NewTaskCommand}" Padding="12,6" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Neue Aufgabe'}" />
          </StackPanel>
        </Button>
        <TextBox Grid.Column="1" Text="{Binding NewTitle}" PlaceholderText="{l:T 'Aufgabe eintippen und Enter drücken'}" MaxWidth="520" HorizontalAlignment="Stretch">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding QuickAddCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" MinWidth="230" Margin="12,0,8,0" VerticalAlignment="Center" />
        <TextBox Grid.Column="3" Text="{Binding Search}" PlaceholderText="{l:T 'Suchen'}" Width="200" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="260,6,*">

      <!-- Task lists per account: each one shown or hidden on its own -->
      <Border Classes="pane" Padding="12,10">
        <ScrollViewer>
          <StackPanel Spacing="4">
            <TextBlock Text="{l:T 'Aufgabenlisten'}" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasLists}"
                       Text="{l:T 'Wählen Sie, welche Listen hier erscheinen. Über den Farbpunkt legen Sie fest, ob eine Liste auch im Kalender erscheint.'}" Margin="0,0,0,6" />
            <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasLists}"
                       Text="{l:T 'Noch keine Aufgabenlisten. Aufgaben kommen aus CalDAV-Kalendern, die Aufgaben speichern, und aus Microsoft To Do (Microsoft-Konten, die vor Version 0.1.14 eingerichtet wurden: einmal unter Einstellungen → Konten → Bearbeiten neu anmelden).'}" />
            <ItemsControl ItemsSource="{Binding ListGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskListGroup">
                  <StackPanel Margin="0,6,0,4">
                    <TextBlock Classes="subtle" FontSize="12" Text="{Binding Account}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding Lists}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskListItem">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,1">
                            <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" Padding="0" Margin="0,0,6,0" ToolTip.Tip="{l:T 'Anzeigen'}" />
                            <!-- Colour and "show in the calendar": the same as the calendar's colour menu -->
                            <Button Grid.Column="1" Width="16" Height="16" MinWidth="0" Padding="0" CornerRadius="3" Background="{Binding Brush}"
                                    BorderThickness="0" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{l:T 'Farbe und Name ändern'}">
                              <Button.Flyout>
                                <Flyout Placement="RightEdgeAlignedTop">
                                  <StackPanel Spacing="8" Width="220">
                                    <TextBlock Text="{l:T 'Kalenderfarbe'}" FontWeight="SemiBold" FontSize="12" />
                                    <ItemsControl ItemsSource="{x:Static vm:CalendarViewModel.ColorChoices}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <WrapPanel />
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                          <Button Width="20" Height="20" MinWidth="0" Padding="0" Margin="1" CornerRadius="3" BorderThickness="0"
                                                  Background="{Binding Converter={x:Static app:Converters.ColorBrush}}" Click="OnColorPicked" Tag="{Binding}" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{l:T 'Farbe vom Server'}" FontSize="12" Click="OnColorPicked" Tag="{x:Null}" />

                                    <!-- Own display name: stored in Neruna, the server keeps its name (same as in the calendar) -->
                                    <TextBlock Text="{l:T 'Anzeigename'}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                                    <TextBox Text="{Binding EditName}" KeyDown="OnRenameKey" />
                                    <TextBlock Text="{Binding ServerNameText}" Classes="subtle" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsRenamed}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <Button Content="{l:T 'Übernehmen'}" FontSize="12" Classes="accent" Click="OnRename" />
                                      <Button Content="{l:T 'Originalname'}" FontSize="12" Click="OnRename" Tag="reset" IsVisible="{Binding IsRenamed}" />
                                    </StackPanel>

                                    <CheckBox Content="{l:T 'Aufgaben im Kalender anzeigen'}" IsChecked="{Binding InCalendar}" FontSize="12" Margin="0,6,0,0" />
                                    <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap"
                                               Text="{l:T 'Offene Aufgaben mit Fälligkeitsdatum erscheinen dann auch im Kalender.'}" />
                                  </StackPanel>
                                </Flyout>
                              </Button.Flyout>
                            </Button>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="subtle" FontSize="11" Text="{Binding Kind}" IsVisible="{Binding Kind, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Classes="subtle" FontSize="11" Text="{l:T 'im Kalender'}" IsVisible="{Binding InCalendar}" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Classes="subtle" FontSize="12" Text="{Binding OpenCount}" VerticalAlignment="Center" Margin="6,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- The tasks, grouped by due date -->
      <Border Grid.Column="2" Classes="pane" Padding="16,10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="subtle" Text="{Binding Summary}" Margin="0,0,0,6" />
          <TextBlock Grid.Row="1" Classes="subtle" IsVisible="{Binding IsEmpty}" Text="{l:T 'Keine Aufgaben für diese Auswahl.'}" />
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskGroup">
                  <StackPanel Margin="0,8,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Classes.error="{Binding IsWarning}" />
                      <TextBlock Classes="subtle" Text="{Binding CountText}" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskRow">
                          <Border Classes="taskrow" Padding="4,5" Background="Transparent">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                              <CheckBox IsChecked="{Binding IsCompleted}" MinWidth="0" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ToolTip.Tip="{l:T 'Erledigt'}" />
                              <Button Grid.Column="1" Classes="command" Command="{Binding EditCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="2,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="!" Foreground="#C42B1C" FontWeight="Bold" IsVisible="{Binding IsHigh}" ToolTip.Tip="{l:T 'Hohe Priorität'}" />
                                  <TextBlock Text="{Binding Title}" TextDecorations="{Binding Decorations}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="subtle" Text="✎" FontSize="11" IsVisible="{Binding HasNotes}" ToolTip.Tip="{l:T 'Mit Notiz'}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                              <TextBlock Grid.Column="2" Text="{Binding DueText}" Classes="subtle" Classes.error="{Binding IsOverdue}" FontSize="12" VerticalAlignment="Center" Margin="12,0" />
                              <Border Grid.Column="3" Width="8" Height="8" CornerRadius="4" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                              <TextBlock Grid.Column="4" Classes="subtle" FontSize="12" Text="{Binding ListName}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
