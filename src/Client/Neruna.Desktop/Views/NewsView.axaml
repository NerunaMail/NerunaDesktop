<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:news="using:Neruna.Core.News"
             x:Class="Neruna.Desktop.Views.NewsView"
             x:DataType="vm:NewsViewModel">
  <!-- The devblog of neruna.org: newest post open, the others as teasers -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,16,24">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{l:T 'News'}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,0"
                     Text="{l:T 'Aus dem Devblog auf neruna.org: was neu ist, was schneller und besser geworden ist.'}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="{l:T 'Aktualisieren'}" Command="{Binding RefreshCommand}" />
          <HyperlinkButton Content="{l:T 'Devblog öffnen'}" NavigateUri="{x:Static vm:NewsViewModel.BlogUri}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="subtle" Text="{l:T 'Noch keine Beiträge.'}" IsVisible="{Binding IsEmpty}" />

      <ItemsControl ItemsSource="{Binding Posts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NewsItem">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding DateText}" Classes="subtle" FontSize="12" />
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontStyle="Italic" />
                <ItemsControl ItemsSource="{Binding Blocks}" IsVisible="{Binding IsExpanded}" Margin="0,4,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="news:NewsBlock">
                      <Panel>
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="21"
                                             IsVisible="{Binding Kind, Converter={x:Static l:Converters.IsNewsParagraph}}" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,6"
                                   IsVisible="{Binding Kind, Converter={x:Static l:Converters.IsNewsHeading}}" />
                        <Grid ColumnDefinitions="18,*" Margin="0,0,0,6" IsVisible="{Binding Kind, Converter={x:Static l:Converters.IsNewsItem}}">
                          <TextBlock Text="•" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21" />
                        </Grid>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Button Classes="command" Padding="0,2" Command="{Binding ToggleCommand}">
                    <Panel>
                      <TextBlock Text="{l:T 'Ganzen Beitrag lesen'}" IsVisible="{Binding !IsExpanded}" />
                      <TextBlock Text="{l:T 'Weniger anzeigen'}" IsVisible="{Binding IsExpanded}" />
                    </Panel>
                  </Button>
                  <HyperlinkButton Content="{l:T 'Mit Bildern im Browser'}" NavigateUri="{Binding Url}" Padding="0" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
