<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neruna.Desktop.ViewModels"
        xmlns:ed="using:Neruna.Desktop.Editor"
        xmlns:views="using:Neruna.Desktop.Views"
        xmlns:app="using:Neruna.Desktop"
        x:Class="Neruna.Desktop.Views.SignatureEditorWindow"
        x:DataType="vm:SignatureEditorViewModel"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="860" Height="560" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PaneBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20,16,20,16">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

    <Grid Grid.Row="1" ColumnDefinitions="70,*" Margin="0,0,0,10">
      <TextBlock Classes="subtle" Text="Name" VerticalAlignment="Center" />
      <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name}" PlaceholderText="z. B. Standard, Kurz, Englisch" />
    </Grid>

    <views:FormattingToolbar Grid.Row="2" DataContext="{Binding Formatting}" IsVisible="{Binding IsRichText}" />
    <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource PaperBrush}" ClipToBounds="True"
            CornerRadius="{Binding Formatting.IsRichText, Converter={x:Static app:Converters.EditorCorners}}">
      <ed:HtmlEditor x:Name="Editor" />
    </Border>

    <TextBlock Grid.Row="4" Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,8,0,0" TextWrapping="Wrap" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Abbrechen" Command="{Binding CancelCommand}" IsCancel="True" />
      <Button Classes="accent" Content="Speichern" Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</Window>
