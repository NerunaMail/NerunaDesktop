<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:ed="using:Neruna.Desktop.Editor"
             x:Class="Neruna.Desktop.Views.MailOptionsView"
             x:DataType="vm:MailOptionsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="22" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">

      <StackPanel Spacing="8" IsVisible="{x:Static vm:MailOptionsViewModel.CanBeDefaultApp}">
        <TextBlock Text="{l:T 'Standard-Mailprogramm'}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DefaultAppStatus}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Content="{l:T 'Neruna als Standard-Mailprogramm festlegen'}" Command="{Binding MakeDefaultAppCommand}" IsVisible="{Binding !IsDefaultApp}" />
          <Button Content="{l:T 'Erneut prüfen'}" Command="{Binding CheckDefaultAppCommand}" />
        </StackPanel>
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding DefaultAppHint}"
                   IsVisible="{Binding DefaultAppHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="{l:T 'Neue E-Mails'}" FontSize="16" FontWeight="SemiBold" />
        <CheckBox IsChecked="{Binding Push}" Content="{l:T 'Neue E-Mails sofort abrufen'}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,-6,0,0"
                   Text="{l:T 'Der Server meldet neue Nachrichten im Posteingang sofort (IMAP IDLE). Server ohne diese Funktion werden alle 2 Minuten abgefragt; alle anderen Ordner alle 5 Minuten.'}" />
        <CheckBox IsChecked="{Binding Notifications}" Content="{l:T 'Desktop-Benachrichtigung bei neuen E-Mails'}" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="28,-6,0,0"
                   Text="{l:T 'Unten rechts mit Absender und Betreff – ausser du schaust in Neruna gerade genau diesen Posteingang an. Ein Klick öffnet die Nachricht.'}" />
        <Button Content="{l:T 'Test-Benachrichtigung anzeigen'}" Command="{Binding TestNotificationCommand}" Margin="28,0,0,0" />
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="{l:T 'Lesebereich'}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Classes="subtle" Text="{l:T 'Nachricht als gelesen markieren'}" />
        <ItemsControl ItemsSource="{Binding MarkAsReadOptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MarkAsReadOption">
              <RadioButton GroupName="MarkAsRead" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                   Text="{l:T 'Beim Antworten oder Weiterleiten wird eine Nachricht immer als gelesen markiert, ausser bei «Nie automatisch». Manuell: Ctrl+Q bzw. «Gelesen/Ungelesen».'}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
