<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:views="using:Neruna.Desktop.Views"
             xmlns:acc="using:Neruna.Core.Accounts"
             x:Class="Neruna.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

  <ScrollViewer>
      <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Text="{l:T 'Konten'}" FontSize="22" FontWeight="SemiBold" />
          <Button Grid.Column="1" Classes="command" Command="{Binding SubscribeCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <PathIcon Data="{StaticResource IconRss}" />
              <TextBlock Text="{l:T 'Internet-Kalender abonnieren'}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="accent" Command="{Binding AddAccountCommand}" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Konto hinzufügen'}" />
            </StackPanel>
          </Button>
        </Grid>

        <TextBlock Classes="subtle" Text="{l:T 'Noch keine Konten eingerichtet.'}" IsVisible="{Binding !HasAccounts}" Margin="0,12" />

        <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountItem">
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Sender}" Classes="subtle" />
                    <TextBlock Text="{l:T 'Von Ihrer Organisation verwaltet'}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsFromCloud}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                    <!-- Order in the folder tree and everywhere else -->
                    <Button Classes="command" Padding="6" ToolTip.Tip="{l:T 'Nach oben'}" IsEnabled="{Binding CanMoveUp}"
                            Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource IconChevronUp}" Width="12" Height="12" Margin="0" />
                    </Button>
                    <Button Classes="command" Padding="6" ToolTip.Tip="{l:T 'Nach unten'}" IsEnabled="{Binding CanMoveDown}"
                            Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource IconChevronDown}" Width="12" Height="12" Margin="0" />
                    </Button>
                    <Button Content="{Binding AutoReplyText}" Classes.accent="{Binding HasAutoReply}" Margin="4,0,0,0" IsVisible="{Binding HasMail}" ToolTip.Tip="{l:T 'Abwesenheitsnotiz'}"
                            Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).AutoReplyCommand}" CommandParameter="{Binding}" />
                    <Button Content="{l:T 'Bearbeiten'}"
                            Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).EditCommand}" CommandParameter="{Binding}" />
                    <Button Content="{Binding RemoveText}" IsVisible="{Binding !IsFromCloud}"
                            Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                  <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Connections}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ConnectionLine">
                        <Grid ColumnDefinitions="90,80,*" Margin="0,2">
                          <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding Provider}" Classes="subtle" />
                          <SelectableTextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Konto aufs Handy: QR code + PIN for the Neruna app (without Neruna Cloud; with it the backup brings the accounts) -->
        <StackPanel Spacing="10" Margin="0,18,0,0" IsVisible="{Binding CanTransfer}">
          <TextBlock Text="{l:T 'Konto aufs Handy übertragen'}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Classes="subtle" TextWrapping="Wrap"
                     Text="{l:T 'Ein eigenes Konto samt Passwort per QR-Code in die Neruna-App übernehmen, ohne es dort neu einzutippen. Der QR-Code ist mit der PIN daneben verschlüsselt.'}" />
          <Button Content="{l:T 'Konto aufs Handy übertragen'}" Command="{Binding StartTransferCommand}" HorizontalAlignment="Left">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsTransferring" />
                <Binding Path="!Login.IsAsking" />
              </MultiBinding>
            </Button.IsVisible>
          </Button>
          <views:LoginGateView DataContext="{Binding Login}" />
          <Border IsVisible="{Binding IsTransferring}" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="6" Padding="16,14" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="Auto,*">
              <Border Background="White" Padding="8" CornerRadius="4" VerticalAlignment="Top">
                <Image Source="{Binding TransferQrCode}" Width="240" Height="240" RenderOptions.BitmapInterpolationMode="None" />
              </Border>
              <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="8" MaxWidth="320">
                <ComboBox ItemsSource="{Binding TransferAccounts}" SelectedItem="{Binding TransferAccount}" MinWidth="240">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="acc:Account">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{l:T 'PIN'}" Classes="subtle" />
                <SelectableTextBlock Text="{Binding TransferPin}" FontSize="32" FontWeight="SemiBold" FontFamily="Consolas, Cascadia Mono, monospace" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="{l:T 'In der Neruna-App: Einstellungen → Konten → «Konto vom Computer übernehmen», QR-Code scannen und die PIN eingeben. Die PIN nicht zusammen mit dem QR-Code fotografieren oder weitergeben.'}" />
                <Button Content="{l:T 'Fertig'}" Command="{Binding CloseTransferCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <TextBlock Text="{l:T 'Diagnose'}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
        <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
          <TextBlock Text="{l:T 'Datenordner'}" Classes="subtle" VerticalAlignment="Center" />
          <SelectableTextBlock Grid.Column="1" Text="{Binding DataDirectory}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="command" Content="{l:T 'Öffnen'}" Command="{Binding OpenDataFolderCommand}" />
          <TextBlock Grid.Row="1" Text="{l:T 'Logs'}" Classes="subtle" VerticalAlignment="Center" />
          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogDirectory}" VerticalAlignment="Center" />
          <Button Grid.Row="1" Grid.Column="2" Classes="command" Content="{l:T 'Öffnen'}" Command="{Binding OpenLogFolderCommand}" />
        </Grid>
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding ProtocolLogText}" />
      </StackPanel>
  </ScrollViewer>
</UserControl>
