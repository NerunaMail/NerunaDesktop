<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:acc="using:Neruna.Core.Accounts"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:app="using:Neruna.Desktop"
             xmlns:views="using:Neruna.Desktop.Views"
             x:Class="Neruna.Desktop.Views.AccountsView"
             x:Name="Root"
             x:DataType="vm:AccountsViewModel">
  <!-- Two uses: Einstellungen → Konten (the accounts), and Kalender → Zusatzkalender (Extras: birthdays, holidays,
       subscribed calendars) – the same cards, each list on its own page. -->

  <ScrollViewer>
    <!-- As wide as there is room, at most 820 px, on the left -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="820" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !#Root.Extras}">
          <TextBlock Text="{l:T 'Konten'}" FontSize="22" FontWeight="SemiBold" />
          <!-- One button: an account, or a calendar subscribed by address -->
          <Button Grid.Column="1" Classes="accent" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Hinzufügen'}" />
              <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{l:T 'Konto hinzufügen'}" Command="{Binding AddAccountCommand}" />
                <MenuItem Header="{l:T 'Outlook-Datendatei (.pst) einbinden …'}" Command="{Binding AddPstCommand}" />
                <Separator />
                <!-- Birthdays, holidays and subscribed calendars live under Kalender now -->
                <MenuItem Header="{l:T 'Geburtstage, Feiertage, Internet-Kalender …'}" Command="{Binding ShowExtrasCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding #Root.Extras}">
          <StackPanel Spacing="4">
            <TextBlock Text="{l:T 'Zusatzkalender'}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                       Text="{l:T 'Geburtstage aus den Kontakten, Feiertage und abonnierte Internet-Kalender. Sie gehören zu keinem Konto und werden nur gelesen.'}" />
          </StackPanel>
          <Button Grid.Column="1" Padding="12,6" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Hinzufügen'}" />
              <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{l:T 'Geburtstage oder Feiertage …'}" Command="{Binding AddSpecialCommand}" />
                <MenuItem Header="{l:T 'Internet-Kalender abonnieren'}" Command="{Binding SubscribeCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <TextBlock Classes="subtle" Text="{l:T 'Noch keine Konten eingerichtet.'}" Margin="0,12">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!HasAccounts" />
              <Binding Path="!#Root.Extras" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>
        <TextBlock Classes="subtle" Text="{l:T 'Keine Zusatzkalender.'}" Margin="0,8">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!HasExtraCalendars" />
              <Binding Path="#Root.Extras" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>

        <ItemsControl x:Name="Cards" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountItem">
              <!-- Compact: who and which services; servers, offline and the rest under "Bearbeiten" and "⋯" -->
              <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,8"
                      Classes.signin="{Binding ShowSignIn}">
                <Border.Styles>
                  <Style Selector="Border.signin">
                    <Setter Property="BorderBrush" Value="#C42B1C" />
                    <Setter Property="BorderThickness" Value="2" />
                  </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                  <!-- The account's color in the folder list: click to choose; without one an empty, dashed swatch with a
                       palette invites to pick one (mail accounts only) -->
                  <Button Grid.RowSpan="1" Padding="0" Margin="-6,0,12,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                          IsVisible="{Binding HasMail}" ToolTip.Tip="{l:T 'Farbe in der Ordnerliste wählen'}">
                    <Panel Width="26" Height="26">
                      <Border CornerRadius="13" Background="{Binding ColorStrip}" IsVisible="{Binding HasColor}" />
                      <Panel IsVisible="{Binding !HasColor}">
                        <Ellipse Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1" StrokeDashArray="3,2" />
                        <PathIcon Data="{StaticResource IconPalette}" Width="13" Height="13" Foreground="{DynamicResource SubtleTextBrush}" />
                      </Panel>
                    </Panel>
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="8" Width="196">
                          <TextBlock Text="{l:T 'Farbe in der Ordnerliste'}" FontWeight="SemiBold" />
                          <ItemsControl ItemsSource="{Binding ColorChoices}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AccountColorChoice">
                                <Panel>
                                  <Button Width="30" Height="30" Margin="0,0,6,6" Padding="0" CornerRadius="15" Background="{Binding Swatch}"
                                          BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="{Binding IsChecked, Converter={x:Static app:Converters.ThicknessIf}}"
                                          IsVisible="{Binding HasColor}" Click="OnColorPicked" />
                                  <Button Margin="0,0,6,6" Content="{Binding Label}" IsVisible="{Binding !HasColor}" Click="OnColorPicked" />
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Sender}" Classes="subtle" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,4,0,0">
                      <TextBlock Text="{Binding Services}" FontSize="12" Classes="subtle" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <!-- How far back mail is complete on this computer: chosen right here -->
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasServerMail}" Margin="0,0,10,0"
                                  ToolTip.Tip="{l:T 'Wie weit zurück die Mails samt Anhängen auf diesem Computer liegen'}">
                        <TextBlock Text="{l:T 'Auf diesem Computer behalten:'}" FontSize="12" Classes="subtle" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding OfflineChoices}" SelectedItem="{Binding SelectedOffline}" FontSize="12" Padding="6,2" MinHeight="0">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OfflineChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <TextBlock Text="{Binding ManagedBy}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsFromCloud}" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <TextBlock Text="{l:T 'Abwesenheit aktiv'}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding HasAutoReply}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <!-- The sign-in expired or the password is refused: said here, fixed with one click -->
                    <Border Background="#FDE7E9" CornerRadius="4" Padding="10,8" Margin="0,8,0,4" IsVisible="{Binding ShowSignIn}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="!" Foreground="#C42B1C" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="2,0,10,0" IsVisible="{Binding CanSignIn}" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding CanSignIn}">
                          <TextBlock Text="{Binding SignInHint}" Foreground="#8A1C12" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding SignInError}" Foreground="#8A1C12" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasSignInError}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="accent" Content="{Binding SignInText}" Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanSignIn}"
                                Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).EditCommand}" CommandParameter="{Binding}" />
                        <!-- Signed in again: until the sync shows whether it worked -->
                        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsSigningIn}">
                          <ProgressBar IsIndeterminate="True" Width="60" MinWidth="0" Height="4" VerticalAlignment="Center" />
                          <TextBlock Text="{l:T 'Wird angemeldet …'}" Foreground="#8A1C12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <!-- Webmail, instructions and support of the provider -->
                    <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}" Margin="0,2,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="acc:LinkItem">
                          <Button Classes="command" Padding="0,1" Margin="0,0,14,0" FontSize="12" Content="{Binding Text}" ToolTip.Tip="{Binding Url}" Foreground="{DynamicResource AccentTextBrush}"
                                  Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).OpenLinkCommand}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <!-- In sight: Bearbeiten; ordering and removing under "⋯" -->
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="{l:T 'Bearbeiten'}"
                            Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).EditCommand}" CommandParameter="{Binding}" />
                    <Button Padding="8,6" ToolTip.Tip="{l:T 'Weitere Aktionen'}" AutomationProperties.Name="{l:T 'Weitere Aktionen'}">
                      <TextBlock Text="⋯" FontWeight="Bold" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="{Binding AutoReplyText}" IsVisible="{Binding HasServerMail}"
                                    Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).AutoReplyCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="{l:T 'Serverregeln …'}" IsVisible="{Binding HasServerMail}"
                                    Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).ServerRulesCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="{l:T 'Aufs Handy übertragen'}" IsVisible="{Binding CanTransfer}"
                                    Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).TransferCommand}" CommandParameter="{Binding}" />
                          <Separator IsVisible="{Binding HasServerMail}" />
                          <MenuItem Header="{l:T 'Nach oben'}" IsEnabled="{Binding CanMoveUp}"
                                    Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconChevronUp}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{l:T 'Nach unten'}" IsEnabled="{Binding CanMoveDown}"
                                    Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconChevronDown}" /></MenuItem.Icon>
                          </MenuItem>
                          <!-- Accounts of the organisation are removed by the organisation, not here -->
                          <Separator IsVisible="{Binding !IsFromCloud}" />
                          <MenuItem Header="{Binding RemoveText}" IsVisible="{Binding !IsFromCloud}"
                                    Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                          </MenuItem>
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <!-- "Entfernen …": asked once more, right in the card -->
                  <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding ConfirmRemove}" Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                          Background="{DynamicResource InfoBackgroundBrush}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Text="{Binding RemoveQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{l:T 'Abbrechen'}" Margin="8,0,0,0"
                              Command="{Binding CancelRemoveCommand}" />
                      <Button Grid.Column="2" Content="{l:T 'Entfernen'}" Margin="6,0,0,0" Foreground="{DynamicResource ErrorBrush}"
                              Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
