<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Neruna.Desktop.ViewModels"
        xmlns:app="using:Neruna.Desktop"
        x:Class="Neruna.Desktop.Views.ReminderWindow"
        x:DataType="vm:ReminderWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app.ico"
        Width="520" Height="380" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource ShellBackgroundBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Delete" Command="{Binding DismissCommand}" />
    <KeyBinding Gesture="Enter" Command="{Binding OpenCommand}" />
  </Window.KeyBindings>
  <DockPanel Margin="12">
    <!-- Snooze: "Erneut erinnern in [5 Minuten]" – like office calendars -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
      <TextBlock Grid.ColumnSpan="3" Classes="subtle" FontSize="12" Text="Erneut erinnern in:" Margin="0,0,0,4" />
      <ComboBox Grid.Row="1" ItemsSource="{Binding SnoozeOptions}" SelectedItem="{Binding SnoozeChoice}" Width="220" IsEnabled="{Binding HasSelection}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SnoozeOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Row="1" Grid.Column="2" Content="Erneut erinnern" Command="{Binding SnoozeCommand}" />
    </Grid>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
      <Button Content="Alle schliessen" Command="{Binding DismissAllCommand}" />
      <Button Grid.Column="2" Content="Element öffnen" Command="{Binding OpenCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="Schliessen" Command="{Binding DismissCommand}" ToolTip.Tip="Erinnerung schliessen (Entf)" />
    </Grid>
    <Border Classes="pane">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ReminderItem">
            <Grid ColumnDefinitions="4,*,Auto" Margin="0,4">
              <Border Background="{Binding Color, Converter={x:Static app:Converters.ColorBrush}}" CornerRadius="2" />
              <StackPanel Grid.Column="1" Margin="10,0">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding When}" Classes="subtle" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Due}" FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource SubtleTextBrush}" Classes.overdue="{Binding IsOverdue}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
  <Window.Styles>
    <Style Selector="TextBlock.overdue">
      <Setter Property="Foreground" Value="#C42B1C" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>
</Window>
