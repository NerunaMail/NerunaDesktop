<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.PstAccountView"
             x:DataType="vm:PstAccountViewModel">

  <StackPanel>
    <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="subtle" TextWrapping="Wrap" Margin="0,4,0,8"
               Text="{l:T 'Alte Archive aus Outlook (.pst, auch .ost) als eigenes Konto: Die Ordner erscheinen in der Ordnerliste, die Datei wird nur gelesen. Nachrichten lassen sich in ein anderes Konto kopieren, nicht aber in der Datei ändern oder löschen.'}" />

    <TextBlock Classes="label" Text="{l:T 'Datei'}" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox Text="{Binding Path}" PlaceholderText="{l:T 'z. B. C:\Users\…\Documents\Outlook-Dateien\archive.pst'}" />
      <Button Grid.Column="1" Content="{l:T 'Auswählen …'}" Command="{Binding ChooseCommand}" Margin="6,0,0,0" />
    </Grid>

    <TextBlock Classes="label" Text="{l:T 'Name'}" />
    <TextBox Text="{Binding Name}" PlaceholderText="{l:T 'z. B. Archiv 2019'}" />

    <TextBlock Classes="error" Text="{Binding Error}" Margin="0,12,0,0" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,20,0,0">
      <ProgressBar IsIndeterminate="True" Width="80" MinWidth="0" Height="4" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="{l:T 'Abbrechen'}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
    </Grid>
  </StackPanel>
</UserControl>
