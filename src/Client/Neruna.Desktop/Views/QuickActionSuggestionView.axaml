<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.QuickActionSuggestionView"
             x:DataType="vm:QuickActionSuggestionViewModel">
  <StackPanel Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <PathIcon Data="{StaticResource IconFlash}" Width="20" Height="20" Foreground="{DynamicResource AccentTextBrush}" />
      <TextBlock Text="{l:T 'Schnellaktion erstellen?'}" FontSize="20" FontWeight="SemiBold" />
    </StackPanel>
    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
    <TextBlock Classes="subtle" FontSize="12" Text="{Binding Steps}" TextWrapping="Wrap" />
    <CheckBox Content="{l:T 'Bei diesem Absender nicht mehr fragen'}" IsChecked="{Binding Never}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{l:T 'Nein'}" Command="{Binding NoCommand}" />
      <Button Classes="accent" Content="{l:T 'Ja, erstellen'}" Command="{Binding YesCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
