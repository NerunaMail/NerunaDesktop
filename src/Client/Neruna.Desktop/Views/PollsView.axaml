<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             x:Class="Neruna.Desktop.Views.PollsView"
             x:DataType="vm:PollsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.head">
      <Setter Property="Width" Value="108" />
      <Setter Property="Padding" Value="4,8" />
      <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,1" />
    </Style>
    <Style Selector="Border.head.best">
      <Setter Property="Background" Value="#2216A34A" />
      <Setter Property="BorderBrush" Value="#16A34A" />
      <Setter Property="BorderThickness" Value="1,3,0,1" />
    </Style>
    <Style Selector="Border.cell">
      <Setter Property="Width" Value="108" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.cell.yes"><Setter Property="Background" Value="#2616A34A" /></Style>
    <Style Selector="Border.cell.ifneeded"><Setter Property="Background" Value="#2665A30D" /></Style>
    <Style Selector="Border.cell.maybe"><Setter Property="Background" Value="#26D97706" /></Style>
    <Style Selector="Border.cell.no"><Setter Property="Background" Value="#26DC2626" /></Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.yes"><Setter Property="Foreground" Value="#16A34A" /></Style>
    <Style Selector="TextBlock.ifneeded"><Setter Property="Foreground" Value="#65A30D" /></Style>
    <Style Selector="TextBlock.maybe"><Setter Property="Foreground" Value="#D97706" /></Style>
    <Style Selector="TextBlock.no"><Setter Property="Foreground" Value="#DC2626" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="{StaticResource IconPoll}" Width="18" Height="18" VerticalAlignment="Center" />
        <TextBlock Text="{l:T 'Terminumfragen'}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !HasEditor}">
        <Button Classes="accent" Command="{Binding NewCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
            <TextBlock Text="{l:T 'Neue Terminumfrage'}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T 'Antworten neu laden'}">
          <PathIcon Data="{StaticResource IconSync}" Width="14" Height="14" />
        </Button>
        <Button Content="{l:T 'Schliessen'}" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,8,0,0">
      <ProgressBar IsIndeterminate="True" Height="4" MinWidth="0" IsVisible="{Binding IsBusy}" />
      <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
      <TextBlock Classes="subtle" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                 Text="{l:T 'Noch keine Terminumfrage. Mit «Neue Terminumfrage» schlagen Sie Termine vor; die Eingeladenen wählen auf einer Webseite, welche passen.'}" />
    </StackPanel>

    <!-- The editor in place of the list -->
    <ContentControl Grid.Row="2" Content="{Binding Editor}" IsVisible="{Binding HasEditor}" Margin="0,8,0,0" />

    <Grid Grid.Row="2" ColumnDefinitions="240,16,*" Margin="0,12,0,0" IsVisible="{Binding !HasEditor}" MinHeight="360">
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" VerticalAlignment="Top" MaxHeight="560">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PollListItem">
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="subtle" FontSize="12" Text="{Binding Info}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Column="2" IsVisible="{Binding HasSelection}">
        <TextBlock Text="{Binding Selected.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding Details}" />

        <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0" IsVisible="{Binding HasLink}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconLink}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding LinkText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
            <Button Grid.Column="2" Content="{l:T 'Link kopieren'}" Command="{Binding CopyLinkCommand}" Margin="8,0,0,0" />
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Command="{Binding WriteMailCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconMail}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Mail an die Eingeladenen'}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding EditCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Bearbeiten'}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding DeleteCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" />
              <TextBlock Text="{l:T 'Löschen'}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- The table: a column per proposed date (its head with the totals and "Festlegen"), a row per person -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="200" />
              <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PollOptionResult">
                    <Border Classes="head" Classes.best="{Binding IsBest}" ToolTip.Tip="{Binding When}">
                      <DockPanel>
                      <Button DockPanel.Dock="Bottom" Content="{l:T 'Festlegen'}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12" Padding="8,3"
                              Command="{Binding $parent[UserControl].((vm:PollsViewModel)DataContext).FixCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{l:T 'Termin mit allen Eingeladenen erstellen; die Umfrage wird danach gelöscht'}" />
                      <StackPanel HorizontalAlignment="Center" Spacing="1">
                        <TextBlock Classes="subtle" FontSize="11" Text="{Binding Month}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Day}" HorizontalAlignment="Center" />
                        <TextBlock Classes="subtle" FontSize="12" Text="{Binding Weekday}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Time}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Classes="yes" FontSize="15" FontWeight="Bold" Text="{Binding Total}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   ToolTip.Tip="{Binding Counts}" />
                        <TextBlock Classes="subtle" FontSize="11" Text="{Binding More}" HorizontalAlignment="Center" IsVisible="{Binding HasMore}" />
                        <Border Background="#16A34A" CornerRadius="8" Padding="6,0" Margin="0,4,0,0" IsVisible="{Binding IsBest}" HorizontalAlignment="Center">
                          <TextBlock Text="{l:T 'passt am besten'}" Foreground="White" FontSize="10" />
                        </Border>
                      </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Classes="subtle" FontSize="12" Margin="0,10,0,0" IsVisible="{Binding !HasParticipants}"
                       Text="{l:T 'Noch keine Antworten.'}" />
            <ItemsControl ItemsSource="{Binding Participants}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PollParticipantResult">
                  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="200" ColumnDefinitions="*,Auto" Margin="0,3">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                          <PathIcon Data="{StaticResource IconChat}" Width="12" Height="12" Foreground="{DynamicResource AccentTextBrush}"
                                    IsVisible="{Binding HasComment}" ToolTip.Tip="{Binding Participant.Comment}" Background="Transparent" />
                        </StackPanel>
                        <TextBlock Classes="subtle" FontSize="11" Text="{Binding State}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="command" IsVisible="{Binding HasPersonalLink}" VerticalAlignment="Center"
                              ToolTip.Tip="{l:T 'Persönlichen Link kopieren'}"
                              Command="{Binding $parent[UserControl].((vm:PollsViewModel)DataContext).CopyPersonalLinkCommand}" CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" />
                      </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Cells}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PollAnswerCell">
                          <Border Classes="cell" Classes.yes="{Binding IsYes}" Classes.ifneeded="{Binding IsIfNeeded}"
                                  Classes.maybe="{Binding IsMaybe}" Classes.no="{Binding IsNo}" ToolTip.Tip="{Binding Tip}">
                            <TextBlock Classes="cell" Classes.yes="{Binding IsYes}" Classes.ifneeded="{Binding IsIfNeeded}"
                                       Classes.maybe="{Binding IsMaybe}" Classes.no="{Binding IsNo}" Text="{Binding Symbol}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="{Binding Legend}" IsVisible="{Binding HasParticipants}" />

        <!-- What people wrote in "Bemerkung" on the page: only here, the others on the page don't see it -->
        <TextBlock Classes="label" Text="{l:T 'Bemerkungen'}" IsVisible="{Binding HasComments}" />
        <ItemsControl ItemsSource="{Binding Comments}" IsVisible="{Binding HasComments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PollParticipantResult">
              <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding Name}" />
                  <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Participant.Comment}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
