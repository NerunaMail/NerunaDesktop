<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:l="using:Neruna.Desktop"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Neruna.Desktop.ViewModels"
             xmlns:views="using:Neruna.Desktop.Views"
             x:Class="Neruna.Desktop.Views.ServerRulesPageView"
             x:DataType="vm:ServerRulesPageViewModel">
  <!-- Einstellungen → Serverregeln: accounts with their number of rules on the left, the chosen account's rules on the right -->
  <Grid ColumnDefinitions="240,20,*" RowDefinitions="Auto,*">
    <TextBlock Grid.ColumnSpan="3" Text="{l:T 'Serverregeln'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Classes="subtle" Text="{l:T 'Kein E-Mail-Konto'}" IsVisible="{Binding !HasAccounts}" />
      <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" IsEnabled="{Binding CanSwitch}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RulesAccountItem">
            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Problem}">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}" FontSize="12" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !CanSwitch}"
                 Text="{l:T 'Erst speichern oder verwerfen, dann ein anderes Konto wählen.'}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <views:ServerRulesView DataContext="{Binding Current}" IsVisible="{Binding $parent[UserControl].((vm:ServerRulesPageViewModel)DataContext).Current, Converter={x:Static ObjectConverters.IsNotNull}}"
                             MaxWidth="760" HorizontalAlignment="Left" />
    </ScrollViewer>
  </Grid>
</UserControl>
