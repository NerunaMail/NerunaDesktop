<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Domain model, provider abstractions and controllers of Neruna Desktop. No UI, no protocol code.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MimeKit" />
    <!-- MimeKit names Pkcs 10.0.0 (CVE-2026-84008, fixed in 10.0.13); for a runtime-specific publish it is not taken from the framework -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- PDFium (native) for the PDF attachment preview: Mail/PdfPages.cs -->
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <PackageReference Include="bblanchon.PDFium.Linux" />
    <PackageReference Include="bblanchon.PDFium.macOS" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Neruna.Contracts\Neruna.Contracts.csproj" />
    <ProjectReference Include="..\..\Shared\Neruna.Vault\Neruna.Vault.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Neruna.Client.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Translations of the UI texts (German is in the code): Neruna.Core.Localization.Texts -->
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>
</Project>
